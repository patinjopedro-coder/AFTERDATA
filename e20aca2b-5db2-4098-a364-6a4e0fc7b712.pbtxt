\n           H 215 \n           Z\" \n        fill=\"url(#solidDGradient)\" \n        stroke=\"#475569\" \n        strokeWidth=\"6\" \n      />\n\n      {/* 3. The Central POS Payment Terminal */}\n      {/* Main Terminal body rotated -18 degrees for perfect dynamic alignment */}\n      <g transform=\"rotate(-18 285 240)\">\n        {/* Shadow */}\n        <rect x=\"233\" y=\"163\" width=\"104\" height=\"154\" rx=\"16\" fill=\"#020617\" opacity=\"0.3\" />\n        \n        {/* Terminal Case */}\n        <rect x=\"235\" y=\"165\" width=\"100\" height=\"150\" rx=\"14\" fill=\"#1e293b\" stroke=\"#334155\" strokeWidth=\"5\" />\n        \n        {/* Display Screen */}\n        <rect x=\"245\" y=\"175\" width=\"80\" height=\"52\" rx=\"6\" fill=\"#0f172a\" stroke=\"#1e293b\" strokeWidth=\"2.5\" />\n        \n        {/* Screen Status Glow */}\n        <rect x=\"250\" y=\"180\" width=\"70\" height=\"32\" rx=\"3\" fill=\"#0f172a\" stroke=\"#3b82f6\" strokeWidth=\"1\" opacity=\"0.8\" />\n        \n        {/* Fake Transaction Graphic lines */}\n        <line x1=\"256\" y1=\"190\" x2=\"286\" y2=\"190\" stroke=\"#3b82f6\" strokeWidth=\"2\" strokeLinecap=\"round\" />\n        <line x1=\"256\" y1=\"196\" x2=\"306\" y2=\"196\" stroke=\"#3b82f6\" strokeWidth=\"2\" strokeLinecap=\"round\" />\n        <line x1=\"256\" y1=\"202\" x2=\"276\" y2=\"202\" stroke=\"#10b981\" strokeWidth=\"2\" strokeLinecap=\"round\" />\n\n        {/* Paper Feed Slot */}\n        <rect x=\"248\" y=\"148\" width=\"74\" height=\"6\" rx=\"2\" fill=\"#334155\" />\n        \n        {/* Barcode Printed Receipt Paper trailing out */}\n        <path d=\"M 252 148 L 255 125 H 315 L 318 148 Z\" fill=\"#f8fafc\" stroke=\"#cbd5e1\" strokeWidth=\"1\" />\n        {/* Barcode lines on the receipt */}\n        <line x1=\"262\" y1=\"130\" x2=\"262\" y2=\"142\" stroke=\"#0f172a\" strokeWidth=\"2\" />\n        <line x1=\"267\" y1=\"130\" x2=\"267\" y2=\"142\" stroke=\"#0f172a\" strokeWidth=\"1\" />\n        <line x1=\"271\