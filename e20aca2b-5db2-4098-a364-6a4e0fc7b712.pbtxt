    replacement_chunks {
      target_content: "  // Aesthetic light pastel style badges with pure WHITE text inside\n  const getStatusBadgeStyle = (st: POSStatus) => {\n    if ([\'CANCELADO\', \'N#A\'].includes(st)) {\n      return \'bg-emerald-500/20 text-white border border-emerald-400/30 font-bold px-2 py-0.5 rounded shadow-sm\';\n    }\n    if ([\'PENDIENTE\', \'ACTIVO\', \'SUSPENDIDO\', \'RECUPERADO\'].includes(st)) {\n      return \'bg-orange-400/20 text-white border border-orange-300/30 font-bold px-2 py-0.5 rounded shadow-sm\';\n    }\n    return \'bg-slate-800 text-white border border-slate-700 font-semibold px-2 py-0.5 rounded shadow-sm\';\n  };\n\n  return (\n    <div className=\"flex flex-col gap-5 animate-fade-in text-slate-100 pb-16\">\n      \n      {/* SECCI\303\223N VALIDADOR / HOJA DE CONTROL: ENVIADO HACIA LOGICA IMS */}\n      <div className=\"bg-slate-900/40 p-5 rounded-xl border border-slate-800 flex flex-col md:flex-row justify-between items-center gap-4\">\n        <div>\n          <h3 className=\"text-base font-bold text-orange-200 flex items-center gap-2\">\n            <Database className=\"text-orange-400 w-5 h-5 animate-pulse\" />\n            SISTEMA DE ASOCIACI\303\223N ALIMENTADOR BASE \"IMS\"\n          </h3>\n          <p className=\"text-xs text-slate-400 mt-1 uppercase font-mono tracking-wider\">\n            Alimente la lista IMS de forma masiva (+100.000 l\303\255neas). Los seriales ausentes ser\303\241n identificados con estado N#A y clasificados como DISPONIBLE.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <span className={`text-[10px] font-black px-3 py-1.5 rounded-full ${imsCargado ? \'bg-emerald-950/70 text-emerald-300 border border-emerald-500/25\' : \'bg-red-950/70 text-red-300 border border-red-500/25\'}`}>\n            {imsCargado ? `IMS: ${datosMaestro.length} REGISTROS` : \'SIN BASE IMS\'}\n          </span>\n          <button \n            onClick={() => {\n              setImsSerialsRaw(datosMaestro.map(d => d.serial).join(\'\\n\'));\n              setImsStatusRaw(datosMaestro.map(d => d.status).join(\'\\n\'));\n              setIsIMSModalOpen(true);\n            }}\n            className=\"px-5 py-2.5 bg-orange-500/20 hover:bg-orange-500/35 text-white border border-orange-400/30 rounded-lg text-xs font-bold uppercase transition-all shadow-md flex items-center gap-2 cursor-pointer select-none\"\n          >\n            <Database size={13} className=\"text-orange-300\" />\n            <span>IMS</span>\n          </button>\n        </div>\n      </div>"
