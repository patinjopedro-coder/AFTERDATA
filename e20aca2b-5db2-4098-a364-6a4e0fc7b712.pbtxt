  file_change {
    absolute_path_uri: "file:///src/components/CruceSeriales.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { POSItem, POSStatus, ModelConfig, CruceItem } from \'../types\';\nimport { \n  FileCheck, ArrowRightLeft, Check, HelpCircle, Import, Send, Trash2, Shield\n} from \'lucide-react\';\n\ninterface CruceSerialesProps {\n  serials: POSItem[];\n  setSerials: React.Dispatch<React.SetStateAction<POSItem[]>>;\n  modelosDB: Record<string, ModelConfig>;\n}\n\nexport const CruceSeriales: React.FC<CruceSerialesProps> = ({\n  serials,\n  setSerials,\n  modelosDB\n}) => {\n  // Real-time texts synced via localStorage\n  const [emailText, setEmailText] = useState(() => localStorage.getItem(\'cruce_emailText\') || \'\');\n  const [fisicoText, setFisicoText] = useState(() => localStorage.getItem(\'cruce_fisicoText\') || \'\');\n  \n  const [datosMaestro, setDatosMaestro] = useState<CruceItem[]>(() => {\n    return JSON.parse(localStorage.getItem(\'datosMaestro\') || \'[]\');\n  });\n\n  const [remitenteCorreo, setRemitenteCorreo] = useState(\'VALIDADOR\');\n  const [statusForzado, setStatusForzado] = useState<POSStatus | \'HEREDAR\'>(\'HEREDAR\');\n\n  const maestroCargado = datosMaestro.length > 0;\n\n  // Persist text inside localStorage\n  useEffect(() => {\n    localStorage.setItem(\'cruce_emailText\', emailText);\n  }, [emailText]);\n\n  useEffect(() => {\n    localStorage.setItem(\'cruce_fisicoText\', fisicoText);\n  }, [fisicoText]);\n\n  useEffect(() => {\n    localStorage.setItem(\'datosMaestro\', JSON.stringify(datosMaestro));\n  }, [datosMaestro]);\n\n  const parseCSVLine = (line: string, delimiter: string) => {\n    const result: string[] = [];\n    let insideQuotes = false;\n    let current = \'\';\n    for (let i = 0; i < line.length; i++) {\n      const c = line[i];\n      if (c === \'\"\') {\n        insideQuotes = !insideQuotes;\n      } else if (c === delimiter && !insideQuotes) {\n        result.push(current.trim());\n        current = \'\';\n      } else {\n        current += c;\n      }\n    }\n    result.push(current.trim());\n    return result;\n  };\n\n  const cleanHeader = (h: string) => {\n    return h.trim().toLowerCase()\n      .normalize(\"NFD\")\n      .replace(/[\\u0300-\\u036f]/g, \"\")\n      .replace(/[^a-z0-9\\s]/g, \"\");\n  };\n\n  const handleImportValidatorFile = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n\n    const reader = new FileReader();\n    reader.onload = (event) => {\n      try {\n        const text = event.target?.result as string;\n        const lines = text.split(/\\r?\\n/).map(l => l.trim()).filter(Boolean);\n        if (lines.length < 2) {\n          alert(\'Archivo vac\303\255o o insuficiente.\');\n          return;\n        }\n\n        const firstLine = lines[0];\n        const delimiter = (firstLine.includes(\';\') && !firstLine.includes(\',\')) ? \';\' : \',\';\n\n        const headers = parseCSVLine(firstLine, delimiter).map(cleanHeader);\n\n        // Locating headers flexibly\n        let idxSerial = headers.findIndex(h => h.includes(\'serial\') && (h.includes(\'terminal\') || h.includes(\'serial\') || h.includes(\'equipo\')));\n        let idxNoTerminal = headers.findIndex(h => h.includes(\'no\') || h.includes(\'terminal\') || h.includes(\'numero\') || h.includes(\'ticket\'));\n        let idxOperador = headers.findIndex(h => h.includes(\'operador\') || h.includes(\'operadora\') || h.includes(\'company\'));\n        let idxSim = headers.findIndex(h => h.includes(\'sim\') && (h.includes(\'serial\') || h.includes(\'numero\')));\n        let idxStatusServicio = headers.findIndex(h => h.includes(\'status servicio\') || h.includes(\'estado servicio\') || h.includes(\'status\') || h.includes(\'estado\'));\n\n        if (idxSerial === -1) idxSerial = 0;\n        if (idxStatusServicio === -1) idxStatusServicio = Math.min(headers.length - 1, 9);\n        if (idxNoTerminal === -1) idxNoTerminal = 1;\n        if (idxOperador === -1) idxOperador = 2;\n        if (idxSim === -1) idxSim = 3;\n\n        const mappedMaster: CruceItem[] = [];\n\n        for (let i = 1; i < lines.length; i++) {\n          const cols = parseCSVLine(lines[i], delimiter);\n          if (cols.length <= idxSerial) continue;\n\n          const serialVal = cols[idxSerial]?.toUpperCase().trim();\n          if (!serialVal) continue;\n\n          const rawStatus = cols[idxStatusServicio]?.toUpperCase().trim() || \'\';\n          let finalStatus: POSStatus = \'SIN ESTATUS\';\n          if (rawStatus.includes(\'PENDIENTE\')) finalStatus = \'PENDIENTE\';\n          else if (rawStatus.includes(\'ACTIVO\')) finalStatus = \'ACTIVO\';\n          else if (rawStatus.includes(\'SUSPENDIDO\')) finalStatus = \'SUSPENDIDO\';\n          else if (rawStatus.includes(\'CANCELADO\')) finalStatus = \'CANCELADO\';\n          else if (rawStatus.includes(\'N/A\') || rawStatus === \'NA\' || rawStatus.includes(\'N#A\')) finalStatus = \'N#A\';\n\n          mappedMaster.push({\n            serial: serialVal,\n            status: finalStatus,\n            operadora: cols[idxOperador]?.toUpperCase().trim() || \'\',\n            simNumber: cols[idxSim]?.toUpperCase().trim() || \'\',\n            ticket: cols[idxNoTerminal]?.toUpperCase().trim() || \'\'\n          });\n        }\n\n        setDatosMaestro(mappedMaster);\n        alert(`\342\234\205 Validador cargado: ${mappedMaster.length} registros cargados exitosamente.`);\n\n      } catch (err: any) {\n        alert(`Error al procesar archivo: ${err.message}`);\n      }\n    };\n    reader.readAsText(file, \'UTF-8\');\n  };\n\n  const lookupValidador = (serial: string): CruceItem | null => {\n    if (datosMaestro.length === 0) return null;\n    const cleanSerial = serial.trim().toUpperCase();\n    let found = datosMaestro.find(m => m.serial === cleanSerial);\n    if (!found) {\n      found = datosMaestro.find(m => m.serial.includes(cleanSerial) || cleanSerial.includes(m.serial));\n    }\n    return found || null;\n  };\n\n  // Parsing helper for real-time lists\n  const parseLines = (text: string) => {\n    return text\n      .split(/[\\r\\n,;]+/)\n      .map(s => s.trim().toUpperCase())\n      .filter(Boolean);\n  };\n\n  const emailLines = parseLines(emailText);\n  const fisicoLines = parseLines(fisicoText);\n\n  // Uniques arrays to inspect for checks\n  const emailUniques = Array.from(new Set(emailLines));\n  const fisicoUniques = Array.from(new Set(fisicoLines));\n\n  const emailSet = new Set(emailUniques);\n  const fisicoSet = new Set(fisicoUniques);\n\n  // Calculated Intersections\n  const coincidencias = emailUniques.filter(s => fisicoSet.has(s));\n  const soloCorreo = emailUniques.filter(s => !fisicoSet.has(s));\n  const soloFisico = fisicoUniques.filter(s => !emailSet.has(s));\n\n  const totalUnicos = new Set([...emailUniques, ...fisicoUniques]).size;\n  const matchRatio = emailUniques.length ? ((coincidencias.length / emailUniques.length) * 100).toFixed(1) : \'0.0\';\n\n  const limpiarTodo = () => {\n    if (window.confirm(\'\302\277Est\303\241 seguro de que desea limpiar ambos campos de texto?\')) {\n      setEmailText(\'\');\n      setFisicoText(\'\');\n    }\n  };\n\n  const handleAddMatchesToGeneral = () => {\n    if (coincidencias.length === 0) {\n      alert(\'No hay coincidencias detectadas para agregar en este momento.\');\n      return;\n    }\n\n    const today = new Date().toISOString().split(\'T\')[0];\n    const displayToday = today.split(\'-\').reverse().join(\'/\');\n    const cleanRemitente = remitenteCorreo.trim().toUpperCase() || \'VALIDADOR\';\n\n    let nuevos = 0;\n    let actualizados = 0;\n\n    setSerials(prev => {\n      const copy = [...prev];\n\n      coincidencias.forEach(serial => {\n        const match = lookupValidador(serial);\n        \n        let finalStatus: POSStatus = \'SIN ESTATUS\';\n        if (statusForzado !== \'HEREDAR\') {\n          finalStatus = statusForzado;\n        } else if (match) {\n          finalStatus = match.status;\n        }\n\n        const idx = copy.findIndex(item => item.serial === serial);\n        if (idx !== -1) {\n          copy[idx].status = finalStatus;\n          if (match?.operadora) copy[idx].operadora = match.operadora as any;\n          if (match?.simNumber) {\n            copy[idx].sim = true;\n            copy[idx].simNumber = match.simNumber;\n          }\n          if (match?.ticket && !copy[idx].ticket) {\n            copy[idx].ticket = match.ticket;\n          }\n          actualizados++;\n        } else {\n          copy.unshift({\n            id: Date.now() + Math.random(),\n            serial,\n            date: today,\n            displayDate: displayToday,\n            status: finalStatus,\n            remitente: cleanRemitente,\n            source: \'CRUCE DE CORREO Y FISICO\',\n            isCasillero: false,\n            selected: false,\n            rif: \'\',\n            razonSocial: \'\',\n            destino: \'\',\n            observaciones: \'A\303\261adido autom\303\241ticamente mediante herramienta de cruce\',\n            forro: false,\n            bateria: false,\n            cargador: false,\n            caja: false,\n            sim: !!match?.simNumber,\n            simNumber: match?.simNumber || \'\',\n            operadora: (match?.operadora as any) || \'\',\n            modeloManual: \'\',\n            modeloNegocio: \'\',\n            entregadoTecnico: false,\n            esSustitucion: false,\n            serialSustituto: \'\',\n            fechaSalida: \'\',\n            fechaSalidaCliente: \'\',\n            guiaSalidaCliente: \'\',\n            destinoSalida: \'\',\n            fechaConfirmada: false,\n            ticket: match?.ticket || \'\',\n            addedFromCruce: true\n          });\n          nuevos++;\n        }\n      });\n\n      return copy;\n    });\n\n    alert(`\342\234\205 \302\241Cruce inteligente completado!\\n\342\200\242 ${nuevos} nuevos registros agregados.\\n\342\200\242 ${actualizados} terminales existentes actualizados.`);\n  };\n\n  const handleExportCruceReport = () => {\n    let csv = \"SERIAL,CORREO_CONTIENE,FISICO_CONTIENE,MATCH,ESTADO_VAL_HOJA2,OPERADORA,SIM_CARD,TICKET_CASO\\n\";\n    \n    // Combine all uniques together\n    const allSetKeys = Array.from(new Set([...emailUniques, ...fisicoUniques]));\n\n    for (const s of allSetKeys) {\n      const inEmail = emailSet.has(s) ? \"SI\" : \"NO\";\n      const inFisico = fisicoSet.has(s) ? \"SI\" : \"NO\";\n      const isMatch = (inEmail === \"SI\" && inFisico === \"SI\") ? \"COINCIDENCIA\" : \"DIFERENCIA\";\n      const matchMaster = lookupValidador(s);\n\n      csv += `\"${s}\",\"${inEmail}\",\"${inFisico}\",\"${isMatch}\",\"${matchMaster?.status || \'SIN REGISTRO\'}\",\"${matchMaster?.operadora || \'\'}\",\"${matchMaster?.simNumber || \'\'}\",\"${matchMaster?.ticket || \'\'}\"\\n`;\n    }\n\n    const blob = new Blob([\"\\uFEFF\" + csv], { type: \"text/csv;charset=utf-8;\" });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\'a\');\n    link.href = url;\n    link.download = `cruce_realtime_reporte_${new Date().toISOString().split(\'T\')[0]}.csv`;\n    link.click();\n    URL.revokeObjectURL(url);\n  };\n\n  const getStatusBadgeStyle = (st: POSStatus) => {\n    if ([\'CANCELADO\', \'N#A\'].includes(st)) {\n      return \'bg-emerald-600/20 text-emerald-400 border border-emerald-500/30\';\n    }\n    if ([\'PENDIENTE\', \'ACTIVO\', \'SUSPENDIDO\'].includes(st)) {\n      return \'bg-orange-500/20 text-orange-400 border border-orange-500/30\';\n    }\n    return \'bg-slate-800 text-slate-400 border border-slate-700\';\n  };\n\n  return (\n    <div className=\"flex flex-col gap-5 animate-fade-in text-slate-100 pb-16\">\n      \n      {/* SECCI\303\223N VALIDADOR / HOJA DE CONTROL */}\n      <div className=\"bg-slate-900/40 p-5 rounded-xl border border-slate-800 flex flex-col md:flex-row justify-between items-center gap-4\">\n        <div>\n          <h3 className=\"text-base font-bold text-blue-400 flex items-center gap-2\">\n            <FileCheck className=\"text-blue-500 w-5 h-5 animate-pulse\" />\n            CONFRONTACI\303\223N CONTRA VALIDADOR / HOJA DE CONTROL DE ESTADOS (HOJA 2)\n          </h3>\n          <p className=\"text-xs text-slate-400 mt-1 uppercase font-mono\">\n            Carga un listado exportado de control en formato CSV o TXT para habilitar cruce inteligente\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <span className={`text-[10px] font-black px-3 py-1.5 rounded-full ${maestroCargado ? \'bg-emerald-950 text-emerald-400 border border-emerald-500/20\' : \'bg-red-950 text-red-400 border border-red-500/20\'}`}>\n            {maestroCargado ? `VALIDADOR: ${datosMaestro.length} SERIALES` : \'SIN VALIDADOR\'}\n          </span>\n          <label className=\"px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-xs font-bold uppercase cursor-pointer select-none transition-all shadow-sm\">\n            <input \n              type=\"file\" \n              accept=\".csv,.txt\" \n              onChange={handleImportValidatorFile} \n              className=\"hidden\" \n            />\n            CARGAR EXCEL / CSV\n          </label>\n        </div>\n      </div>\n\n      {/* INPUTS DE SERIALES EN REAL-TIME (CORREO VS FISICO) */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        \n        {/* COLUMNA CORREO */}\n        <div className=\"bg-slate-900/30 p-5 rounded-xl border border-slate-800 flex flex-col gap-3\">\n          <div className=\"flex justify-between items-center border-b border-slate-850 pb-2\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"w-2.5 h-2.5 rounded-full bg-blue-500 animate-pulse\"></span>\n              <h4 className=\"font-extrabold text-xs text-blue-400 uppercase tracking-wider\">Pega de Seriales desde Correo (Digital)</h4>\n            </div>\n            <span className=\"text-[10px] font-bold bg-slate-950 border border-slate-850 px-2.5 py-0.5 rounded-md text-slate-400 uppercase font-mono\">\n              Unicos: {emailUniques.length}\n            </span>\n          </div>\n\n          <textarea\n            value={emailText}\n            onChange={e => setEmailText(e.target.value)}\n            placeholder=\"Pega aqu\303\255 los seriales que te llegaron al correo electr\303\263nico (uno por l\303\255nea o separados por comas)...\"\n            rows={5}\n            className=\"w-full text-xs font-semibold p-3 bg-slate-950 border border-slate-800 rounded-lg text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 placeholder-slate-600 transition-all font-sans\"\n          />\n\n          {/* REAL TIME CRUCE VISUALIZATION BOX */}\n          <div className=\"bg-slate-950/60 rounded-xl p-3.5 border border-slate-850 flex flex-col gap-1\">\n            <span className=\"text-[9px] text-slate-500 uppercase font-bold tracking-widest block mb-2\">L\303\255neas de Correo Procesadas y Cruzadas</span>\n            \n            <div className=\"min-h-[140px] max-h-[280px] overflow-y-auto space-y-1.5 pr-1\">\n              {emailUniques.length === 0 ? (\n                <div className=\"text-center text-xs text-slate-600 my-auto py-8\">Pega los seriales de tu correo arriba. El cruce es autom\303\241tico.</div>\n              ) : (\n                emailUniques.map((serial, idx) => {\n                  const hasMatch = fisicoSet.has(serial);\n                  const dbMatch = lookupValidador(serial);\n\n                  return (\n                    <div \n                      key={idx}\n                      className={`flex items-center justify-between p-2 rounded-lg border text-xs font-semibold transition-all ${\n                        hasMatch \n                          ? \'bg-blue-600/10 text-blue-300 border-blue-500/30\' \n                          : \'bg-slate-900/30 text-slate-600 border-slate-900/60 opacity-40\'\n                      }`}\n                    >\n                      <div className=\"flex items-center gap-2.5 font-mono\">\n                        <span className=\"text-[9px] text-slate-600 font-bold\">{(idx + 1).toString().padStart(2, \'0\')}</span>\n                        <span className=\"tracking-wide\">{serial}</span>\n                      </div>\n\n                      <div className=\"flex items-center gap-2 font-mono text-[9px]\">\n                        {dbMatch && (\n                          <span className={`px-1.5 py-0.5 rounded text-[8.5px] font-bold uppercase ${getStatusBadgeStyle(dbMatch.status)}`}>\n                            {dbMatch.status}\n                          </span>\n                        )}\n                        <span className={`px-1.5 py-0.5 rounded-md text-[8.5px] font-black uppercase tracking-wider ${\n                          hasMatch ? \'bg-blue-600 text-white\' : \'bg-slate-950 text-slate-600\'\n                        }`}>\n                          {hasMatch ? \'\342\234\223 MATCH\' : \'DIF\'}\n                        </span>\n                      </div>\n                    </div>\n                  );\n                })\n              )}\n            </div>\n          </div>\n        </div>\n\n        {/* COLUMNA FISICOS */}\n        <div className=\"bg-slate-900/30 p-5 rounded-xl border border-slate-800 flex flex-col gap-3\">\n          <div className=\"flex justify-between items-center border-b border-slate-850 pb-2\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"w-2.5 h-2.5 rounded-full bg-orange-500 animate-pulse\"></span>\n              <h4 className=\"font-extrabold text-xs text-orange-400 uppercase tracking-wider\">Lecturas de Seriales F\303\255sicos (Pistola)</h4>\n            </div>\n            <span className=\"text-[10px] font-bold bg-slate-950 border border-slate-850 px-2.5 py-0.5 rounded-md text-slate-400 uppercase font-mono\">\n              Unicos: {fisicoUniques.length}\n            </span>\n          </div>\n\n          <textarea\n            value={fisicoText}\n            onChange={e => setFisicoText(e.target.value)}\n            placeholder=\"Pistolee directamente con la lectora o pegue los seriales f\303\255sicos le\303\255dos a mano...\"\n            rows={5}\n            className=\"w-full text-xs font-semibold p-3 bg-slate-950 border border-slate-800 rounded-lg text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 placeholder-slate-600 transition-all font-sans\"\n          />\n\n          {/* REAL TIME CRUCE VISUALIZATION BOX */}\n          <div className=\"bg-slate-950/60 rounded-xl p-3.5 border border-slate-850 flex flex-col gap-1\">\n            <span className=\"text-[9px] text-slate-500 uppercase font-bold tracking-widest block mb-2\">L\303\255neas de Pistola Procesadas y Cruzadas</span>\n            \n            <div className=\"min-h-[140px] max-h-[280px] overflow-y-auto space-y-1.5 pr-1\">\n              {fisicoUniques.length === 0 ? (\n                <div className=\"text-center text-xs text-slate-600 my-auto py-8\">Pistolee o pegue terminales f\303\255sicos arriba.</div>\n              ) : (\n                fisicoUniques.map((serial, idx) => {\n                  const hasMatch = emailSet.has(serial);\n                  const dbMatch = lookupValidador(serial);\n\n                  return (\n                    <div \n                      key={idx}\n                      className={`flex items-center justify-between p-2 rounded-lg border text-xs font-semibold transition-all ${\n                        hasMatch \n                          ? \'bg-orange-500/10 text-orange-400 border-orange-500/30\' \n                          : \'bg-slate-900/30 text-slate-600 border-slate-900/60 opacity-40\'\n                      }`}\n                    >\n                      <div className=\"flex items-center gap-2.5 font-mono\">\n                        <span className=\"text-[9px] text-slate-600 font-bold\">{(idx + 1).toString().padStart(2, \'0\')}</span>\n                        <span className=\"tracking-wide\">{serial}</span>\n                      </div>\n\n                      <div className=\"flex items-center gap-2 font-mono text-[9px]\">\n                        {dbMatch && (\n                          <span className={`px-1.5 py-0.5 rounded text-[8.5px] font-bold uppercase ${getStatusBadgeStyle(dbMatch.status)}`}>\n                            {dbMatch.status}\n                          </span>\n                        )}\n                        <span className={`px-1.5 py-0.5 rounded-md text-[8.5px] font-black uppercase tracking-wider ${\n                          hasMatch ? \'bg-orange-500 text-white\' : \'bg-slate-950 text-slate-600\'\n                        }`}>\n                          {hasMatch ? \'\342\234\223 MATCH\' : \'DIF\'}\n                        </span>\n                      </div>\n                    </div>\n                  );\n                })\n              )}\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      {/* PARAMETROS DE RECONCILIACI\303\223N DE DATOS */}\n      <div className=\"bg-slate-900/60 p-5 rounded-xl border border-slate-800 grid grid-cols-1 md:grid-cols-2 gap-5 shadow-sm\">\n        <div>\n          <label className=\"text-xs font-extrabold text-blue-400 block mb-1.5 uppercase\">Asignar Remitente a Registros Nuevos</label>\n          <input\n            type=\"text\"\n            value={remitenteCorreo}\n            onChange={e => setRemitenteCorreo(e.target.value.toUpperCase())}\n            placeholder=\"Introduce remitente asignado (ej. VALIDADOR, DISGLOBAL)...\"\n            className=\"w-full text-xs font-semibold p-2.5 bg-slate-950 border border-slate-800 rounded-lg text-white focus:outline-none focus:border-blue-500\"\n          />\n        </div>\n\n        <div>\n          <label className=\"text-xs font-extrabold text-slate-400 block mb-1.5 uppercase\">Forzar Estado al Reconciliar</label>\n          <div className=\"grid grid-cols-3 gap-2\">\n            {([\'HEREDAR\', \'PENDIENTE\', \'ACTIVO\'] as const).map(opt => (\n              <button\n                key={opt}\n                onClick={() => setStatusForzado(opt as any)}\n                className={`py-2 px-1 text-[10px] font-black border uppercase tracking-wider rounded-lg transition-all flex items-center justify-center gap-1 cursor-pointer ${\n                  statusForzado === opt \n                    ? \'bg-blue-600 text-white border-blue-500 shadow-md\' \n                    : \'bg-slate-950 hover:bg-slate-900 text-slate-300 border-slate-850 hover:border-slate-800\'\n                }`}\n              >\n                {opt === \'HEREDAR\' ? \'Utilizar Validador\' : opt}\n              </button>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* METRICAS DE INTERSECCI\303\223N Y BOTONES ACCI\303\223N */}\n      <div className=\"bg-slate-900/50 p-6 rounded-xl border border-slate-800 shadow-lg\">\n        <h4 className=\"font-extrabold text-xs tracking-wider text-slate-300 uppercase mb-4 flex items-center gap-2\">\n          <ArrowRightLeft className=\"text-blue-500 w-4.5 h-4.5\" />\n          M\303\211TRICAS DEL CRUCE Y SALIDA DE CONTROL\n        </h4>\n\n        {emailUniques.length === 0 && fisicoUniques.length === 0 ? (\n          <div className=\"text-center text-xs text-slate-500 py-6 font-mono uppercase\">\n            Esperando ingresos en los campos de correo o pistola f\303\255sica...\n          </div>\n        ) : (\n          <div className=\"space-y-4\">\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 text-center\">\n              <div className=\"bg-blue-950/30 p-4 border border-blue-500/20 rounded-xl space-y-1\">\n                <div className=\"text-3xl font-black text-blue-400 select-all font-sans\">{coincidencias.length}</div>\n                <div className=\"text-[9px] text-slate-400 font-extrabold uppercase tracking-widest\">Coinciden (Match)</div>\n              </div>\n              <div className=\"bg-red-950/20 p-4 border border-red-500/10 rounded-xl space-y-1 opacity-75\">\n                <div className=\"text-3xl font-black text-red-400 select-all font-sans\">{soloCorreo.length}</div>\n                <div className=\"text-[9px] text-slate-400 font-extrabold uppercase tracking-widest\">Solo en Correo</div>\n              </div>\n              <div className=\"bg-orange-950/10 p-4 border border-orange-500/10 rounded-xl space-y-1 opacity-75\">\n                <div className=\"text-3xl font-black text-orange-400 select-all font-sans\">{soloFisico.length}</div>\n                <div className=\"text-[9px] text-slate-400 font-extrabold uppercase tracking-widest\">Solo en Lectora</div>\n              </div>\n              <div className=\"bg-slate-950 p-4 border border-slate-850 rounded-xl space-y-1\">\n                <div className=\"text-3xl font-black text-white select-all font-sans\">{totalUnicos}</div>\n                <div className=\"text-[9px] text-slate-400 font-extrabold uppercase tracking-widest\">Total Serales \303\232nicos</div>\n              </div>\n            </div>\n\n            <div className=\"text-center text-xs text-slate-300 font-bold bg-slate-950 p-3 rounded-xl border border-slate-850 flex flex-col sm:flex-row items-center justify-center gap-1.5 uppercase font-mono\">\n              <span>Efectividad del Emparejamiento:</span> \n              <span className={`text-sm font-black font-sans ${parseFloat(matchRatio) >= 80 ? \'text-emerald-400\' : parseFloat(matchRatio) >= 50 ? \'text-orange-400\' : \'text-red-400\'}`}>\n                {matchRatio}%\n              </span>\n              <span className=\"text-[10px] font-normal text-slate-500 lowercase normal-case\">\n                ({coincidencias.length} de {emailUniques.length} seriales del correo validados f\303\255sicamente)\n              </span>\n            </div>\n          </div>\n        )}\n\n        {/* ACCIONES FINALES COMPACTAS */}\n        <div className=\"flex flex-wrap gap-2.5 justify-center mt-5 border-t border-slate-850 pt-5\">\n          <button\n            onClick={handleAddMatchesToGeneral}\n            disabled={coincidencias.length === 0}\n            className=\"px-4 py-2 bg-emerald-600 disabled:bg-slate-900 disabled:text-slate-600 disabled:border-slate-850 disabled:cursor-not-allowed hover:bg-emerald-500 text-white rounded-lg text-xs font-extrabold uppercase tracking-wider transition-all flex items-center gap-1.5 cursor-pointer shadow-md\"\n          >\n            <Send size={13} />\n            <span>A\303\261adir Coincidencias a Gesti\303\263n</span>\n          </button>\n\n          <button\n            onClick={handleExportCruceReport}\n            disabled={totalUnicos === 0}\n            className=\"px-4 py-2 bg-blue-600 disabled:bg-slate-900 disabled:text-slate-600 disabled:border-slate-850 disabled:cursor-not-allowed hover:bg-blue-500 text-white rounded-lg text-xs font-extrabold uppercase tracking-wider transition-all flex items-center gap-1.5 cursor-pointer shadow-md\"\n          >\n            <Import size={13} />\n            <span>Descargar Reporte Cruzado</span>\n          </button>\n\n          <button\n            onClick={limpiarTodo}\n            className=\"px-4 py-2 bg-slate-950 hover:bg-slate-900 border border-slate-850 rounded-lg text-xs font-bold text-slate-400 hover:text-slate-200 uppercase tracking-wider transition-all cursor-pointer\"\n          >\n            <Trash2 size={13} />\n            <span>Limpiar Campos</span>\n          </button>\n        </div>\n      </div>\n\n    </div>\n  );\n};\n"
