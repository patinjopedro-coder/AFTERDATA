  file_change {
    absolute_path_uri: "file:///src/components/Casillero.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { POSItem, POSStatus, ModelConfig } from \'../types\';\nimport { getTerminalModel } from \'../data\';\nimport { \n  FolderLock, Check, Tool, HelpCircle, \n  RefreshCcw, ChevronLeft, ChevronRight, Save, Clipboard, Sparkles\n} from \'lucide-react\';\n\ninterface CasilleroProps {\n  serials: POSItem[];\n  setSerials: React.Dispatch<React.SetStateAction<POSItem[]>>;\n  modelosDB: Record<string, ModelConfig>;\n  globalSearch: string;\n  dateFrom: string;\n  dateTo: string;\n  statusFilter: POSStatus | \'TODOS\';\n}\n\nexport const Casillero: React.FC<CasilleroProps> = ({\n  serials,\n  setSerials,\n  modelosDB,\n  globalSearch,\n  dateFrom,\n  dateTo,\n  statusFilter\n}) => {\n  const [currentPage, setCurrentPage] = useState(1);\n  const itemsPerPage = 10;\n\n  // Filter computations\n  const casilleroSerials = serials.filter(s => {\n    // Casillero criteria: isCasillero === true OR explicitly added from validator\n    if (!s.isCasillero && !s.addedFromCruce) return false;\n\n    const searchLow = globalSearch.toLowerCase();\n    const modelInfo = getTerminalModel(s.serial, modelosDB);\n    const inSearch = !globalSearch ||\n      s.serial.toLowerCase().includes(searchLow) ||\n      s.remitente.toLowerCase().includes(searchLow) ||\n      (s.rif && s.rif.toLowerCase().includes(searchLow)) ||\n      (s.razonSocial && s.razonSocial.toLowerCase().includes(searchLow)) ||\n      (s.source && s.source.toLowerCase().includes(searchLow)) ||\n      (s.guiaSalidaCliente && s.guiaSalidaCliente.toLowerCase().includes(searchLow)) ||\n      (s.destino && s.destino.toLowerCase().includes(searchLow)) ||\n      (s.ticket && s.ticket.toLowerCase().includes(searchLow)) ||\n      (s.destinoSalida && s.destinoSalida.toLowerCase().includes(searchLow)) ||\n      modelInfo.modelo.toLowerCase().includes(searchLow);\n\n    const matchStatus = statusFilter === \'TODOS\' || s.status === statusFilter;\n    const matchDateFrom = !dateFrom || s.date >= dateFrom;\n    const matchDateTo = !dateTo || s.date <= dateTo;\n\n    return inSearch && matchStatus && matchDateFrom && matchDateTo;\n  });\n\n  // Sort newest first\n  const sortedSerials = [...casilleroSerials].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());\n\n  // Pagination\n  const totalPages = Math.ceil(sortedSerials.length / itemsPerPage) || 1;\n  const startIndex = (currentPage - 1) * itemsPerPage;\n  const paginatedSerials = sortedSerials.slice(startIndex, startIndex + itemsPerPage);\n\n  const toggleBooleanRef = (id: number, key: keyof POSItem) => {\n    setSerials(prev => prev.map(s => {\n      if (s.id === id) {\n        const val = s[key];\n        return { ...s, [key]: !val };\n      }\n      return s;\n    }));\n  };\n\n  const handleUpdateTextVal = (id: number, key: keyof POSItem, text: string) => {\n    setSerials(prev => prev.map(s => {\n      if (s.id === id) {\n        return { ...s, [key]: text };\n      }\n      return s;\n    }));\n  };\n\n  const handleToggleSelectAll = (checked: boolean) => {\n    const visibleIds = new Set(paginatedSerials.map(s => s.id));\n    setSerials(prev => prev.map(s => visibleIds.has(s.id) ? { ...s, selected: checked } : s));\n  };\n\n  const currentTodayStr = () => {\n    const d = new Date();\n    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, \'0\')}-${String(d.getDate()).padStart(2, \'0\')}`;\n  };\n\n  return (\n    <div className=\"flex flex-col gap-4 animate-fade-in text-slate-100 pb-10\">\n      \n      <div className=\"flex justify-between items-center bg-slate-900/40 p-4 rounded-xl border border-slate-800 flex-wrap gap-4\">\n        <div>\n          <h2 className=\"text-base font-bold text-blue-400 flex items-center gap-2\">\n            <FolderLock className=\"w-5 h-5 text-amber-500\" />\n            CONTROLES DE CASILLEROS / DEP\303\223SITOS\n          </h2>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Gesti\303\263n detallada de accesorios recibidos, bit\303\241cora del t\303\251cnico, sustituci\303\263n directa y liberaci\303\263n/salida.\n          </p>\n        </div>\n        \n        <div className=\"flex items-center gap-4\">\n          <span className=\"text-xs text-slate-400 font-semibold uppercase font-mono bg-slate-950 px-3 py-1.5 rounded-lg border border-slate-800\">\n            Total en Casillero: {sortedSerials.length}\n          </span>\n          {totalPages > 1 && (\n            <div className=\"flex items-center gap-1.5 bg-slate-950 p-1 rounded-lg border border-slate-800\">\n              <button\n                disabled={currentPage === 1}\n                onClick={() => setCurrentPage(p => Math.max(1, p - 1))}\n                className=\"p-1.5 bg-slate-900 border border-slate-800 hover:border-slate-700 disabled:opacity-30 rounded cursor-pointer\"\n              >\n                <ChevronLeft size={14} />\n              </button>\n              <span className=\"text-xs font-semibold px-2\">\n                P\303\241g. {currentPage} / {totalPages}\n              </span>\n              <button\n                disabled={currentPage === totalPages}\n                onClick={() => setCurrentPage(p => Math.min(totalPages, p + 1))}\n                className=\"p-1.5 bg-slate-900 border border-slate-800 hover:border-slate-700 disabled:opacity-30 rounded cursor-pointer\"\n              >\n                <ChevronRight size={14} />\n              </button>\n            </div>\n          )}\n        </div>\n      </div>\n\n      <div className=\"bg-slate-900/20 rounded-xl border border-slate-800 overflow-hidden shadow-2xl\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left border-collapse min-w-[1240px]\">\n            <thead>\n              <tr className=\"bg-slate-950/80 border-b border-slate-800 text-[10px] text-slate-400 font-bold uppercase tracking-wider\">\n                <th className=\"py-3 px-4 w-12 text-center\">\n                  <input\n                    type=\"checkbox\"\n                    checked={paginatedSerials.length > 0 && paginatedSerials.every(s => s.selected)}\n                    onChange={e => handleToggleSelectAll(e.target.checked)}\n                    className=\"rounded text-blue-600 bg-slate-900 border-slate-800\"\n                  />\n                </th>\n                <th className=\"py-3 px-4 w-28 text-center\">Fecha Entrada</th>\n                <th className=\"py-3 px-4 w-96\">Equipo / Ticket / Cliente</th>\n                <th className=\"py-3 px-4 w-44\">Accesorios</th>\n                <th className=\"py-3 px-4 w-72\">Observaciones</th>\n                <th className=\"py-3 px-4 w-52\">Sustituci\303\263n</th>\n                <th className=\"py-3 px-4 w-72\">Liberaci\303\263n / Despacho</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800/60\">\n              {paginatedSerials.length === 0 ? (\n                <tr>\n                  <td colSpan={7} className=\"text-center py-12 text-slate-500 text-xs font-mono\">\n                    No hay terminales en casillero que coincidan con la b\303\272squeda.\n                  </td>\n                </tr>\n              ) : (\n                paginatedSerials.map(s => {\n                  const modelInfo = getTerminalModel(s.serial, modelosDB);\n                  const isNew = s.date && (Math.floor((Date.now() - new Date(s.date).getTime()) / 86400000) <= 7);\n                  const isRepetido = serials.filter(o => o.serial === s.serial).length > 1;\n\n                  const serialColorClass = isRepetido\n                    ? \'text-red-400 font-bold decoration-dotted underline\'\n                    : isNew\n                      ? \'text-emerald-400 font-semibold\'\n                      : \'text-blue-300\';\n\n                  return (\n                    <tr \n                      key={s.id} \n                      className={`hover:bg-slate-900/30 transition-colors align-top ${s.selected ? \'bg-blue-600/5\' : \'\'} ${s.addedFromCruce ? \'border-l-2 border-l-blue-500\' : \'\'}`}\n                    >\n                      {/* SELECTOR */}\n                      <td className=\"py-4 px-3 text-center\">\n                        <input\n                          type=\"checkbox\"\n                          checked={!!s.selected}\n                          onChange={() => toggleBooleanRef(s.id, \'selected\')}\n                          className=\"rounded text-blue-600 bg-slate-900 border-slate-800 mt-1\"\n                        />\n                      </td>\n\n                      {/* ENTRADA (FECHA O GU\303\215A) */}\n                      <td className=\"py-4 px-3 text-center whitespace-nowrap text-xs font-mono text-slate-300\">\n                        <div>{s.displayDate}</div>\n                        {s.source ? (\n                          <div className=\"mt-1 text-[10px] text-slate-500 font-semibold\">\n                            GU\303\215A: <span className=\"text-slate-400 hover:text-blue-400 cursor-pointer\" onClick={() => navigator.clipboard.writeText(s.source)}>{s.source}</span>\n                          </div>\n                        ) : (\n                          <div className=\"text-[10px] text-slate-600 mt-1\">MANUAL</div>\n                        )}\n                        {s.addedFromCruce && (\n                          <div className=\"mt-1.5\">\n                            <span className=\"text-[9px] bg-blue-600 hover:bg-blue-500 text-white font-bold px-2 py-0.5 rounded-full select-none cursor-pointer\">\n                              CRUCE\n                            </span>\n                          </div>\n                        )}\n                      </td>\n\n                      {/* CLASIFICACI\303\223N Y DATOS COMERCIALES */}\n                      <td className=\"py-4 px-4 text-xs\">\n                        <div className=\"flex flex-col gap-1 pr-2\">\n                          <span \n                            className={`text-base tracking-wider cursor-help hover:text-white select-all font-mono transition-colors font-bold ${serialColorClass}`}\n                            onClick={async () => {\n                              await navigator.clipboard.writeText(s.serial);\n                              alert(`Serial ${s.serial} copiado.`);\n                            }}\n                          >\n                            {s.serial}\n                          </span>\n                          \n                          <div className=\"flex flex-wrap gap-1.5 items-center mt-0.5\">\n                            <span className=\"text-[9px] bg-slate-800 text-slate-300 font-mono px-1.5 py-0.5 rounded uppercase font-semibold\">\n                              {modelInfo.so === \'ANDROID\' ? \'\360\237\244\226 android\' : modelInfo.so === \'LINUX\' ? \'\360\237\220\247 linux\' : \'\342\235\223 unk\'}\n                            </span>\n                            <span className=\"text-[10px] text-slate-400 font-medium font-mono\">{modelInfo.modelo}</span>\n                          </div>\n\n                          {/* DATOS DEL CLIENTE / REGISTRO FISCAL */}\n                          {(s.rif || s.razonSocial) && (\n                            <div className=\"mt-1 bg-slate-950/50 p-2 rounded-lg border border-slate-800/80\">\n                              <span className=\"text-[9px] text-slate-500 block uppercase font-bold tracking-wider\">Cliente / Solicitante</span>\n                              <div className=\"text-slate-300 font-semibold select-all text-[11px] truncate\">\n                                {s.razonSocial || \'RAZON SOCIAL INC.\'}\n                              </div>\n                              <span className=\"text-[10px] text-blue-400 font-mono select-all font-bold\">\n                                {s.rif || \'S/R RIF\'}\n                              </span>\n                            </div>\n                          )}\n\n                          {/* INGRESO MANUAL DEL TICKET */}\n                          <div className=\"mt-1.5\">\n                            <label className=\"text-[9px] text-slate-500 block uppercase font-bold tracking-wider\">Ticket / N\302\260 Orden</label>\n                            <input\n                              type=\"text\"\n                              value={s.ticket || \'\'}\n                              onChange={e => handleUpdateTextVal(s.id, \'ticket\', e.target.value.toUpperCase())}\n                              placeholder=\"Falta ticket...\"\n                              className=\"w-full text-xs font-mono p-1.5 mt-0.5 bg-slate-950 border border-slate-800 rounded uppercase text-slate-300 focus:outline-none focus:border-blue-500\"\n                            />\n                          </div>\n                        </div>\n                      </td>\n\n                      {/* LISTADO DE ACCESORIOS */}\n                      <td className=\"py-4 px-3 text-xs w-44\">\n                        <div className=\"flex flex-col gap-1.5 pr-2\">\n                          <button\n                            onClick={() => toggleBooleanRef(s.id, \'forro\')}\n                            className={`flex items-center justify-between text-[11px] font-bold px-3 py-1 rounded-md transition-colors ${\n                              s.forro ? \'bg-blue-600/30 text-blue-300 border border-blue-500/50\' : \'bg-slate-950 border border-slate-850 hover:bg-slate-900\'\n                            }`}\n                          >\n                            <span>FORRO</span>\n                            {s.forro && <Check size={12} />}\n                          </button>\n                          \n                          <button\n                            onClick={() => toggleBooleanRef(s.id, \'bateria\')}\n                            className={`flex items-center justify-between text-[11px] font-bold px-3 py-1 rounded-md transition-colors ${\n                              s.bateria ? \'bg-blue-600/30 text-blue-300 border border-blue-500/50\' : \'bg-slate-950 border border-slate-850 hover:bg-slate-900\'\n                            }`}\n                          >\n                            <span>BATER\303\215A</span>\n                            {s.bateria && <Check size={12} />}\n                          </button>\n\n                          <button\n                            onClick={() => toggleBooleanRef(s.id, \'cargador\')}\n                            className={`flex items-center justify-between text-[11px] font-bold px-3 py-1 rounded-md transition-colors ${\n                              s.cargador ? \'bg-blue-600/30 text-blue-300 border border-blue-500/50\' : \'bg-slate-950 border border-slate-850 hover:bg-slate-900\'\n                            }`}\n                          >\n                            <span>CARGADOR</span>\n                            {s.cargador && <Check size={12} />}\n                          </button>\n\n                          <button\n                            onClick={() => toggleBooleanRef(s.id, \'caja\')}\n                            className={`flex items-center justify-between text-[11px] font-bold px-3 py-1 rounded-md transition-colors ${\n                              s.caja ? \'bg-blue-600/30 text-blue-300 border border-blue-500/50\' : \'bg-slate-950 border border-slate-850 hover:bg-slate-900\'\n                            }`}\n                          >\n                            <span>CAJA</span>\n                            {s.caja && <Check size={12} />}\n                          </button>\n\n                          {/* SIM CARD CHIP TOGGLE */}\n                          <div className=\"flex flex-col gap-1 mt-1 border-t border-slate-800 pt-1.5\">\n                            <label className=\"flex items-center gap-2 text-[10px] select-none cursor-pointer\">\n                              <input\n                                type=\"checkbox\"\n                                checked={!!s.sim}\n                                onChange={e => {\n                                  setSerials(prev => prev.map(o => {\n                                    if (o.id === s.id) {\n                                      return { ...o, sim: e.target.checked, simNumber: e.target.checked ? o.simNumber : \'\' };\n                                    }\n                                    return o;\n                                  }));\n                                }}\n                                className=\"rounded text-blue-500\"\n                              />\n                              <span className=\"font-bold uppercase\">SIM Incorporado</span>\n                            </label>\n                            {s.sim && (\n                              <input\n                                type=\"text\"\n                                value={s.simNumber || \'\'}\n                                onChange={e => handleUpdateTextVal(s.id, \'simNumber\', e.target.value.toUpperCase())}\n                                placeholder=\"Serial SIM...\"\n                                className=\"w-full text-[10px] font-mono p-1 bg-slate-950 border border-slate-800 rounded text-amber-300 uppercase\"\n                              />\n                            )}\n                          </div>\n\n                          {/* OUT TO TECHNICIAN */}\n                          <div className=\"mt-1 border-t border-slate-800 pt-2\">\n                            <label className=\"flex items-center gap-2 text-[10px] select-none cursor-pointer text-amber-400 font-bold tracking-wide\">\n                              <input\n                                type=\"checkbox\"\n                                checked={!!s.entregadoTecnico}\n                                onChange={e => toggleBooleanRef(s.id, \'entregadoTecnico\')}\n                                className=\"rounded text-amber-500 bg-slate-950\"\n                              />\n                              <span>ENTREG. TEC</span>\n                            </label>\n                          </div>\n                        </div>\n                      </td>\n\n                      {/* BIT\303\201CORA / OBSERVACIONES */}\n                      <td className=\"py-4 px-3 text-xs w-72\">\n                        <div className=\"flex flex-col gap-1 pr-2\">\n                          <label className=\"text-[9px] text-slate-500 uppercase font-bold tracking-wider mb-0.5\">Nota de reparaci\303\263n o estado f\303\255sico</label>\n                          <textarea\n                            disabled={!!s.entregadoTecnico}\n                            value={s.observaciones || \'\'}\n                            onChange={e => handleUpdateTextVal(s.id, \'observaciones\', e.target.value)}\n                            placeholder={s.entregadoTecnico ? \"Bloqueado por T\303\251cnico\" : \"Escribe observaciones...\"}\n                            className={`w-full min-h-[90px] text-xs p-2 bg-slate-950 border border-slate-800 rounded-lg text-slate-300 focus:outline-none focus:border-blue-500 transition-all ${\n                              s.entregadoTecnico ? \'bg-slate-900 border-slate-800 text-slate-500 cursor-not-allowed select-none\' : \'\'\n                            }`}\n                          />\n                          {s.entregadoTecnico && (\n                            <span className=\"text-[9px] text-amber-500 font-semibold italic mt-1\">\n                              \342\234\223 En las manos del especialista certificado. No modificable.\n                            </span>\n                          )}\n                        </div>\n                      </td>\n\n                      {/* ADAPTACI\303\223N DE SUSTITUCIONES */}\n                      <td className=\"py-4 px-3 text-xs w-52\">\n                        <div className=\"flex flex-col gap-1.5 pr-2\">\n                          <label className=\"flex items-center gap-2 text-[10px] uppercase font-bold tracking-wider select-none cursor-pointer\">\n                            <input\n                              type=\"checkbox\"\n                              checked={!!s.esSustitucion}\n                              onChange={e => {\n                                setSerials(prev => prev.map(o => {\n                                  if (o.id === s.id) {\n                                    return { \n                                      ...o, \n                                      esSustitucion: e.target.checked, \n                                      serialSustituto: e.target.checked ? o.serialSustituto : \'\',\n                                      fechaSalida: e.target.checked ? o.fechaSalida : \'\'\n                                    };\n                                  }\n                                  return o;\n                                }));\n                              }}\n                              className=\"rounded text-amber-500\"\n                            />\n                            <span>Sustituci\303\263n</span>\n                          </label>\n\n                          {s.esSustitucion && (\n                            <div className=\"space-y-1.5 bg-slate-950 p-2 rounded border border-slate-850\">\n                              <div>\n                                <label className=\"text-[9px] text-slate-500 block uppercase\">Serial Sustituto</label>\n                                <input\n                                  type=\"text\"\n                                  value={s.serialSustituto || \'\'}\n                                  onChange={e => handleUpdateTextVal(s.id, \'serialSustituto\', e.target.value.toUpperCase())}\n                                  placeholder=\"N\302\260 SERIAL NUEVO\"\n                                  className=\"w-full text-[10px] font-mono p-1 bg-slate-900 border border-slate-800 rounded text-slate-200\"\n                                />\n                              </div>\n                              <div>\n                                <label className=\"text-[9px] text-slate-500 block uppercase\">Fecha Salida</label>\n                                <input\n                                  type=\"date\"\n                                  value={s.fechaSalida || \'\'}\n                                  onChange={e => handleUpdateTextVal(s.id, \'fechaSalida\', e.target.value)}\n                                  className=\"w-full text-[9px] font-mono p-1 bg-slate-900 border border-slate-800 rounded text-slate-300\"\n                                />\n                              </div>\n                            </div>\n                          )}\n\n                          {/* SUSTITUCI\303\223N LOG TAG REVELATION */}\n                          {!s.esSustitucion && (\n                            <span className=\"text-[10px] text-slate-600 block italic\">\n                              Sin sustituci\303\263n de equipo asociada.\n                            </span>\n                          )}\n                          {s.esSustitucion && s.serialSustituto && (\n                            <div className=\"mt-1 flex flex-col gap-0.5 text-[10px] text-orange-400 bg-orange-950/20 p-1.5 rounded border border-orange-500/20\">\n                              <span className=\"font-bold\">SUST: {s.serialSustituto}</span>\n                              {s.fechaSalida && (\n                                <span className=\"text-[9px] text-slate-500\">Salida: {s.fechaSalida.split(\'-\').reverse().join(\'/\')}</span>\n                              )}\n                            </div>\n                          )}\n                        </div>\n                      </td>\n\n                      {/* LIBERACI\303\223N Y DESPACHO DE ENVIOS CLIE */}\n                      <td className=\"py-4 px-3 text-xs w-72\">\n                        <div className=\"flex flex-col gap-1.5 pr-1\">\n                          \n                          <div>\n                            <label className=\"text-[9px] text-slate-500 block uppercase font-bold tracking-wider\">Fecha Salida Cliente</label>\n                            <input\n                              type=\"date\"\n                              disabled={!!s.fechaConfirmada}\n                              value={s.fechaSalidaCliente || \'\'}\n                              onChange={e => handleUpdateTextVal(s.id, \'fechaSalidaCliente\', e.target.value)}\n                              className={`w-full text-xs font-mono p-1.5 mt-0.5 bg-slate-950 border border-slate-800 rounded text-slate-300 focus:outline-none ${\n                                s.fechaConfirmada ? \'bg-slate-900 text-slate-500 border-slate-800 cursor-not-allowed\' : \'\'\n                              }`}\n                            />\n                          </div>\n\n                          <div className=\"mt-1\">\n                            <label className=\"text-[9px] text-slate-500 block uppercase font-bold tracking-wider\">Gu\303\255a Salida (Cliente)</label>\n                            <input\n                              type=\"text\"\n                              value={s.guiaSalidaCliente || \'\'}\n                              onChange={e => handleUpdateTextVal(s.id, \'guiaSalidaCliente\', e.target.value.toUpperCase())}\n                              placeholder=\"Gu\303\255a despacho...\"\n                              className=\"w-full text-xs font-mono p-1.5 mt-0.5 bg-slate-950 border border-slate-800 rounded uppercase text-slate-300\"\n                            />\n                          </div>\n\n                          <div className=\"mt-1\">\n                            <label className=\"text-[9px] text-slate-500 block uppercase font-bold tracking-wider\">Destino Despacho</label>\n                            <input\n                              type=\"text\"\n                              value={s.destinoSalida || s.destino || \'\'}\n                              onChange={e => handleUpdateTextVal(s.id, \'destinoSalida\', e.target.value.toUpperCase())}\n                              placeholder=\"Ciudad o Agencia de salida...\"\n                              className=\"w-full text-xs p-1.5 mt-0.5 bg-slate-950 border border-slate-800 rounded uppercase text-slate-300\"\n                            />\n                          </div>\n\n                          <div className=\"mt-1 border-t border-slate-800/80 pt-1.5 flex items-center justify-between\">\n                            <label className=\"flex items-center gap-1.5 text-[10px] select-none cursor-pointer font-bold text-blue-400\">\n                              <input\n                                type=\"checkbox\"\n                                checked={!!s.fechaConfirmada}\n                                onChange={e => {\n                                  setSerials(prev => prev.map(o => {\n                                    if (o.id === s.id) {\n                                      const defaultOut = o.fechaSalidaCliente || currentTodayStr();\n                                      return { \n                                        ...o, \n                                        fechaConfirmada: e.target.checked, \n                                        fechaSalidaCliente: e.target.checked ? defaultOut : o.fechaSalidaCliente \n                                      };\n                                    }\n                                    return o;\n                                  }));\n                                }}\n                                className=\"rounded text-blue-600 bg-slate-950 border-slate-800\"\n                              />\n                              <span>CONFIRMAR SALIDA</span>\n                            </label>\n   