    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { POSItem, ModelConfig } from \'./types\';\n\nexport const INITIAL_MODELS: Record<string, ModelConfig> = {\n  \'V200C\': { modelo: \'VERIFONE V200C\', so: \'LINUX\' },\n  \'V205C\': { modelo: \'VERIFONE V205C\', so: \'LINUX\' },\n  \'V400C\': { modelo: \'VERIFONE V400C\', so: \'LINUX\' },\n  \'T650C\': { modelo: \'VERIFONE T650C\', so: \'ANDROID\' },\n  \'T650M\': { modelo: \'VERIFONE T650M\', so: \'ANDROID\' },\n  \'T650P\': { modelo: \'VERIFONE T650P\', so: \'ANDROID\' },\n  \'V240M\': { modelo: \'VERIFONE V240M\', so: \'LINUX\' },\n  \'V400M\': { modelo: \'VERIFONE V400M\', so: \'LINUX\' },\n  \'CARBONMOBILE5\': { modelo: \'VERIFONE CARBON5\', so: \'ANDROID\' },\n  \'E285\': { modelo: \'VERIFONE E285\', so: \'ANDROID\' },\n  \'X990\': { modelo: \'VERIFONE X990\', so: \'ANDROID\' },\n  \'VICTAMOBILE\': { modelo: \'VERIFONE VICTA\', so: \'ANDROID\' },\n  \'T2\': { modelo: \'SUNMI T2\', so: \'ANDROID\' },\n  \'T2S\': { modelo: \'SUNMI T2S\', so: \'ANDROID\' },\n  \'V2SPLUS\': { modelo: \'SUNMI V2S\', so: \'ANDROID\' },\n  \'KC50\': { modelo: \'ZEBRA KC50\', so: \'ANDROID\' },\n  \'EC50\': { modelo: \'ZEBRA EC50\', so: \'ANDROID\' },\n  \'ET50\': { modelo: \'ZEBRA ET50\', so: \'ANDROID\' },\n  \'SWIFT1\': { modelo: \'IMIN SWIFT1\', so: \'ANDROID\' },\n  \'SWIFT2\': { modelo: \'IMIN SWIFT2\', so: \'ANDROID\' },\n  \'SWIFT2PRO\': { modelo: \'IMIN SWIFT2PRO\', so: \'ANDROID\' },\n  \'USC100\': { modelo: \'ADVANTECH USC100\', so: \'LINUX\' },\n  \'USC200\': { modelo: \'ADVANTECH USC200\', so: \'LINUX\' },\n  \'USC300\': { modelo: \'ADVANTECH USC300\', so: \'LINUX\' },\n  \'USC500\': { modelo: \'ADVANTECH USC500\', so: \'LINUX\' },\n  \'YUNO\': { modelo: \'ADVANTECH YUNO\', so: \'LINUX\' },\n  \'VEGA3000P3\': { modelo: \'CASTLES VEGA3000\', so: \'LINUX\' },\n  \'S80\': { modelo: \'PAX S80\', so: \'LINUX\' },\n  \'S800\': { modelo: \'PAX S800\', so: \'LINUX\' },\n  \'IM30\': { modelo: \'PAX IM30\', so: \'ANDROID\' },\n  \'A920\': { modelo: \'PAX A920\', so: \'ANDROID\' },\n  \'D210\': { modelo: \'PAX D210\', so: \'LINUX\' },\n  \'DESKO\': { modelo: \'INGENICO DESKO\', so: \'LINUX\' },\n  \'MOVE5000\': { modelo: \'INGENICO MOVE\', so: \'LINUX\' },\n  \'SELF2000\': { modelo: \'INGENICO SELF\', so: \'LINUX\' },\n  \'LANE5000\': { modelo: \'INGENICO LANE\', key: \'LANE5000\', so: \'LINUX\' },\n  \'LINK2500\': { modelo: \'INGENICO LINK\', so: \'LINUX\' },\n  \'G2\': { modelo: \'G2\', so: \'ANDROID\' },\n  \'N820\': { modelo: \'N820\', so: \'ANDROID\' },\n  \'N800\': { modelo: \'N800\', so: \'ANDROID\' },\n  \'K300\': { modelo: \'K300\', so: \'ANDROID\' },\n  \'WP\': { modelo: \'WP\', so: \'ANDROID\' }\n} as unknown as Record<string, ModelConfig>;\n\nexport const INITIAL_SERIALS: POSItem[] = [\n  {\n    id: 1,\n    serial: \'K300-ABC123\',\n    date: \'2025-04-01\',\n    displayDate: \'01/04/2025\',\n    status: \'PENDIENTE\',\n    remitente: \'CLIENTE1\',\n    source: \'\',\n    isCasillero: false,\n    selected: false,\n    rif: \'\',\n    razonSocial: \'\',\n    destino: \'CARACAS\',\n    observaciones: \'\',\n    forro: true,\n    bateria: false,\n    cargador: true,\n    caja: false,\n    sim: false,\n    simNumber: \'\',\n    operadora: \'\',\n    modeloManual: \'\',\n    modeloNegocio: \'\',\n    entregadoTecnico: false,\n    esSustitucion: false,\n    serialSustituto: \'\',\n    fechaSalida: \'\',\n    fechaSalidaCliente: \'\',\n    guiaSalidaCliente: \'\',\n    destinoSalida: \'\',\n    fechaConfirmada: false,\n    ticket: \'\'\n  },\n  {\n    id: 2,\n    serial: \'V200C-001A2F\',\n    date: \'2025-04-02\',\n    displayDate: \'02/04/2025\',\n    status: \'ACTIVO\',\n    remitente: \'LOGISTICA\',\n    source: \'GUIA123\',\n    isCasillero: true,\n    selected: false,\n    rif: \'J-123456\',\n    razonSocial: \'EMPRESA X\',\n    destino: \'MARACAY\',\n    observaciones: \'Listo para revisi\303\263n f\303\255sica\',\n    forro: false,\n    bateria: false,\n    cargador: false,\n    caja: false,\n    sim: true,\n    simNumber: \'8901234567890\',\n    operadora: \'MOVISTAR\',\n    modeloManual: \'V200C\',\n    modeloNegocio: \'BASICO\',\n    entregadoTecnico: false,\n    esSustitucion: false,\n    serialSustituto: \'\',\n    fechaSalida: \'\',\n    fechaSalidaCliente: \'2025-04-10\',\n    guiaSalidaCliente: \'GUIACLIE001\',\n    destinoSalida: \'VALENCIA\',\n    fechaConfirmada: false,\n    ticket: \'TICKET-001\'\n  }\n];\n\nexport function getTerminalModel(serial: string, models: Record<string, ModelConfig>) {\n  if (!serial) return { modelo: \'-\', so: \'DESCONOCIDO\' as const };\n  const s = serial.toUpperCase();\n  \n  // Pruebas por prefijo exacto\n  for (const prefix in models) {\n    if (s.startsWith(prefix.toUpperCase())) {\n      return {\n        modelo: models[prefix].modelo || (models[prefix] as any),\n        so: models[prefix].so || \'DESCONOCIDO\' as const\n      };\n    }\n  }\n  \n  // Pruebas por inclusi\303\263n parcial\n  for (const prefix in models) {\n    if (s.includes(prefix.toUpperCase())) {\n      return {\n        modelo: models[prefix].modelo || (models[prefix] as any),\n        so: models[prefix].so || \'DESCONOCIDO\' as const\n      };\n    }\n  }\n  \n  return { modelo: \'DESCONOCIDO (-)\', so: \'DESCONOCIDO\' as const };\n}\n"
    }
