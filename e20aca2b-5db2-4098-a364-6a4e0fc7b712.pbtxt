          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const matchDateFrom = !dateFrom || s.date >= dateFrom;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const matchDateTo = !dateTo || s.date <= dateTo;"
