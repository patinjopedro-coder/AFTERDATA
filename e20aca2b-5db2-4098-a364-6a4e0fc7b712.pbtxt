ill=\"#f59e0b\" /> {/* Yellow key */}\n\n        {/* Row 4 */}\n        <rect x=\"239\" y=\"281\" width=\"16\" height=\"10\" rx=\"2\" fill=\"#ef4444\" /> {/* Cancel/Red key */}\n        <rect x=\"259\" y=\"278\" width=\"16\" height=\"10\" rx=\"2\" fill=\"#475569\" />\n        <rect x=\"279\" y=\"275\" width=\"16\" height=\"10\" rx=\"2\" fill=\"#475569\" />\n        <rect x=\"299\" y=\"272\" width=\"16\" height=\"10\" rx=\"2\" fill=\"#475569\" />\n\n        {/* Card Slot inserted credit card at the bottom */}\n        <rect x=\"244\" y=\"306\" width=\"60\" height=\"30\" rx=\"3\" fill=\"#1e3a8a\" stroke=\"#2563eb\" strokeWidth=\"1\" />\n        {/* Chip overlay on bank card */}\n        <rect x=\"248\" y=\"312\" width=\"11\" height=\"8\" rx=\"1.5\" fill=\"#e2e8f0\" />\n        <line x1=\"259\" y1=\"316\" x2=\"279\" y2=\"316\" stroke=\"#93c5fd\" strokeWidth=\"1\" />\n      </g>\n\n      {/* 4. The Grand Swooping Golden-Orange Arrow (Glows and Shines) */}\n      {/* Starting bottom center inside D, wrapping outwards to the right and shooting up past the D */}\n      <g filter=\"url(#logoGlow)\">\n        {/* Back glowing line */}\n        <path \n          d=\"M 155 358 \n             C 210 375, 345 350, 400 240 \n             C 425 190, 442 135, 445 105\" \n          stroke=\"#f59e0b\" \n          strokeWidth=\"18\" \n          strokeLinecap=\"round\" \n          fill=\"none\" \n          opacity=\"0.3\" \n        />\n        \n        {/* Solid Arrow Path with custom gradient */}\n        <path \n          d=\"M 155 358 \n             C 210 375, 345 350, 400 240 \n             C 425 190, 442 135, 445 105\" \n          stroke=\"url(#arrowGradient)\" \n          strokeWidth=\"12\" \n          strokeLinecap=\"round\" \n          fill=\"none\" \n        />\n\n        {/* Sharp Arrow-Head facing North-East */}\n        <polygon \n          points=\"445,100 405,138 418,92\" \n          fill=\"url(#arrowGradient)\" \n          stroke=\"#b45309\"\n          strokeWidth=\"1.5\