  file_change {
    absolute_path_uri: "file:///src/components/CruceSeriales.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { POSItem, POSStatus, ModelConfig, CruceItem } from \'../types\';\nimport { \n  FileCheck, Shield, Clipboard, RefreshCw, Layers, \n  Trash2, Search, ArrowRightLeft, Check, HelpCircle, Import, Send, Grid, Settings\n} from \'lucide-react\';\n\ninterface CruceSerialesProps {\n  serials: POSItem[];\n  setSerials: React.Dispatch<React.SetStateAction<POSItem[]>>;\n  modelosDB: Record<string, ModelConfig>;\n}\n\nexport const CruceSeriales: React.FC<CruceSerialesProps> = ({\n  serials,\n  setSerials,\n  modelosDB\n}) => {\n  // Shared state inside local storages & React\n  const [emailText, setEmailText] = useState(\'\');\n  const [fisicoText, setFisicoText] = useState(\'\');\n\n  const [emailSerialsArray, setEmailSerialsArray] = useState<CruceItem[]>(() => {\n    return JSON.parse(localStorage.getItem(\'emailSerialsArray\') || \'[]\');\n  });\n  const [fisicoSerialsArray, setFisicoSerialsArray] = useState<CruceItem[]>(() => {\n    return JSON.parse(localStorage.getItem(\'fisicoSerialsArray\') || \'[]\');\n  });\n\n  const [selectedEmails, setSelectedEmails] = useState<Set<number>>(() => {\n    const list = JSON.parse(localStorage.getItem(\'selectedEmails\') || \'[]\');\n    return new Set(list);\n  });\n  const [selectedFisicos, setSelectedFisicos] = useState<Set<number>>(() => {\n    const list = JSON.parse(localStorage.getItem(\'selectedFisicos\') || \'[]\');\n    return new Set(list);\n  });\n\n  const [datosMaestro, setDatosMaestro] = useState<CruceItem[]>(() => {\n    return JSON.parse(localStorage.getItem(\'datosMaestro\') || \'[]\');\n  });\n\n  const [remitenteCorreo, setRemitenteCorreo] = useState(\'VALIDADOR\');\n\n  // Modal manual states\n  const [isManualModalOpen, setIsManualModalOpen] = useState(false);\n  const [manualSerials, setManualSerials] = useState(\'\');\n  const [manualStatus, setManualStatus] = useState(\'\');\n  const [manualRemitente, setManualRemitente] = useState(\'VALIDADOR\');\n  const [manualFecha, setManualFecha] = useState(() => {\n    const d = new Date();\n    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, \'0\')}-${String(d.getDate()).padStart(2, \'0\')}`;\n  });\n\n  const maestroCargado = datosMaestro.length > 0;\n\n  useEffect(() => {\n    localStorage.setItem(\'emailSerialsArray\', JSON.stringify(emailSerialsArray));\n    localStorage.setItem(\'fisicoSerialsArray\', JSON.stringify(fisicoSerialsArray));\n    localStorage.setItem(\'selectedEmails\', JSON.stringify([...selectedEmails]));\n    localStorage.setItem(\'selectedFisicos\', JSON.stringify([...selectedFisicos]));\n    localStorage.setItem(\'datosMaestro\', JSON.stringify(datosMaestro));\n  }, [emailSerialsArray, fisicoSerialsArray, selectedEmails, selectedFisicos, datosMaestro]);\n\n  const parseCSVLine = (line: string, delimiter: string) => {\n    const result: string[] = [];\n    let insideQuotes = false;\n    let current = \'\';\n    for (let i = 0; i < line.length; i++) {\n      const c = line[i];\n      if (c === \'\"\') {\n        insideQuotes = !insideQuotes;\n      } else if (c === delimiter && !insideQuotes) {\n        result.push(current.trim());\n        current = \'\';\n      } else {\n        current += c;\n      }\n    }\n    result.push(current.trim());\n    return result;\n  };\n\n  const cleanHeader = (h: string) => {\n    return h.trim().toLowerCase()\n      .normalize(\"NFD\")\n      .replace(/[\\u0300-\\u036f]/g, \"\")\n      .replace(/[^a-z0-9\\s]/g, \"\");\n  };\n\n  const handleImportValidatorFile = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n\n    const reader = new FileReader();\n    reader.onload = (event) => {\n      try {\n        const text = event.target?.result as string;\n        const lines = text.split(/\\r?\\n/).map(l => l.trim()).filter(Boolean);\n        if (lines.length < 2) {\n          alert(\'Archivo vac\303\255o o insuficiente.\');\n          return;\n        }\n\n        const firstLine = lines[0];\n        const delimiter = (firstLine.includes(\';\') && !firstLine.includes(\',\')) ? \';\' : \',\';\n\n        const headers = parseCSVLine(firstLine, delimiter).map(cleanHeader);\n        console.log(\"Headers detectados:\", headers);\n\n        // Flexible headers check\n        let idxSerial = headers.findIndex(h => h.includes(\'serial\') && (h.includes(\'terminal\') || h.includes(\'serial\') || h.includes(\'equipo\')));\n        let idxNoTerminal = headers.findIndex(h => h.includes(\'no\') || h.includes(\'terminal\') || h.includes(\'numero\') || h.includes(\'ticket\'));\n        let idxOperador = headers.findIndex(h => h.includes(\'operador\') || h.includes(\'operadora\') || h.includes(\'company\'));\n        let idxSim = headers.findIndex(h => h.includes(\'sim\') && (h.includes(\'serial\') || h.includes(\'numero\')));\n        let idxStatusServicio = headers.findIndex(h => h.includes(\'status servicio\') || h.includes(\'estado servicio\') || h.includes(\'status\') || h.includes(\'estado\'));\n\n        if (idxSerial === -1) idxSerial = 0;\n        if (idxStatusServicio === -1) idxStatusServicio = Math.min(headers.length - 1, 9);\n        if (idxNoTerminal === -1) idxNoTerminal = 1;\n        if (idxOperador === -1) idxOperador = 2;\n        if (idxSim === -1) idxSim = 3;\n\n        const mappedMaster: CruceItem[] = [];\n\n        for (let i = 1; i < lines.length; i++) {\n          const cols = parseCSVLine(lines[i], delimiter);\n          if (cols.length <= idxSerial) continue;\n\n          const serialVal = cols[idxSerial]?.toUpperCase().trim();\n          if (!serialVal) continue;\n\n          const rawStatus = cols[idxStatusServicio]?.toUpperCase().trim() || \'\';\n          let finalStatus: POSStatus = \'SIN ESTATUS\';\n          if (rawStatus.includes(\'PENDIENTE\')) finalStatus = \'PENDIENTE\';\n          else if (rawStatus.includes(\'ACTIVO\')) finalStatus = \'ACTIVO\';\n          else if (rawStatus.includes(\'SUSPENDIDO\')) finalStatus = \'SUSPENDIDO\';\n          else if (rawStatus.includes(\'CANCELADO\')) finalStatus = \'CANCELADO\';\n          else if (rawStatus.includes(\'N/A\') || rawStatus === \'NA\' || rawStatus.includes(\'N#A\')) finalStatus = \'N#A\';\n\n          mappedMaster.push({\n            serial: serialVal,\n            status: finalStatus,\n            operadora: cols[idxOperador]?.toUpperCase().trim() || \'\',\n            simNumber: cols[idxSim]?.toUpperCase().trim() || \'\',\n            ticket: cols[idxNoTerminal]?.toUpperCase().trim() || \'\'\n          });\n        }\n\n        setDatosMaestro(mappedMaster);\n        alert(`\342\234\205 Validador cargado: ${mappedMaster.length} registros cargados exitosamente.`);\n\n        // Reactive update existing entries inside active lists\n        updateMatchingStatusesInCruce(mappedMaster);\n\n      } catch (err: any) {\n        alert(`Error al procesar archivo: ${err.message}`);\n      }\n    };\n    reader.readAsText(file, \'UTF-8\');\n  };\n\n  const updateMatchingStatusesInCruce = (master: CruceItem[]) => {\n    const masterMap = new Map(master.map(item => [item.serial, item]));\n\n    setEmailSerialsArray(prev => prev.map(item => {\n      const match = masterMap.get(item.serial);\n      if (match) {\n        return {\n          ...item,\n          status: match.status,\n          operadora: match.operadora,\n          simNumber: match.simNumber,\n          ticket: match.ticket\n        };\n      }\n      return item;\n    }));\n\n    setFisicoSerialsArray(prev => prev.map(item => {\n      const match = masterMap.get(item.serial);\n      if (match) {\n        return {\n          ...item,\n          status: match.status,\n          operadora: match.operadora,\n          simNumber: match.simNumber,\n          ticket: match.ticket\n        };\n      }\n      return item;\n    }));\n  };\n\n  const lookupValidador = (serial: string): CruceItem | null => {\n    if (datosMaestro.length === 0) return null;\n    const cleanSerial = serial.trim().toUpperCase();\n    let found = datosMaestro.find(m => m.serial === cleanSerial);\n    if (!found) {\n      // Approximate lookup\n      found = datosMaestro.find(m => m.serial.includes(cleanSerial) || cleanSerial.includes(m.serial));\n    }\n    return found || null;\n  };\n\n  const processInputSerials = (tipo: \'email\' | \'fisico\') => {\n    const inputField = tipo === \'email\' ? emailText : fisicoText;\n    const cleanLines = inputField.split(/[\\r\\n,;]+/).map(s => s.trim().toUpperCase()).filter(Boolean);\n    if (cleanLines.length === 0) return;\n\n    const currentArray = tipo === \'email\' ? emailSerialsArray : fisicoSerialsArray;\n    const setArray = tipo === \'email\' ? setEmailSerialsArray : setFisicoSerialsArray;\n\n    const itemsToAdd: CruceItem[] = [];\n\n    cleanLines.forEach(serial => {\n      if (!currentArray.some(item => item.serial === serial)) {\n        const match = lookupValidador(serial);\n        itemsToAdd.push({\n          serial,\n          status: match ? match.status : \'N#A\',\n          operadora: match ? match.operadora : \'\',\n          simNumber: match ? match.simNumber : \'\',\n          ticket: match ? match.ticket : \'\'\n        });\n      }\n    });\n\n    setArray(prev => [...prev, ...itemsToAdd]);\n\n    // reset textarea\n    if (tipo === \'email\') setEmailText(\'\');\n    else setFisicoText(\'\');\n  };\n\n  const bubbleOptionClass = (status: POSStatus) => {\n    switch (status) {\n      case \'PENDIENTE\': return \'bg-amber-600/20 text-amber-300 border-amber-500/50 hover:bg-amber-600/30\';\n      case \'ACTIVO\': return \'bg-emerald-600/20 text-emerald-300 border-emerald-500/50 hover:bg-emerald-600/30\';\n      case \'SUSPENDIDO\': return \'bg-red-600/20 text-red-300 border-red-500/50 hover:bg-red-600/30\';\n      case \'CANCELADO\': return \'bg-cyan-600/20 text-cyan-300 border-cyan-500/50 hover:bg-cyan-600/30\';\n      case \'N#A\': return \'bg-purple-600/20 text-purple-300 border-purple-500/50 hover:bg-purple-600/30\';\n      default: return \'bg-slate-800/40 text-slate-300 border-slate-700 hover:bg-slate-800/60\';\n    }\n  };\n\n  const handleToggleSelectBubble = (tipo: \'email\' | \'fisico\', index: number) => {\n    const selectedSet = tipo === \'email\' ? selectedEmails : selectedFisicos;\n    const setSelected = tipo === \'email\' ? setSelectedEmails : setSelectedFisicos;\n\n    const copy = new Set(selectedSet);\n    if (copy.has(index)) copy.delete(index);\n    else copy.add(index);\n    setSelected(copy);\n  };\n\n  const removeSingleCruceSerial = (tipo: \'email\' | \'fisico\', index: number) => {\n    const array = tipo === \'email\' ? emailSerialsArray : fisicoSerialsArray;\n    const setArray = tipo === \'email\' ? setEmailSerialsArray : setFisicoSerialsArray;\n    const selectedSet = tipo === \'email\' ? selectedEmails : selectedFisicos;\n    const setSelected = tipo === \'email\' ? setSelectedEmails : setSelectedFisicos;\n\n    const filteredItem = array.filter((_, i) => i !== index);\n    setArray(filteredItem);\n\n    // shift selections down\n    const nextSelections = new Set<number>();\n    selectedSet.forEach(sel => {\n      if (sel < index) nextSelections.add(sel);\n      else if (sel > index) nextSelections.add(sel - 1);\n    });\n    setSelected(nextSelections);\n  };\n\n  const selectGroupAction = (tipo: \'email\' | \'fisico\', act: \'all\' | \'none\' | \'invert\') => {\n    const array = tipo === \'email\' ? emailSerialsArray : fisicoSerialsArray;\n    const setSelected = tipo === \'email\' ? setSelectedEmails : setSelectedFisicos;\n    const selectedSet = tipo === \'email\' ? selectedEmails : selectedFisicos;\n\n    if (act === \'all\') {\n      setSelected(new Set(array.map((_, i) => i)));\n    } else if (act === \'none\') {\n      setSelected(new Set());\n    } else {\n      const inverted = new Set<number>();\n      array.forEach((_, i) => {\n        if (!selectedSet.has(i)) inverted.add(i);\n      });\n      setSelected(inverted);\n    }\n  };\n\n  // Dual comparisons\n  const emailsUniques = Array.from(new Set(emailSerialsArray.map(item => item.serial)));\n  const fisicosUniques = Array.from(new Set(fisicoSerialsArray.map(item => item.serial)));\n\n  const setEmail = new Set(emailsUniques);\n  const setFisico = new Set(fisicosUniques);\n\n  const coincidencias = emailsUniques.filter(s => setFisico.has(s));\n  const soloCorreo = emailsUniques.filter(s => !setFisico.has(s));\n  const soloFisico = fisicosUniques.filter(s => !setEmail.has(s));\n\n  const totalSerialsCruce = emailSerialsArray.length;\n  const matchRatio = totalSerialsCruce ? ((coincidencias.length / totalSerialsCruce) * 100).toFixed(1) : \'0.0\';\n\n  // Manual Imports inside Modal\n  const executeManualModalImport = (destino: \'email\' | \'fisico\' | \'gestion\') => {\n    const enteredSerials = manualSerials.split(/[\\r\\n,;]+/).map(s => s.trim().toUpperCase()).filter(Boolean);\n    if (enteredSerials.length === 0) {\n      alert(\'POR FAVOR INGRESE AL MENOS UN SERIAL V\303\201LIDO\');\n      return;\n    }\n\n    const enteredStatuses = manualStatus.split(/[\\r\\n,;]+/).map(s => s.trim().toUpperCase()).filter(Boolean);\n\n    // Create CruceItems\n    const createdItems: CruceItem[] = enteredSerials.map((s, idx) => {\n      const match = lookupValidador(s);\n      \n      // lookup manually typed status or fallback\n      let statusValue: POSStatus = \'SIN ESTATUS\';\n      const typedStatus = enteredStatuses[idx];\n      if (typedStatus) {\n        if (typedStatus.includes(\'PENDIENTE\')) statusValue = \'PENDIENTE\';\n        else if (typedStatus.includes(\'ACTIVO\')) statusValue = \'ACTIVO\';\n        else if (typedStatus.includes(\'SUSPENDIDO\')) statusValue = \'SUSPENDIDO\';\n        else if (typedStatus.includes(\'CANCELADO\')) statusValue = \'CANCELADO\';\n        else if (typedStatus.includes(\'N/A\') || typedStatus.includes(\'N#A\') || typedStatus === \'NA\') statusValue = \'N#A\';\n      } else if (match) {\n        statusValue = match.status;\n      }\n\n      return {\n        serial: s,\n        status: statusValue,\n        operadora: match ? match.operadora : \'\',\n        simNumber: match ? match.simNumber : \'\',\n        ticket: match ? match.ticket : \'\'\n      };\n    });\n\n    if (destino === \'email\') {\n      setEmailSerialsArray(prev => {\n        const unique = [...prev];\n        createdItems.forEach(item => {\n          if (!unique.some(o => o.serial === item.serial)) unique.push(item);\n        });\n        return unique;\n      });\n      alert(`Se importaron ${createdItems.length} seriales a CORREO`);\n    } else if (destino === \'fisico\') {\n      setFisicoSerialsArray(prev => {\n        const unique = [...prev];\n        createdItems.forEach(item => {\n          if (!unique.some(o => o.serial === item.serial)) unique.push(item);\n        });\n        return unique;\n      });\n      alert(`Se importaron ${createdItems.length} seriales a F\303\215SICO`);\n    } else {\n      // Directly input and save inside master General db\n      const today = manualFecha;\n      const displayToday = today.split(\'-\').reverse().join(\'/\');\n\n      const formattedPOSItems: POSItem[] = createdItems.map(item => {\n        return {\n          id: Date.now() + Math.random(),\n          serial: item.serial,\n          date: today,\n          displayDate: displayToday,\n          status: item.status,\n          remitente: manualRemitente.toUpperCase().trim() || \'MANUAL\',\n          source: \'\',\n          isCasillero: false,\n          selected: false,\n          rif: \'\',\n          razonSocial: \'\',\n          destino: \'\',\n          observaciones: \'\',\n          forro: false,\n          bateria: false,\n          cargador: false,\n          caja: false,\n          sim: !!item.simNumber,\n          simNumber: item.simNumber,\n          operadora: item.operadora as any,\n          modeloManual: \'\',\n          modeloNegocio: \'\',\n          entregadoTecnico: false,\n          esSustitucion: false,\n          serialSustituto: \'\',\n          fechaSalida: \'\',\n          fechaSalidaCliente: \'\',\n          guiaSalidaCliente: \'\',\n          destinoSalida: \'\',\n          fechaConfirmada: false,\n          ticket: item.ticket\n        };\n      });\n\n      setSerials(prev => {\n        const uniqueList = [...prev];\n        formattedPOSItems.forEach(item => {\n          const existIdx = uniqueList.findIndex(o => o.serial === item.serial);\n          if (existIdx !== -1) {\n            uniqueList[existIdx].status = item.status;\n            if (item.ticket) uniqueList[existIdx].ticket = item.ticket;\n            if (item.simNumber) {\n              uniqueList[existIdx].sim = true;\n              uniqueList[existIdx].simNumber = item.simNumber;\n            }\n          } else {\n            uniqueList.unshift(item);\n          }\n        });\n        return uniqueList;\n      });\n\n      alert(`Se importaron y reconciliaron ${createdItems.length} seriales en GESTI\303\223N GENERAL.`);\n    }\n\n    // Reset modals\n    setManualSerials(\'\');\n    setManualStatus(\'\');\n    setIsManualModalOpen(false);\n  };\n\n  const handleDeselectCruceBulkState = (forcedStatus: POSStatus | null) => {\n    // Collect all selected items in correo & fisico\n    const selectedEmailItems = emailSerialsArray.filter((_, idx) => selectedEmails.has(idx));\n    const selectedFisicoItems = fisicoSerialsArray.filter((_, idx) => selectedFisicos.has(idx));\n\n    const totalSelected = [...selectedEmailItems, ...selectedFisicoItems];\n    if (totalSelected.length === 0) {\n      alert(\'POR FAVOR SELECCIONE CHIPS/BURBUJAS DE SERIALES PARA MIGRAR O ASIGNAR.\');\n      return;\n    }\n\n    const uniqueSelected = [...new Map(totalSelected.map(item => [item.serial, item])).values()];\n    const today = currentDateStr();\n    const displayToday = today.split(\'-\').reverse().join(\'/\');\n    const cleanRemitente = remitenteCorreo.trim().toUpperCase() || \'VALIDADOR\';\n\n    let nuevos = 0;\n    let actualizados = 0;\n\n    setSerials(prev => {\n      const dbCopy = [...prev];\n\n      uniqueSelected.forEach(item => {\n        const targetStatus = forcedStatus !== null ? forcedStatus : item.status;\n        const existIdx = dbCopy.findIndex(o => o.serial === item.serial);\n\n        if (existIdx !== -1) {\n          dbCopy[existIdx].status = targetStatus;\n          if (item.operadora) dbCopy[existIdx].operadora = item.operadora as any;\n          if (item.simNumber) {\n            dbCopy[existIdx].sim = true;\n            dbCopy[existIdx].simNumber = item.simNumber;\n          }\n          if (item.ticket && !dbCopy[existIdx].ticket) {\n            dbCopy[existIdx].ticket = item.ticket;\n          }\n          actualizados++;\n        } else {\n          dbCopy.unshift({\n            id: Date.now() + Math.random(),\n            serial: item.serial,\n            date: today,\n            displayDate: displayToday,\n            status: targetStatus,\n            remitente: cleanRemitente,\n            source: \'\',\n            isCasillero: false,\n            selected: false,\n            rif: \'\',\n            razonSocial: \'\',\n            destino: \'\',\n            observaciones: \'\',\n            forro: false,\n            bateria: false,\n            cargador: false,\n            caja: false,\n            sim: !!item.simNumber,\n            simNumber: item.simNumber,\n            operadora: item.operadora as any,\n            modeloManual: \'\',\n            modeloNegocio: \'\',\n            entregadoTecnico: false,\n            esSustitucion: false,\n            serialSustituto: \'\',\n            fechaSalida: \'\',\n            fechaSalidaCliente: \'\',\n            guiaSalidaCliente: \'\',\n            destinoSalida: \'\',\n            fechaConfirmada: false,\n            ticket: item.ticket,\n            addedFromCruce: true\n          });\n          nuevos++;\n        }\n      });\n\n      return dbCopy;\n    });\n\n    alert(`Reconciliaci\303\263n masiva completa:\\n\342\200\242 ${nuevos} Nuevos Registros creados\\n\342\200\242 ${actualizados} Registros Actualizados.\\nRemitente asignado: \"${cleanRemitente}\".`);\n\n    // Clean only migrated selections\n    setSelectedEmails(new Set());\n    setSelectedFisicos(new Set());\n  };\n\n  const handleExportCruceReport = () => {\n    let csv = \"SERIAL,ESTADO_VALIDADOR,OPERADORA,SIM_CARD,TICKET_CASO\\n\";\n    const total = [...emailSerialsArray, ...fisicoSerialsArray];\n    const unique = new Map<string, CruceItem>();\n    total.forEach(item => { if (!unique.has(item.serial)) unique.set(item.serial, item); });\n\n    for (const item of unique.values()) {\n      csv += `\"${item.serial}\",\"${item.status}\",\"${item.operadora || \'\'}\",\"${item.simNumber || \'\'}\",\"${item.ticket || \'\'}\"\\n`;\n    }\n\n    const blob = new Blob([\"\\uFEFF\" + csv], { type: \"text/csv;charset=utf-8;\" });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\'a\');\n    link.href = url;\n    link.download = `cruce_informe_${currentDateStr()}.csv`;\n    link.click();\n    URL.revokeObjectURL(url);\n  };\n\n  const currentDateStr = () => {\n    const d = new Date();\n    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, \'0\')}-${String(d.getDate()).padStart(2, \'0\')}`;\n  };\n\n  return (\n    <div className=\"flex flex-col gap-5 animate-fade-in text-slate-100 pb-16\">\n      \n      {/* VALIDADOR DE SUBIDAS */}\n      <div className=\"bg-slate-900/60 p-5 rounded-xl border border-slate-800\">\n        <div className=\"flex flex-col md:flex-row justify-between items-center gap-4\">\n          <div>\n            <h3 className=\"text-base font-bold text-blue-400 flex items-center gap-2\">\n              <FileCheck className=\"text-emerald-500 w-5 h-5\" />\n              VALIDACI\303\223N DIGITAL CONTRA LISTADO DE CONTROL (Hoja2)\n            </h3>\n            <p className=\"text-xs text-slate-400 mt-1\">\n              Carga un listado exportado de control en formato CSV o TXT para habilitar la confrontaci\303\263n inteligente de estados y chips.\n            </p>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className={`text-[10px] font-bold px-3 py-1.5 rounded-full select-none ${maestroCargado ? \'bg-emerald-950 text-emerald-400 border border-emerald-500/20\' : \'bg-red-950 text-red-400 border border-red-500/20\'}`}>\n              {maestroCargado ? `VALIDADOR CARGADO (${datosMaestro.length} terminales)` : \'VALIDADOR DESCONECTADO\'}\n            </span>\n            <label className=\"px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-xs font-bold uppercase cursor-pointer select-none transition-all shadow-lg hover:shadow-blue-500/10\">\n              <input \n                type=\"file\" \n                accept=\".csv,.txt\" \n                onChange={handleImportValidatorFile} \n                className=\"hidden\" \n              />\n              Cargar Archivo\n            </label>\n            <button\n              onClick={() => setIsManualModalOpen(true)}\n              className=\"px-4 py-2 bg-purple-600/20 hover:bg-purple-600/30 text-purple-300 border border-purple-500/30 rounded-lg text-xs font-bold uppercase cursor-pointer\"\n            >\n              Carga Manual\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* DETALLE PRINCIPAL COLUMNS - CORREO VS F\303\215SICO */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        \n        {/* COLUMNA CORREOS */}\n        <div className=\"bg-slate-900/40 p-5 rounded-xl border border-slate-800 flex flex-col gap-3\">\n          <div className=\"flex justify-between items-center border-b border-slate-800 pb-3\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"w-2.5 h-2.5 rounded-full bg-blue-500\"></span>\n              <h4 className=\"font-bold text-sm text-blue-400 uppercase tracking-wide\">Pega de Seriales desde Correo</h4>\n            </div>\n\n            <div className=\"flex gap-1\">\n              <button onClick={() => selectGroupAction(\'email\', \'all\')} className=\"px-1.5 py-0.5 bg-slate-950 border border-slate-800 hover:border-slate-700 text-[9px] font-bold rounded\">TODOS</button>\n              <button onClick={() => selectGroupAction(\'email\', \'none\')} className=\"px-1.5 py-0.5 bg-slate-950 border border-slate-800 hover:border-slate-700 text-[9px] font-bold rounded\">X</button>\n              <button onClick={() => selectGroupAction(\'email\', \'invert\')} className=\"px-1.5 py-0.5 bg-slate-950 border border-slate-800 hover:border-slate-700 text-[9px] font-bold rounded\">INV</button>\n            </div>\n          </div>\n\n          <div className=\"text-[11px] text-slate-500 flex justify-between\">\n            <span>Ingresa un listado plano de seriales:</span>\n            <span className=\"font-bold text-slate-400\">Total: {emailSerialsArray.length}</span>\n          </div>\n\n          <textarea\n            value={emailText}\n            onChange={e => setEmailText(e.target.value)}\n            onBlur={() => processInputSerials(\'email\')}\n            placeholder=\"Pega aqu\303\255 y haz click fuera o presiona procesar...\"\n            rows={3}\n            className=\"w-full text-xs font-mono p-3 bg-slate-950 border border-slate-850 rounded-lg focus:outline-none focus:border-blue-500 text-blue-450 text-blue-300\"\n          />\n\n          <button\n            onClick={() => processInputSerials(\'email\')}\n            className=\"w-full py-1.5 bg-blue-600/10 hover:bg-blue-600/20 text-blue-400 border border-blue-500/20 text-xs font-bold rounded-lg cursor-pointer\"\n          >\n            Agregar a Listado de Correo\n          </button>\n\n          {/* CHIPS CONTAINER */}\n          <div className=\"bg-slate-950/60 rounded-xl p-3 border border-slate-850 min-h-[140px] max-h-[310px] overflow-y-auto flex flex-col gap-1.5\">\n            {emailSerialsArray.length === 0 ? (\n              <div className=\"text-center text-xs text-slate-600 my-auto\">Pega o importa seriales para comenzar.</div>\n            ) : (\n              emailSerialsArray.map((item, idx) => {\n                const isSelected = selectedEmails.has(idx);\n                return (\n                  <div\n                    key={idx}\n                    onClick={() => handleToggleSelectBubble(\'email\', idx)}\n                    className={`flex items-center justify-between p-2 rounded-lg border text-xs font-semibold select-all font-mono transition-all cursor-pointer ${bubbleOptionClass(item.status)} ${\n                      isSelected ? \'ring-1 ring-white/70 scale-[0.99] brightness-[1.12]\' : \'\'\n                    }`}\n                  >\n                    <div className=\"flex items-center gap-2 truncate\">\n                      <div className={`w-1.5 h-1.5 rounded-full ${isSelected ? \'bg-white\' : \'bg-slate-500\'}`} />\n                      <span>{item.serial}</span>\n                      <span className=\"text-[9px] tracking-wider opacity-60\">[{item.status}]</span>\n                    </div>\n                    <button\n                      onClick={(e) => { e.stopPropagation(); removeSingleCruceSerial(\'email\', idx); }}\n                      className=\"text-slate-400 hover:text-white px-2 py-0.5 rounded-md hover:bg-slate-950/60 font-sans\"\n                    >\n                      \303\227\n                    </button>\n                  </div>\n                );\n              })\n            )}\n          </div>\n        </div>\n\n        {/* COLUMNA F\303\215SICOS */}\n        <div className=\"bg-slate-900/40 p-5 rounded-xl border border-slate-800 flex flex-col gap-3\">\n          <div className=\"flex justify-between items-center border-b border-slate-800 pb-3\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"w-2.5 h-2.5 rounded-full bg-orange-500\"></span>\n              <h4 className=\"font-bold text-sm text-orange-400 uppercase tracking-wide\">Lecturas de Seriales F\303\255sicos</h4>\n            </div>\n\n            <div className=\"flex gap-1\">\n              <button onClick={() => selectGroupAction(\'fisico\', \'all\')} className=\"px-1.5 py-0.5 bg-slate-950 border border-slate-800 hover:border-slate-700 text-[9px] font-bold rounded\">TODOS</button>\n              <button onClick={() => selectGroupAction(\'fisico\', \'none\')} className=\"px-1.5 py-0.5 bg-slate-950 border border-slate-800 hover:border-slate-700 text-[9px] font-bold rounded\">X</button>\n              <button onClick={() => selectGroupAction(\'fisico\', \'invert\')} className=\"px-1.5 py-0.5 bg-slate-950 border border-slate-800 hover:border-slate-700 text-[9px] font-bold rounded\">INV</button>\n            </div>\n          </div>\n\n          <div className=\"text-[11px] text-slate-500 flex justify-between\">\n            <span>Ingresa las lecturas de pistola o listado de inventario:</span>\n            <span className=\"font-bold text-slate-400\">Total: {fisicoSerialsArray.length}</span>\n          </div>\n\n          <textarea\n            value={fisicoText}\n            onChange={e => setFisicoText(e.target.value)}\n            onBlur={() => processInputSerials(\'fisico\')}\n            placeholder=\"Pega aqu\303\255 las lecturas de seriales...\"\n            rows={3}\n            className=\"w-full text-xs font-mono p-3 bg-slate-950 border border-slate-850 rounded-lg focus:outline-none focus:border-blue-500 text-orange-300\"\n          />\n\n          <button\n            onClick={() => processInputSerials(\'fisico\')}\n            className=\"w-full py-1.5 bg-orange-600/10 hover:bg-orange-600/20 text-orange-400 border border-orange-500/20 text-xs font-bold rounded-lg cursor-pointer\"\n          >\n            Agregar a Listado F\303\255sico\n          </button>\n\n          {/* CHIPS FISICO CONTAINER */}\n          <div className=\"bg-slate-950/60 rounded-xl p-3 border border-slate-850 min-h-[140px] max-h-[310px] overflow-y-auto flex flex-col gap-1.5\">\n            {fisicoSerialsArray.length === 0 ? (\n              <div className=\"text-center text-xs text-slate-600 my-auto\">Pega o lee terminales f\303\255sicos.</div>\n            ) : (\n              fisicoSerialsArray.map((item, idx) => {\n                const isSelected = selectedFisicos.has(idx);\n                return (\n                  <div\n                    key={idx}\n                    onClick={() => handleToggleSelectBubble(\'fisico\', idx)}\n                    className={`flex items-center justify-between p-2 rounded-lg border text-xs font-semibold select-all font-mono transition-all cursor-pointer ${bubbleOptionClass(item.status)} ${\n                      isSelected ? \'ring-1 ring-white/70 scale-[0.99] brightness-[1.12]\' : \'\'\n                    }`}\n                  >\n                    <div className=\"flex items-center gap-2 truncate\">\n                      <div className={`w-1.5 h-1.5 rounded-full ${isSelected ? \'bg-white\' : \'bg-slate-500\'}`} />\n                      <span>{item.serial}</span>\n                      <span className=\"text-[9px] tracking-wider opacity-60\">[{item.status}]</span>\n                    </div>\n                    <button\n                      onClick={(e) => { e.stopPropagation(); removeSingleCruceSerial(\'fisico\', idx); }}\n                      className=\"text-slate-400 hover:text-white px-2 py-0.5 rounded-md hover:bg-slate-950/60 font-sans\"\n                    >\n                      \303\227\n                    </button>\n                  </div>\n                );\n              })\n            )}\n          </div>\n        </div>\n\n      </div>\n\n      {/* CONFRONTACI\303\223N INTEGRA / ESTADO FORZADO */}\n      <div className=\"bg-slate-900/60 p-5 rounded-xl border border-slate-800 grid grid-cols-1 md:grid-cols-2 gap-6\">\n        <div>\n          <label className=\"text-xs font-bold text-blue-400 block mb-1\">Nombre Remitente de Correo / Validador</label>\n          <input\n            type=\"text\"\n            value={remitenteCorreo}\n            onChange={e => setRemitenteCorreo(e.target.value.toUpperCase())}\n            placeholder=\"Asigna remitente al migrar...\"\n            className=\"w-full text-xs p-2.5 bg-slate-950 border border-slate-850 rounded-lg text-slate-200 uppercase font-semibold\"\n          />\n        </div>\n\n        <div>\n          <label className=\"text-xs font-bold text-blue-500 block mb-1.5\">Forzar un estado a burbujas seleccionadas</label>\n          <div className=\"flex flex-wrap gap-1.5\">\n            {([\'PENDIENTE\', \'ACTIVO\', \'SUSPENDIDO\', \'CANCELADO\', \'N#A\'] as const).map(st => (\n              <button\n                key={st}\n                onClick={() => handleDeselectCruceBulkState(st)}\n                className=\"px-3 py-2 bg-slate-950 border border-slate-850 hover:bg-slate-900 text-[10px] font-black rounded-lg text-slate-300 uppercase transition-all flex items-center gap-1.5 tracking-wider hover:border-slate-700 cursor-pointer\"\n              >\n                <div className={`w-2 h-2 rounded-full ${st === \'ACTIVO\' || st === \'CANCELADO\' ? \'bg-emerald-400\' : \'bg-amber-400\'}`} />\n                <span>{st}</span>\n              </button>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* COMPARACI\303\223N Y AN\303\201LISIS DE EFECTIVIDAD */}\n      <div className=\"bg-slate-900/50 p-6 rounded-xl border border-slate-800\">\n        <h4 className=\"font-bold text-sm tracking-widest text-slate-300 uppercase mb-4 flex items-center gap-2\">\n          <ArrowRightLeft className=\"text-blue-500 w-4 h-4\" />\n          Resultado del Cruce y confrontaci\303\263n dual\n        </h4>\n\n        {emailSerialsArray.length === 0 || fisicoSerialsArray.length === 0 ? (\n          <div className=\"text-center text-xs text-slate-500 py-8 font-mono\">\n            Esperando datos en ambos listados para calcular efectividad...\n          </div>\n        ) : (\n          <div className=\"space-y-4\">\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 text-center\">\n              <div className=\"bg-emerald-950/40 p-4 border border-emerald-500/20 rounded-xl space-y-1\">\n                <div className=\"text-3xl font-black text-emerald-400 select-all font-mono\">{coincidencias.length}</div>\n                <div className=\"text-[10px] text-slate-400 font-bold uppercase tracking-widest\">Coincidencias (Intersecci\303\263n)</div>\n              </div>\n              <div className=\"bg-red-950/40 p-4 border border-red-500/10 rounded-xl space-y-1\">\n                <div className=\"text-3xl font-black text-red-400 select-all font-mono\">{soloCorreo.length}</div>\n                <div className=\"text-[10px] text-slate-400 font-bold uppercase tracking-widest\">Solo en listado de Correo</div>\n              </div>\n              <div className=\"bg-amber-950/40 p-4 border border-amber-500/15 rounded-xl space-y-1\">\n                <div className=\"text-3xl font-black text-amber-400 select-all font-mono\">{soloFisico.length}</div>\n                <div className=\"text-[10px] text-slate-400 font-bold uppercase tracking-widest\">Solo en Lectura F\303\255sica</div>\n              </div>\n            </div>\n\n            <div className=\"text-center text-xs text-slate-300 font-bold bg-slate-950 p-3 rounded-lg border border-slate-850\">\n              Efectividad de entrega f\303\255sica vs. correo: \n              <span className={`text-sm font-black ml-2 font-mono ${parseFloat(matchRatio) >= 80 ? \'text-emerald-400\' : parseFloat(matchRatio) >= 50 ? \'text-amber-400\' : \'text-red-400\'}`}>\n                {matchRatio}%\n              </span>\n              <span className=\"text-[10px] font-normal text-slate-500 ml-1.5\">\n                ({coincidencias.length} de {emailSerialsArray.length} seriales digitales validados)\n              </span>\n            </div>\n          </div>\n        )}\n\n        <div className=\"flex flex-wrap gap-2.5 justify-center mt-5 border-t border-slate-850 pt-5\">\n          <button\n            onClick={() => handleExportCruceReport()}\n            className=\"px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-xs font-bold uppercase tracking-wider transition-all flex items-center gap-1.5 cursor-pointer shadow-lg hover:shadow-blue-500/10\"\n          >\n            <Import size={12} />\n            <span>Exportar Reporte Cruzado</span>\n          </button>\n\n          <button\n            onClick={() => handleDeselectCruceBulkState(null)}\n            className=\"px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-bold uppercase tracking-wider transition-all flex items-center gap-1.5 cursor-pointer shadow-lg hover:shadow-emerald-500/10\"\n          >\n            <Send size={12} />\n            <span>A\303\261adir Seleccionados a Gesti\303\263n</span>\n          </button>\n\n          <button\n            onClick={limpiarTodo}\n            className=\"px-4 py-2 bg-slate-950 hover:bg-slate-900 border border-slate-800 rounded-lg text-xs font-bold text-slate-400 hover:text-slate-200 uppercase tracking-wider transition-all cursor-pointer\"\n          >\n            Limpiar todo\n          </button>\n        </div>\n      </div>\n\n      {/* MODAL IMPORTE MANUAL */}\n      {isManualModalOpen && (\n        <div \n          className=\"fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 animate-fade-in\"\n          onClick={() => setIsManualModalOpen(false)}\n        >\n          <div \n            className=\"bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-lg p-6 flex flex-col gap-4 shadow-2xl\"\n            onClick={(e) => e.stopPropagation()}\n          >\n            <div className=\"flex justify-between items-center border-b border-slate-800 pb-3\">\n              <div>\n                <h3 className=\"font-bold text-base text-blue-400 flex items-center gap-2\">\n                  <Grid className=\"text-purple-500 w-5 h-5\" />\n                  IMPORTE MANUAL MULTIL\303\215NEA\n                </h3>\n                <p className=\"text-[11px] text-slate-400 mt-1\">Inserta directamente seriales y correspondencias r\303\241pido.</p>\n              </div>\n              <button \n                onClick={() => setIsManualModalOpen(false)} \n                className=\"text-slate-550 text-slate-400 hover:text-white font-bold\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <div className=\"flex flex-col gap-1\">\n              <label className=\"text-[10px] text-slate-400 font-bold uppercase tracking-wider\">Seriales (uno por l\303\255nea o separados por comas)</label>\n              <textarea\n                value={manualSerials}\n                onChange={e => setManualSerials(e.target.value)}\n                placeholder=\"Pega seriales...\"\n                rows={5}\n                className=\"w-full text-xs font-mono p-2.5 bg-slate-950 border border-slate-850 rounded-lg text-slate-200 uppercase\"\n              />\n            </div>\n\n            <div className=\"flex flex-col gap-1\">\n              <label className=\"text-[10px] text-slate-400 font-bold uppercase tracking-wider\">Estados Opcionales (uno por l\303\255nea, mismo orden)</label>\n              <textarea\n                value={manualStatus}\n                onChange={e => setManualStatus(e.target.value)}\n                placeholder=\"PENDIENTE, ACTIVO, CANCELADO...\"\n                rows={3}\n                className=\"w-full text-xs font-mono p-2.5 bg-slate-950 border border-slate-850 rounded-lg text-slate-200 uppercase\"\n              />\n              <p className=\"text-[9px] text-slate-500 italic mt-0.5\">En blanco asignar\303\241 &quot;SIN ESTATUS&quot; o heredar\303\241 del Validador.</p>\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-3\">\n              <div className=\"flex flex-col gap-1\">\n                <label className=\"text-[10px] text-slate-400 font-bold uppercase\">Cliente / Remitente</label>\n                <input \n                  type=\"text\"\n                  value={manualRemitente}\n                  onChange={e => setManualRemitente(e.target.value)}\n                  className=\"text-xs p-2 bg-slate-950 border border-slate-850 rounded-lg text-slate-200 uppercase font-semibold\"\n                />\n              </div>\n              <div className=\"flex flex-col gap-1\">\n                <label className=\"text-[10px] text-slate-400 font-bold uppercase\">Fecha Entrada</label>\n                <input \n                  type=\"date\"\n                  value={manualFecha}\n                  onChange={e => setManualFecha(e.target.value)}\n                  className=\"text-xs p-2 bg-slate-950 border border-slate-850 rounded-lg text-slate-200\"\n                />\n              </div>\n            </div>\n\n            <div className=\"bg-slate-950/60 p-3 rounded-xl border border-slate-850\">\n              <label className=\"text-[10px] text-slate-400 font-bold uppercase tracking-widest block mb-2 text-center text-purple-400\">\302\277Hacia d\303\263nde importar?</label>\n              <div className=\"grid grid-cols-3 gap-2\">\n                <button\n                  onClick={() => executeManualModalImport(\'email\')}\n                  className=\"py-2 px-1 text-[10px] font-bold bg-blue-600/20 hover:bg-blue-600/30 text-blue-300 border border-blue-500/20 rounded-lg uppercase cursor-pointer\"\n                >\n                  Burbujas Correo\n                </button>\n                <button\n                  onClick={() => executeManualModalImport(\'fisico\')}\n                  className=\"py-2 px-1 text-[10px] font-bold bg-orange-600/20 hover:bg-orange-600/30 text-orange-300 border border-orange-500/20 rounded-lg uppercase cursor-pointer\"\n                >\n                  Burbujas F\303\255sico\n                </button>\n                <button\n                  onClick={() => executeManualModalImport(\'gestion\')}\n                  className=\"py-2 px-1 text-[10px] font-black bg-emerald-600 text-white rounded-lg uppercase hover:bg-emerald-500 cursor-pointer\"\n                >\n                  Gesti\303\263n General\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n    </div>\n  );\n};\n"
    }
