      replacement_content: "  const [serials, setSerials] = useState<POSItem[]>(() => {\n    const raw = localStorage.getItem(\'serialesDB\');\n    let loaded: POSItem[] = [];\n    if (raw) {\n      try {\n        loaded = JSON.parse(raw);\n        if (!Array.isArray(loaded)) loaded = INITIAL_SERIALS;\n      } catch (e) {\n        loaded = INITIAL_SERIALS;\n      }\n    } else {\n      loaded = INITIAL_SERIALS;\n    }\n\n    // Self-healing: Deduplicate any existing elements that might have identical or corrupted IDs\n    const seenIds = new Set<number>();\n    let revised = false;\n    \n    // Find a safe start for new unique IDs so we don\'t collide with existing high valid IDs\n    const currentMax = loaded.reduce((max, item) => \n      (item && item.id && typeof item.id === \'number\' && !isNaN(item.id)) ? Math.max(max, item.id) : max, \n      0\n    );\n    let nextUniqueId = currentMax + 1;\n\n    const sanitized = loaded.map((item) => {\n      if (!item || !item.id || typeof item.id !== \'number\' || isNaN(item.id) || seenIds.has(item.id)) {\n        revised = true;\n        const assignedId = nextUniqueId++;\n        seenIds.add(assignedId);\n        return { ...item, id: assignedId };\n      }\n      seenIds.add(item.id);\n      return item;\n    });\n\n    if (revised) {\n      localStorage.setItem(\'serialesDB\', JSON.stringify(sanitized));\n    }\n    return sanitized;\n  });"
