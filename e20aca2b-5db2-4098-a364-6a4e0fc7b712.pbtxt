    replacement_chunks {
      target_content: "      {/* GLOBAL HEADER BAR */}\n      <header className=\"bg-slate-900/60 border-b border-slate-900/85 backdrop-blur-md sticky top-0 z-40 p-4 md:px-8\">\n        <div className=\"max-w-7xl mx-auto flex flex-col lg:flex-row justify-between items-center gap-5\">\n          \n          <div className=\"flex items-center gap-4 cursor-pointer\">\n            <div className=\"w-12 h-12 rounded-xl bg-blue-600/10 border border-blue-500/20 flex items-center justify-center shadow-lg shadow-blue-500/5 hover:border-blue-500/40 hover:bg-blue-600/20 transition-all select-none\">\n              <Network className=\"text-blue-500 select-all w-6 h-6 animate-pulse\" />\n            </div>\n            <div>\n              <h1 className=\"text-xl md:text-2xl font-black tracking-wider text-slate-50 flex items-center gap-2\">\n                DISGLOBAL TRACKING\n                <span className=\"text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 border border-blue-500/20 tracking-widest font-black\">SPV V4.0</span>\n              </h1>\n              <p className=\"text-xs text-slate-500 font-mono tracking-wide mt-0.5\">REGISTROS \342\200\242 FECHAS \342\200\242 RIF \342\200\242 SERIALES</p>\n            </div>\n          </div>\n\n          <div className=\"flex flex-wrap gap-2 justify-center items-center\">\n            <button \n              onClick={handleImportCSVData}\n              className=\"px-3.5 py-2 text-xs font-bold uppercase tracking-wider bg-emerald-700/15 hover:bg-emerald-700/25 text-emerald-400 border border-emerald-500/20 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer\"\n            >\n              <FileSpreadsheet size={13} />\n              <span>Importar Datos</span>\n            </button>\n\n            <button \n              onClick={handleExportCSV}\n              className=\"px-3.5 py-2 text-xs font-bold uppercase tracking-wider bg-blue-600/15 hover:bg-blue-600/25 text-blue-400 border border-blue-500/20 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer\"\n            >\n              <Download size={13} />\n              <span>Exportar CSV</span>\n            </button>\n\n            <button \n              onClick={handleExportJSON}\n              className=\"px-3.5 py-2 text-xs font-bold uppercase tracking-wider bg-purple-600/15 hover:bg-purple-600/25 text-purple-400 border border-purple-500/20 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer\"\n            >\n              <Terminal size={13} />\n              <span>Exportar JSON</span>\n            </button>\n\n            <button \n              onClick={handleDeleteSelected}\n              className=\"px-3.5 py-2 text-xs font-bold uppercase tracking-wider bg-red-950/20 hover:bg-red-950/40 text-red-400 border border-red-950 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer\"\n            >\n              <Trash2 size={13} />\n              <span>Eliminar</span>\n            </button>\n\n            <button \n              onClick={handleExportFullCSVBackup}\n              className=\"px-3.5 py-2 text-xs font-bold uppercase tracking-wider bg-slate-900 hover:bg-slate-850 hover:text-white border border-slate-800 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer\"\n            >\n              <Database size={13} />\n              <span>BD Completa</span>\n            </button>\n\n            <button \n              onClick={handleClearDatabase}\n              className=\"px-3.5 py-2 text-xs font-black uppercase tracking-wider bg-red-600 hover:bg-red-500 text-white rounded-lg flex items-center gap-1.5 transition-all cursor-pointer shadow-lg shadow-red-500/5 hover:shadow-red-500/20\"\n            >\n              <ShieldAlert size={13} />\n              <span>Borrar Todo</span>\n            </button>\n          </div>\n\n        </div>\n      </header>"
      replacement_content: "      {/* GLOBAL HEADER BAR */}\n      <header className=\"bg-slate-900/40 border-b border-slate-900/60 backdrop-blur-md sticky top-0 z-40 py-5 px-6 md:px-12 lg:px-16\">\n        <div className=\"max-w-[85rem] mx-auto flex flex-col lg:flex-row justify-between items-center gap-6 lg:gap-8\">\n          \n          <div className=\"flex items-center gap-4 cursor-pointer\">\n            <div className=\"w-11 h-11 rounded-xl bg-blue-600/5 border border-blue-500/15 flex items-center justify-center shadow-sm hover:border-blue-500/30 hover:bg-blue-600/10 transition-all select-none\">\n              <Network className=\"text-blue-500 select-all w-5 h-5 animate-pulse\" />\n            </div>\n            <div>\n              <h1 className=\"text-xl md:text-[22px] font-black tracking-wider text-slate-100 flex items-center gap-2\">\n                DISGLOBAL TRACKING\n                <span className=\"text-[9px] uppercase font-mono px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 border border-blue-500/15 tracking-widest font-black\">SPV V4.0</span>\n              </h1>\n              <p className=\"text-[10px] text-slate-500 font-mono tracking-wider mt-0.5\">REGISTROS \342\200\242 FECHAS \342\200\242 RIF \342\200\242 SERIALES</p>\n            </div>\n          </div>\n\n          <div className=\"flex flex-wrap items-center justify-center lg:justify-end gap-x-5 gap-y-3.5\">\n            <button \n              onClick={handleImportCSVData}\n              className=\"px-4 py-2 text-xs font-bold uppercase tracking-wider bg-emerald-500/5 hover:bg-emerald-500/15 text-emerald-400 border border-emerald-500/20 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer shadow-sm\"\n            >\n              <FileSpreadsheet size={13} className=\"text-emerald-500/80\" />\n              <span>Importar Datos</span>\n            </button>\n\n            <button \n              onClick={handleExportCSV}\n              className=\"px-4 py-2 text-xs font-bold uppercase tracking-wider bg-blue-500/5 hover:bg-blue-500/15 text-blue-400 border border-blue-500/20 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer shadow-sm\"\n            >\n              <Download size={13} className=\"text-blue-500/80\" />\n              <span>Exportar CSV</span>\n            </button>\n\n            <button \n              onClick={handleExportJSON}\n              className=\"px-4 py-2 text-xs font-bold uppercase tracking-wider bg-slate-800/25 hover:bg-slate-800 text-slate-400 border border-slate-800 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer\"\n            >\n              <Terminal size={13} className=\"text-slate-500\" />\n              <span>Exportar JSON</span>\n            </button>\n\n            <button \n              onClick={handleDeleteSelected}\n              className=\"px-4 py-2 text-xs font-bold uppercase tracking-wider bg-red-500/5 hover:bg-red-500/15 text-red-400 border border-red-500/15 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer\"\n            >\n              <Trash2 size={13} className=\"text-red-500/80\" />\n              <span>Eliminar</span>\n            </button>\n\n            <button \n              onClick={handleExportFullCSVBackup}\n              className=\"px-4 py-2 text-xs font-bold uppercase tracking-wider bg-slate-800/25 hover:bg-slate-800 text-slate-400 border border-slate-800 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer\"\n            >\n              <Database size={13} className=\"text-slate-500\" />\n              <span>BD Completa</span>\n            </button>\n\n            <button \n              onClick={handleClearDatabase}\n              className=\"px-4 py-2 text-xs font-black uppercase tracking-wider bg-red-600/10 hover:bg-red-600/20 border border-red-500/25 text-red-400 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer shadow-sm\"\n            >\n              <ShieldAlert size={13} className=\"text-red-500\" />\n              <span>Borrar Todo</span>\n            </button>\n          </div>\n\n        </div>\n      </header>"
