        }
        lines {
          text: "    switch (status) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      case \'PENDIENTE\': "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      case \'ACTIVO\': "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      case \'SUSPENDIDO\': "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        return \'bg-orange-500 text-white border border-orange-400/30 font-bold\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      case \'CANCELADO\': "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      case \'N#A\': "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        return \'bg-emerald-600 text-white border border-emerald-500/30 font-bold\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      default: return \'bg-slate-700/30 text-slate-300 border border-slate-600/50\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
