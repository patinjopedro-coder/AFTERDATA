    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "      {/* ESTAD\303\215STICAS COMPLEMENTARIAS ANUALES */}\n      <div className=\"bg-slate-900/60 p-5 rounded-xl border border-slate-800 flex flex-col gap-4\">\n        <h4 className=\"font-bold text-xs tracking-widest uppercase text-slate-455\">Totalizaci\303\263n de Balance Anual</h4>\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n          <div className=\"bg-slate-950 p-3.5 rounded-xl border border-slate-850 flex items-center justify-between\">\n            <div className=\"flex flex-col\">\n              <span className=\"text-[10px] text-slate-500 font-black tracking-wider uppercase\">Ingresos Anuales</span>\n              <span className=\"text-2xl font-black font-sans text-slate-200 mt-1\">{contarPeriodo(\'anual\', \'total\')}</span>\n            </div>\n            <button \n              onClick={() => handleExportPeriod(\'anual\', \'total\')}\n              className=\"px-3.5 py-1.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-[10.5px] border border-blue-500/10 rounded-lg cursor-pointer transition-colors shadow-sm\"\n            >\n              DESCARGAR EXCEL\n            </button>\n          </div>\n\n          <div className=\"bg-slate-950 p-3.5 rounded-xl border border-slate-850 flex items-center justify-between\">\n            <div className=\"flex flex-col\">\n              <span className=\"text-[10px] text-slate-500 font-black tracking-wider uppercase\">Entregados Anual</span>\n              <span className=\"text-2xl font-black font-sans text-orange-500 mt-1\">{contarPeriodo(\'anual\', \'entregados\')}</span>\n            </div>\n            <button \n              onClick={() => handleExportPeriod(\'anual\', \'entregados\')}\n              className=\"px-3.5 py-1.5 bg-orange-500 hover:bg-orange-600 text-white font-bold text-[10.5px] border border-orange-400/10 rounded-lg cursor-pointer transition-colors shadow-sm\"\n            >\n              DESCARGAR EXCEL\n            </button>\n          </div>\n\n          <div className=\"bg-slate-955 p-3.5 rounded-xl border border-slate-850 flex items-center justify-between\">\n            <div className=\"flex flex-col\">\n              <span className=\"text-[10px] text-slate-500 font-black tracking-wider uppercase\">Disponibles Anual</span>\n              <span className=\"text-2xl font-black font-sans text-emerald-400 mt-1\">{contarPeriodo(\'anual\', \'disponibles\')}</span>\n            </div>\n            <button \n              onClick={() => handleExportPeriod(\'anual\', \'disponibles\')}\n              className=\"px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-[10.5px] border border-emerald-550/10 rounded-lg cursor-pointer transition-colors shadow-sm\"\n            >\n              DESCARGAR EXCEL\n            </button>\n          </div>\n        </div>\n      </div>"
      replacement_content: "      {/* ESTAD\303\215STICAS COMPLEMENTARIAS ANUALES: ANALIZADOR DE STOCK CR\303\215TICO POR MODELOS Y CONTROL DE ROTACI\303\223N */}\n      <div className=\"bg-slate-900/60 p-5 rounded-xl border border-slate-800 flex flex-col gap-5 shadow-lg\">\n        <div className=\"flex flex-col md:flex-row justify-between items-start md:items-center gap-3 border-b border-slate-800 pb-3\">\n          <div>\n            <h4 className=\"font-bold text-xs tracking-widest uppercase text-slate-300 flex items-center gap-2\">\n              <span className=\"w-2 h-2 rounded-full bg-blue-500 animate-pulse\"></span>\n              ANALIZADOR DE STOCK CR\303\215TICO & CONTROL DE ROTACI\303\223N\n            </h4>\n            <p className=\"text-[10px] text-slate-500 mt-1 uppercase font-mono\">Monitoreo autom\303\241tico de disponibilidad por modelo de terminal</p>\n          </div>\n          \n          {/* BOTONES DE EXPORTACI\303\223N ANUAL COMPACTOS */}\n          <div className=\"flex flex-wrap gap-2\">\n            <button \n              onClick={() => handleExportPeriod(\'anual\', \'total\')}\n              className=\"px-2.5 py-1 bg-blue-600/10 hover:bg-blue-600 text-blue-400 hover:text-white font-bold text-[9.5px] border border-blue-500/15 rounded-md cursor-pointer transition-all uppercase tracking-wider shadow-sm\"\n              title=\"Descargar todos los ingresos anuales en Excel\"\n            >\n              EXCEL INGRESOS ANUALES\n            </button>\n            <button \n              onClick={() => handleExportPeriod(\'anual\', \'entregados\')}\n              className=\"px-2.5 py-1 bg-orange-500/10 hover:bg-orange-600 text-orange-400 hover:text-white font-bold text-[9.5px] border border-orange-500/15 rounded-md cursor-pointer transition-all uppercase tracking-wider shadow-sm\"\n              title=\"Descargar entregas anuales en Excel\"\n            >\n              EXCEL ENTREGADOS ANUAL\n            </button>\n            <button \n              onClick={() => handleExportPeriod(\'anual\', \'disponibles\')}\n              className=\"px-2.5 py-1 bg-emerald-600/10 hover:bg-emerald-600 text-emerald-400 hover:text-white font-bold text-[9.5px] border border-emerald-500/15 rounded-md cursor-pointer transition-all uppercase tracking-wider shadow-sm\"\n              title=\"Descargar stock disponible anual en Excel\"\n            >\n              EXCEL DISPONIBLES ANUAL\n            </button>\n          </div>\n        </div>\n\n        {/* METRICAS DINAMICAS CALCULADAS */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-5\">\n          {/* COLUMNA 1: AUDITOR\303\215A DE INVENTARIO */}\n          <div className=\"lg:col-span-4 bg-slate-950/80 p-4 rounded-xl border border-slate-850 flex flex-col justify-between gap-4\">\n            <div>\n              <span className=\"text-[9px] text-slate-500 font-bold tracking-widest uppercase block mb-3\">Auditor\303\255a Operativa</span>\n              \n              <div className=\"space-y-3.5\">\n                <div>\n                  <div className=\"flex justify-between items-center text-[10px] font-semibold text-slate-400 uppercase\">\n                    <span>\303\215ndice de Rotaci\303\263n Activo</span>\n                    <span className=\"text-white font-sans font-bold\">\n                      {serials.length > 0 ? Math.round((serials.filter(s => [\'ACTIVO\', \'PENDIENTE\', \'SUSPENDIDO\'].includes(s.status)).length / serials.length) * 100) : 0}%\n                    </span>\n                  </div>\n                  <div className=\"w-full h-1.5 bg-slate-900 rounded-full mt-1.5 overflow-hidden\">\n                    <div \n                      className=\"h-full bg-gradient-to-r from-blue-500 to-indigo-500 rounded-full\"\n                      style={{ width: `${serials.length > 0 ? (serials.filter(s => [\'ACTIVO\', \'PENDIENTE\', \'SUSPENDIDO\'].includes(s.status)).length / serials.length) * 100 : 0}%` }}\n                    ></div>\n                  </div>\n                </div>\n\n                <div>\n                  <div className=\"flex justify-between items-center text-[10px] font-semibold text-slate-400 uppercase\">\n                    <span>Reserva en Casillero</span>\n                    <span className=\"text-white font-sans font-bold\">\n                      {serials.length > 0 ? Math.round((serials.filter(s => s.isCasillero).length / serials.length) * 100) : 0}%\n                    </span>\n                  </div>\n                  <div className=\"w-full h-1.5 bg-slate-900 rounded-full mt-1.5 overflow-hidden\">\n                    <div \n                      className=\"h-full bg-gradient-to-r from-teal-500 to-emerald-500 rounded-full\"\n                      style={{ width: `${serials.length > 0 ? (serials.filter(s => s.isCasillero).length / serials.length) * 100 : 0}%` }}\n                    ></div>\n                  </div>\n                </div>\n\n                <div>\n                  <div className=\"flex justify-between items-center text-[10px] font-semibold text-slate-400 uppercase\">\n                    <span>Tasa de Recuperaci\303\263n</span>\n                    <span className=\"text-white font-sans font-bold\">\n                      {serials.length > 0 ? Math.round((serials.filter(s => [\'CANCELADO\', \'N#A\', \'RECUPERADO\'].includes(s.status)).length / serials.length) * 100) : 0}%\n                    </span>\n                  </div>\n                  <div className=\"w-full h-1.5 bg-slate-900 rounded-full mt-1.5 overflow-hidden\">\n                    <div \n                      className=\"h-full bg-gradient-to-r from-amber-500 to-orange-500 rounded-full\"\n                      style={{ width: `${serials.length > 0 ? (serials.filter(s => [\'CANCELADO\', \'N#A\', \'RECUPERADO\'].includes(s.status)).length / serials.length) * 100 : 0}%` }}\n                    ></div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"text-[9px] text-slate-500 border-t border-slate-900 pt-3 text-center uppercase font-mono\">\n              Calculado en tiempo real en base a registros f\303\255sicos y de correo\n            </div>\n          </div>\n\n          {/* COLUMNA 2: DETECTIVE DE MODELOS CR\303\215TICOS Y DISPONIBILIDAD */}\n          <div className=\"lg:col-span-8 bg-slate-950/40 p-4 rounded-xl border border-slate-850 flex flex-col justify-between\">\n            <div>\n              <span className=\"text-[9px] text-slate-500 font-bold tracking-widest uppercase block mb-3\">Estado de Abastecimiento por Modelo</span>\n              \n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-2 max-h-[170px] overflow-y-auto pr-1\">\n                {Object.keys(modelosDB).map(key => {\n                  const config = modelosDB[key];\n                  const modelSerials = serials.filter(s => getTerminalModel(s.serial) === key);\n                  const disponibles = modelSerials.filter(s => [\'CANCELADO\', \'N#A\', \'RECUPERADO\'].includes(s.status || \'\') || s.status === \'SIN ESTATUS\').length;\n                  const entregados = modelSerials.filter(s => [\'ACTIVO\', \'PENDIENTE\', \'SUSPENDIDO\'].includes(s.status || \'\')).length;\n                  const total = modelSerials.length;\n\n                  if (total === 0) return null;\n\n                  const isCritico = disponibles <= 1;\n\n                  return (\n                    <div key={key} className=\"bg-slate-950 p-2.5 rounded-lg border border-slate-900 flex items-center justify-between gap-3 shadow-sm hover:border-slate-800 transition-colors\">\n                      <div className=\"flex flex-col min-w-0\">\n                        <span className=\"text-[11px] font-black text-slate-200 truncate uppercase\">{config.modelo}</span>\n                        <span className=\"text-[8.5px] text-slate-500 mt-0.5 uppercase font-sans\">Totales: {total} \342\200\242 Entregados: {entregados}</span>\n                      </div>\n\n                      <div className=\"flex items-center gap-2 flex-shrink-0\">\n                        <div className=\"text-right\">\n                          <span className=\"text-xs text-slate-300 block font-bold leading-none\">{disponibles} Disp</span>\n                          <span className={`text-[7.5px] uppercase font-black px-1.5 py-0.5 mt-1 inline-block rounded-md ${\n                            isCritico \n                              ? \'bg-red-500/10 text-red-400 border border-red-500/20\' \n                              : \'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\'\n                          }`}>\n                            {isCritico ? \'CR\303\215TICO\' : \'SALUDABLE\'}\n                          </span>\n                        </div>\n                      </div>\n                    </div>\n                  );\n                }).filter(Boolean)}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>"
    }
