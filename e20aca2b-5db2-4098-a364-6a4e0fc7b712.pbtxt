      replacement_content: "import React, { useState } from \'react\';\nimport { POSItem, ModelConfig } from \'../types\';\nimport { getTerminalModel } from \'../data\';\nimport { \n  BarChart3, Calendar, FileDown, Search, \n  HelpCircle, ChevronLeft, ChevronRight, PieChart, Users, Compass \n} from \'lucide-react\';\n\ninterface EstadisticasProps {\n  serials: POSItem[];\n  modelosDB: Record<string, ModelConfig>;\n}\n\nexport const Estadisticas: React.FC<EstadisticasProps> = ({\n  serials,\n  modelosDB\n}) => {\n  const [modalType, setModalType] = useState<\'total\' | \'disponibles\' | \'entregados\' | null>(null);\n  const [modalSearch, setModalSearch] = useState(\'\');\n  const [currentPage, setCurrentPage] = useState(1);\n  const itemsPerPage = 20;\n\n  const getSemanaRange = () => {\n    const hoy = new Date();\n    const diaSemana = hoy.getDay();\n    const lunes = new Date(hoy);\n    lunes.setDate(hoy.getDate() - (diaSemana === 0 ? 6 : diaSemana - 1));\n    const viernes = new Date(lunes);\n    viernes.setDate(lunes.getDate() + 4);\n    return { inicio: lunes.toISOString().slice(0, 10), fin: viernes.toISOString().slice(0, 10) };\n  };\n\n  const getQuincenaRange = () => {\n    const hoy = new Date();\n    const a\303\261o = hoy.getFullYear();\n    const mes = hoy.getMonth();\n    const dia = hoy.getDate();\n    const inicio = new Date(a\303\261o, mes, 1).toISOString().slice(0, 10);\n    let fin;\n    if (dia <= 15) {\n      fin = new Date(a\303\261o, mes, 15).toISOString().slice(0, 10);\n    } else {\n      const inicioQ2 = new Date(a\303\261o, mes, 16).toISOString().slice(0, 10);\n      const finQ2 = new Date(a\303\261o, mes + 1, 0).toISOString().slice(0, 10);\n      return { inicio: inicioQ2, fin: finQ2 };\n    }\n    return { inicio, fin };\n  };\n\n  const getMesRange = () => {\n    const hoy = new Date();\n    const inicio = new Date(hoy.getFullYear(), hoy.getMonth(), 1).toISOString().slice(0, 10);\n    const fin = new Date(hoy.getFullYear(), hoy.getMonth() + 1, 0).toISOString().slice(0, 10);\n    return { inicio, fin };\n  };\n\n  const getTrimestreRange = () => {\n    const hoy = new Date();\n    const trimestre = Math.floor(hoy.getMonth() / 3);\n    const inicio = new Date(hoy.getFullYear(), trimestre * 3, 1).toISOString().slice(0, 10);\n    const fin = new Date(hoy.getFullYear(), trimestre * 3 + 3, 1).toISOString().slice(0, 10);\n    return { inicio, fin };\n  };\n\n  const getAnualRange = () => {\n    const hoy = new Date();\n    const a\303\261o = hoy.getFullYear();\n    const inicio = new Date(a\303\261o, 0, 1).toISOString().slice(0, 10);\n    const fin = new Date(a\303\261o, 11, 31).toISOString().slice(0, 10);\n    return { inicio, fin };\n  };\n\n  const currentTodayStr = () => {\n    const d = new Date();\n    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, \'0\')}-${String(d.getDate()).padStart(2, \'0\')}`;\n  };\n\n  const contarPeriodo = (period: \'hoy\' | \'semana\' | \'quincena\' | \'mes\' | \'trimestre\' | \'anual\', statusGroup: \'entregados\' | \'disponibles\' | \'total\') => {\n    const hoyStr = currentTodayStr();\n    let range = { inicio: hoyStr, fin: hoyStr };\n\n    switch (period) {\n      case \'hoy\': range = { inicio: hoyStr, fin: hoyStr }; break;\n      case \'semana\': range = getSemanaRange(); break;\n      case \'quincena\': range = getQuincenaRange(); break;\n      case \'mes\': range = getMesRange(); break;\n      case \'trimestre\': range = getTrimestreRange(); break;\n      case \'anual\': range = getAnualRange(); break;\n    }\n\n    return serials.filter(s => {\n      if (s.date < range.inicio || s.date > range.fin) return false;\n      if (statusGroup === \'entregados\') return [\'PENDIENTE\', \'ACTIVO\', \'SUSPENDIDO\'].includes(s.status);\n      if (statusGroup === \'disponibles\') return [\'CANCELADO\', \'N#A\'].includes(s.status);\n      return true;\n    }).length;\n  };\n\n  const downloadCSV = (csvStr: string, name: string) => {\n    const blob = new Blob([\"\\uFEFF\" + csvStr], { type: \"text/csv;charset=utf-8;\" });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\'a\');\n    link.href = url;\n    link.download = name;\n    link.click();\n    URL.revokeObjectURL(url);\n  };\n\n  const handleExportPeriod = (period: \'hoy\' | \'semana\' | \'quincena\' | \'mes\' | \'trimestre\' | \'anual\', statusGroup: \'entregados\' | \'disponibles\' | \'total\') => {\n    const hoyStr = currentTodayStr();\n    let range = { inicio: hoyStr, fin: hoyStr };\n\n    switch (period) {\n      case \'hoy\': range = { inicio: hoyStr, fin: hoyStr }; break;\n      case \'semana\': range = getSemanaRange(); break;\n      case \'quincena\': range = getQuincenaRange(); break;\n      case \'mes\': range = getMesRange(); break;\n      case \'trimestre\': range = getTrimestreRange(); break;\n      case \'anual\': range = getAnualRange(); break;\n    }\n\n    const items = serials.filter(s => {\n      if (s.date < range.inicio || s.date > range.fin) return false;\n      if (statusGroup === \'entregados\') return [\'PENDIENTE\', \'ACTIVO\', \'SUSPENDIDO\'].includes(s.status);\n      if (statusGroup === \'disponibles\') return [\'CANCELADO\', \'N#A\'].includes(s.status);\n      return true;\n    });\n\n    if (items.length === 0) {\n      alert(\'Sin datos en este rango.\');\n      return;\n    }\n\n    let csv = \"SERIAL,MODELO,SO,ESTADO,REMITENTE,RIF,RAZON_SOCIAL,TICKET,FECHA\\n\";\n    items.forEach(s => {\n      const m = getTerminalModel(s.serial, modelosDB);\n      csv += `\"${s.serial}\",\"${m.modelo}\",\"${m.so}\",\"${s.status}\",\"${s.remitente}\",\"${s.rif || \'\'}\",\"${s.razonSocial || \'\'}\",\"${s.ticket || \'\'}\",\"${s.date}\"\\n`;\n    });\n\n    downloadCSV(csv, `informe_${statusGroup}_${period}_${hoyStr}.csv`);\n    alert(`Exportado ${items.length} registros correspondientes al per\303\255odo.`);\n  };\n\n  // Master Stat Counters\n  const totalCount = serials.length;\n  const disponiblesCount = serials.filter(s => [\'CANCELADO\', \'N#A\'].includes(s.status)).length;\n  const entregadosCount = serials.filter(s => [\'PENDIENTE\', \'ACTIVO\', \'SUSPENDIDO\'].includes(s.status)).length;\n\n  // Modal dataset filter\n  const getModalItems = () => {\n    let list = serials;\n    if (modalType === \'disponibles\') {\n      list = serials.filter(s => [\'CANCELADO\', \'N#A\'].includes(s.status));\n    } else if (modalType === \'entregados\') {\n      list = serials.filter(s => [\'PENDIENTE\', \'ACTIVO\', \'SUSPENDIDO\'].includes(s.status));\n    }\n\n    if (modalSearch) {\n      const lowS = modalSearch.toLowerCase();\n      list = list.filter(o => \n        o.serial.toLowerCase().includes(lowS) || \n        o.remitente.toLowerCase().includes(lowS) ||\n        (o.rif && o.rif.toLowerCase().includes(lowS)) ||\n        (o.razonSocial && o.razonSocial.toLowerCase().includes(lowS))\n      );\n    }\n    return list;\n  };\n\n  const modalList = getModalItems();\n\n  // Unified General list at the bottom\n  const sortedAll = [...serials].sort((a,b) => new Date(b.date).getTime() - new Date(a.date).getTime());\n  const totalPages = Math.ceil(sortedAll.length / itemsPerPage) || 1;\n  const paginatedAll = sortedAll.slice((currentPage - 1) * itemsPerPage, currentPage * itemsPerPage);\n\n  const getStatusStyle = (status: string) => {\n    if ([\'CANCELADO\', \'N#A\'].includes(status)) {\n      return \'bg-emerald-950 text-emerald-400 border border-emerald-500/20\';\n    }\n    return \'bg-amber-950 text-amber-400 border border-amber-500/20\';\n  };\n\n  return (\n    <div className=\"flex flex-col gap-6 animate-fade-in text-slate-100 pb-16\">\n      \n      {/* SECCI\303\223N 1: CONTADORES T\303\211CNICOS INTEGRALES DE LA RED DE POS */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-5\">\n        \n        <div \n          onClick={() => { setModalType(\'total\'); setModalSearch(\'\'); }}\n          className=\"bg-slate-900/60 p-6 rounded-2xl border border-slate-800 hover:border-slate-700 hover:bg-slate-900/80 transition-all cursor-pointer shadow-lg group relative overflow-hidden\"\n        >\n          <div className=\"text-xs uppercase tracking-[0.2em] text-slate-400 font-bold\">Total Equipos Registrados</div>\n          <div className=\"mt-3 text-4xl font-black text-slate-100 font-mono tracking-wider group-hover:text-blue-400 transition-colors\">\n            {totalCount}\n          </div>\n          <div className=\"mt-2 text-[10px] text-slate-500 uppercase tracking-widest font-semibold\">Garant\303\255a, Comodatos e Inventario General</div>\n          <ChevronRight size={16} className=\"absolute right-4 bottom-4 text-slate-600 group-hover:text-blue-500 group-hover:translate-x-1 transition-all\" />\n        </div>\n\n        <div \n          onClick={() => { setModalType(\'disponibles\'); setModalSearch(\'\'); }}\n          className=\"bg-slate-900/60 p-6 rounded-2xl border border-slate-800 hover:border-slate-700 hover:bg-slate-900/80 transition-all cursor-pointer shadow-lg group relative overflow-hidden\"\n        >\n          <div className=\"text-xs uppercase tracking-[0.2em] text-slate-400 font-bold\">Total Disponibles (Bajas o Cancelados)</div>\n          <div className=\"mt-3 text-4xl font-black text-emerald-400 font-mono tracking-wider group-hover:scale-[1.01] transition-transform\">\n            {disponiblesCount}\n          </div>\n          <div className=\"mt-2 text-[10px] text-emerald-500 uppercase tracking-widest font-semibold flex items-center gap-1\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse\"></span>\n            Listo para ser Reasignados (N#A / Cancelados)\n          </div>\n          <ChevronRight size={16} className=\"absolute right-4 bottom-4 text-slate-600 group-hover:text-emerald-400 group-hover:translate-x-1 transition-all\" />\n        </div>\n\n        <div \n          onClick={() => { setModalType(\'entregados\'); setModalSearch(\'\'); }}\n          className=\"bg-slate-900/60 p-6 rounded-2xl border border-slate-800 hover:border-slate-700 hover:bg-slate-900/80 transition-all cursor-pointer shadow-lg group relative overflow-hidden\"\n        >\n          <div className=\"text-xs uppercase tracking-[0.2em] text-slate-400 font-bold\">Total Entregados a Clientes</div>\n          <div className=\"mt-3 text-4xl font-black text-amber-500 font-mono tracking-wider\">\n            {entregadosCount}\n          </div>\n          <div className=\"mt-2 text-[10px] text-amber-500 uppercase tracking-widest font-semibold\">\n            Activos en Red de Establecimientos (Act / Pend)\n          </div>\n          <ChevronRight size={16} className=\"absolute right-4 bottom-4 text-slate-600 group-hover:text-amber-500 group-hover:translate-x-1 transition-all\" />\n        </div>\n\n      </div>\n\n      {/* SECCI\303\223N 2: HIST\303\223RICOS DE INGRESOS POR PER\303\215ODOS */}\n      <div className=\"grid grid-cols-1 xl:grid-cols-2 gap-6\">\n\n        {/* PANEL: INGRESOS ENTREGADOS */}\n        <div className=\"bg-slate-900/40 p-5 rounded-xl border border-slate-800 flex flex-col gap-4\">\n          <div className=\"flex items-center justify-between border-b border-slate-800/80 pb-3\">\n            <h4 className=\"font-bold text-xs tracking-widest uppercase text-slate-400 flex items-center gap-1.5\">\n              <Calendar className=\"text-amber-500 w-4 h-4\" />\n              Ingreso de Equipos Entregados (Activos/Pendientes)\n            </h4>\n          </div>\n\n          <div className=\"grid grid-cols-2 sm:grid-cols-6 gap-2\">\n            {([\'hoy\', \'semana\', \'quincena\', \'mes\', \'trimestre\', \'anual\'] as const).map(p => (\n              <div key={p} className=\"bg-slate-950 p-2.5 rounded-lg border border-slate-850 flex flex-col items-center justify-between gap-1 text-center group\">\n                <span className=\"text-[10px] text-slate-400 font-black tracking-widest uppercase\">{p}</span>\n                <span className=\"text-xl font-bold font-mono text-slate-100 group-hover:text-blue-400 transition-colors\">\n                  {contarPeriodo(p, \'entregados\')}\n                </span>\n                <button\n                  onClick={() => handleExportPeriod(p, \'entregados\')}\n                  className=\"w-full mt-2 py-1 bg-slate-900 hover:bg-slate-850 hover:text-white rounded border border-slate-800 text-[9px] font-bold text-slate-500 flex items-center justify-center gap-1 cursor-pointer\"\n                >\n                  <FileDown size={11} />\n                  EXP\n                </button>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* PANEL: INGRESOS DISPONIBLES */}\n        <div className=\"bg-slate-900/40 p-5 rounded-xl border border-slate-800 flex flex-col gap-4\">\n          <div className=\"flex items-center justify-between border-b border-slate-800/80 pb-3\">\n            <h4 className=\"font-bold text-xs tracking-widest uppercase text-slate-400 flex items-center gap-1.5\">\n              <Calendar className=\"text-emerald-500 w-4 h-4\" />\n              Ingreso de Equipos Disponibles (Bajas o Cancelados)\n            </h4>\n          </div>\n\n          <div className=\"grid grid-cols-2 sm:grid-cols-6 gap-2\">\n            {([\'hoy\', \'semana\', \'quincena\', \'mes\', \'trimestre\', \'anual\'] as const).map(p => (\n              <div key={p} className=\"bg-slate-950 p-2.5 rounded-lg border border-slate-850 flex flex-col items-center justify-between gap-1 text-center group\">\n                <span className=\"text-[10px] text-slate-400 font-black tracking-widest uppercase\">{p}</span>\n                <span className=\"text-xl font-bold font-mono text-slate-100 group-hover:text-blue-400 transition-colors\">\n                  {contarPeriodo(p, \'disponibles\')}\n                </span>\n                <button\n                  onClick={() => handleExportPeriod(p, \'disponibles\')}\n                  className=\"w-full mt-2 py-1 bg-slate-900 hover:bg-slate-850 hover:text-white rounded border border-slate-800 text-[9px] font-bold text-slate-500 flex items-center justify-center gap-1 cursor-pointer\"\n                >\n                  <FileDown size={11} />\n                  EXP\n                </button>\n              </div>\n            ))}\n          </div>\n        </div>\n\n      </div>\n\n      {/* ESTAD\303\215STICAS COMPLEMENTARIAS ANUALES */}\n      <div className=\"bg-slate-900/60 p-5 rounded-xl border border-slate-800 flex flex-col gap-4\">\n        <h4 className=\"font-bold text-xs tracking-widest uppercase text-slate-400\">Totalizaci\303\263n de Balance Anual</h4>\n        <div className=\"grid grid-cols-3 gap-4\">\n          <div className=\"bg-slate-950 p-3.5 rounded-xl border border-slate-850 flex items-center justify-between\">\n            <div className=\"flex flex-col\">\n              <span className=\"text-[10px] text-slate-500 font-black tracking-wider uppercase\">Ingresos Anuales</span>\n              <span className=\"text-2xl font-black font-mono text-slate-200 mt-1\">{contarPeriodo(\'anual\', \'total\')}</span>\n            </div>\n            <button \n              onClick={() => handleExportPeriod(\'anual\', \'total\')}\n              className=\"px-3 py-1.5 bg-blue-600/10 hover:bg-blue-600/20 text-blue-400 font-bold text-[10px] border border-blue-500/15 rounded-lg cursor-pointer\"\n            >\n              DESCARGAR EXCEL\n            </button>\n          </div>\n\n          <div className=\"bg-slate-950 p-3.5 rounded-xl border border-slate-850 flex items-center justify-between\">\n            <div className=\"flex flex-col\">\n              <span className=\"text-[10px] text-slate-500 font-black tracking-wider uppercase\">Entregados Anual</span>\n              <span className=\"text-2xl font-black font-mono text-amber-500 mt-1\">{contarPeriodo(\'anual\', \'entregados\')}</span>\n            </div>\n            <button \n              onClick={() => handleExportPeriod(\'anual\', \'entregados\')}\n              className=\"px-3 py-1.5 bg-amber-600/10 hover:bg-amber-600/20 text-amber-400 font-bold text-[10px] border border-amber-500/15 rounded-lg cursor-pointer\"\n            >\n              DESCARGAR EXCEL\n            </button>\n          </div>\n\n          <div className=\"bg-slate-950 p-3.5 rounded-xl border border-slate-850 flex items-center justify-between\">\n            <div className=\"flex flex-col\">\n              <span className=\"text-[10px] text-slate-500 font-black tracking-wider uppercase\">Disponibles Anual</span>\n              <span className=\"text-2xl font-black font-mono text-emerald-400 mt-1\">{contarPeriodo(\'anual\', \'disponibles\')}</span>\n            </div>\n            <button \n              onClick={() => handleExportPeriod(\'anual\', \'disponibles\')}\n              className=\"px-3 py-1.5 bg-emerald-600/10 hover:bg-emerald-600/20 text-emerald-400 font-bold text-[10px] border border-emerald-500/15 rounded-lg cursor-pointer\"\n            >\n              DESCARGAR EXCEL\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* DETALLE COMPORTAMIENTO GENERAL TABULAR EN BASE */}\n      <div className=\"bg-slate-900/30 rounded-xl border border-slate-800 overflow-hidden shadow-2xl\">\n        <div className=\"p-4 border-b border-slate-800 flex justify-between items-center bg-slate-900/20\">\n          <h4 className=\"font-bold text-xs text-slate-400 uppercase tracking-widest flex items-center gap-1.5\">\n            <BarChart3 className=\"text-blue-500 w-4.5 h-4.5\" />\n            Tabla General de Registro y Control\n          </h4>\n\n          <div className=\"flex items-center gap-2\">\n            <button \n              disabled={currentPage === 1}\n              onClick={() => setCurrentPage(p => Math.max(1, p - 1))}\n              className=\"p-1 px-2 bg-slate-950 hover:bg-slate-905 disabled:opacity-30 border border-slate-850 text-[10px] font-bold rounded cursor-pointer\"\n            >\n              ATR\303\201S\n            </button>\n            <span className=\"text-xs font-mono text-slate-400\">P\303\241g {currentPage} de {totalPages}</span>\n            <button \n              disabled={currentPage === totalPages}\n              onClick={() => setCurrentPage(p => Math.min(totalPages, p + 1))}\n              className=\"p-1 px-2 bg-slate-950 hover:bg-slate-905 disabled:opacity-30 border border-slate-850 text-[10px] font-bold rounded cursor-pointer\"\n            >\n              SIGUIENTE\n            </button>\n          </div>\n        </div>\n\n        <div className=\"overflow-x-auto text-[11px] font-mono\">\n          <table className=\"w-full text-left border-collapse\">\n            <thead>\n              <tr className=\"bg-slate-950/70 border-b border-slate-850 text-[9px] text-slate-500 font-bold tracking-widest uppercase\">\n                <th className=\"py-2.5 px-4\">Serial Terminal</th>\n                <th className=\"py-2.5 px-4\">Modelo POS</th>\n                <th className=\"py-2.5 px-4 w-36\">Estado Actual</th>\n                <th className=\"py-2.5 px-4\">Remitente Origen</th>\n                <th className=\"py-2.5 px-4 w-32\">Destino</th>\n                <th className=\"py-2.5 px-4 w-32\">Fecha Ingreso</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800/40\">\n              {paginatedAll.length === 0 ? (\n                <tr>\n                  <td colSpan={6} className=\"text-center py-8 text-slate-500 font-mono\">No hay seriales en la base de datos local.</td>\n                </tr>\n              ) : (\n                paginatedAll.map(s => {\n                  const m = getTerminalModel(s.serial, modelosDB);\n                  return (\n                    <tr key={s.id} className=\"hover:bg-slate-900/20 text-slate-300\">\n                      <td className=\"py-2 px-4 font-bold select-all tracking-wider text-slate-200\">\n                        {s.serial}\n                      </td>\n                      <td className=\"py-2 px-4 uppercase font-sans text-slate-400\">\n                        {m.modelo}\n                      </td>\n                      <td className=\"py-2 px-4\">\n                        <span className={`px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider block text-center w-28 ${getStatusStyle(s.status)}`}>\n                          {s.status}\n                        </span>\n                      </td>\n                      <td className=\"py-2 px-4 uppercase font-sans text-slate-300 font-semibold\">{s.remitente}</td>\n                      <td className=\"py-2 px-4 uppercase font-sans text-slate-400\">{s.destino || \'-\'}</td>\n                      <td className=\"py-2 px-4 text-slate-400\">{s.displayDate}</td>\n                    </tr>\n                  );\n                })\n              )}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* DETAIL MODAL OVERLAY */}\n      {modalType && (\n        <div \n          className=\"fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 animate-fade-in\"\n          onClick={() => setModalType(null)}\n        >\n          <div \n            className=\"bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-2xl p-6 flex flex-col gap-4 shadow-2xl max-h-[85vh] overflow-hidden\"\n            onClick={e => e.stopPropagation()}\n          >\n            <div className=\"flex justify-between items-center border-b border-slate-800 pb-3 flex-shrink-0\">\n              <div>\n                <h3 className=\"font-bold text-base text-blue-400 uppercase tracking-wider\">\n                  Listado: {modalType === \'total\' ? \'TODOS LOS EQUIPOS\' : modalType === \'disponibles\' ? \'EQUIPOS DISPONIBLES\' : \'EQUIPOS ENTREGADOS\'}\n                </h3>\n                <p className=\"text-[11px] text-slate-400 mt-1 font-mono\">\n                  Encontrados: {modalList.length} registros para este enfoque.\n                </p>\n              </div>\n              <button \n                onClick={() => setModalType(null)}\n                className=\"text-slate-400 hover:text-white font-bold p-1 bg-slate-800 rounded\"\n              >\n                Cerrar \342\234\225\n              </button>\n            </div>\n\n            {/* Modal search bar */}\n            <div className=\"relative flex-shrink-0\">\n              <input\n                type=\"text\"\n                value={modalSearch}\n                onChange={e => setModalSearch(e.target.value)}\n                placeholder=\"Filtrar por serial, remitente, cliente RIF...\"\n                className=\"w-full text-xs p-2.5 pl-8 bg-slate-950 border border-slate-800 rounded-lg text-slate-300 focus:outline-none\"\n              />\n              <Search size={14} className=\"absolute left-2.5 top-3.5 text-slate-500\" />\n            </div>\n\n            <div className=\"overflow-y-auto pr-1 flex-1 font-mono text-[11px] divide-y divide-slate-800/80\">\n              {modalList.length === 0 ? (\n                <div className=\"text-center py-10 text-slate-500\">Ning\303\272n registro coincide con el filtro del modal.</div>\n              ) : (\n                modalList.map(s => {\n                  const m = getTerminalModel(s.serial, modelosDB);\n                  return (\n                    <div key={s.id} className=\"py-2.5 hover:bg-slate-950/20 flex justify-between items-start gap-4\">\n                      <div className=\"flex flex-col gap-0.5\">\n                        <span className=\"text-xs font-bold text-blue-300 select-all tracking-wider\">{s.serial}</span>\n                        <span className=\"text-[10px] text-slate-500 font-sans\">{m.modelo}</span>\n                        {s.razonSocial && (\n                          <span className=\"text-[10px] text-slate-400 font-sans italic\">Cliente: {s.razonSocial}</span>\n                        )}\n                      </div>\n                      \n                      <div className=\"flex flex-col items-end gap-1 flex-shrink-0\">\n                        <span className={`px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider block text-center ${getStatusStyle(s.status)}`}>\n                          {s.status}\n                        </span>\n                        <span className=\"text-[9px] text-slate-500\">Ingreso: {s.displayDate}</span>\n                      </div>\n                    </div>\n                  );\n                })\n              )}\n            </div>\n          </div>\n        </div>\n      )}\n\n    </div>\n  );\n};\n"
    }
    diff {
      unified_diff {
        lines {
          text: "import React, { useState } from \'react\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { POSItem, ModelConfig } from \'../types\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
