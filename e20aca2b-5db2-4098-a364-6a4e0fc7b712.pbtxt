  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState, useEffect, useRef } from \'react\';\nimport { POSItem, EnvioExterno, ModelConfig, POSStatus } from \'./types\';\nimport { INITIAL_SERIALS, INITIAL_MODELS } from \'./data\';\nimport { GestionGeneral } from \'./components/GestionGeneral\';\nimport { Casillero } from \'./components/Casillero\';\nimport { HacerEnvio } from \'./components/HacerEnvio\';\nimport { CruceSeriales } from \'./components/CruceSeriales\';\nimport { EquiposEnviados } from \'./components/EquiposEnviados\';\nimport { Modelos } from \'./components/Modelos\';\nimport { Estadisticas } from \'./components/Estadisticas\';\nimport { Usuarios } from \'./components/Usuarios\';\n\n// Lucide icons\nimport { \n  Database, FileSpreadsheet, Download, RefreshCw, \n  Trash2, Layers, Search, Calendar, FolderCheck, \n  Settings, BarChart3, Users, Network, Terminal, ShieldAlert\n} from \'lucide-react\';\n\nexport default function App() {\n  // -------------------------------------------------------------\n  // STATE DEFINITIONS & PERSISTENCE\n  // -------------------------------------------------------------\n  const [serials, setSerials] = useState<POSItem[]>(() => {\n    const raw = localStorage.getItem(\'serialesDB\');\n    if (raw) return JSON.parse(raw);\n    return INITIAL_SERIALS;\n  });\n\n  const [enviosExternos, setEnviosExternos] = useState<EnvioExterno[]>(() => {\n    const raw = localStorage.getItem(\'enviosExternosDB\');\n    if (raw) return JSON.parse(raw);\n    return [];\n  });\n\n  const [modelosDB, setModelosDB] = useState<Record<string, ModelConfig>>(() => {\n    const raw = localStorage.getItem(\'modelosDB\');\n    if (raw) return JSON.parse(raw);\n    return INITIAL_MODELS;\n  });\n\n  const [currentTab, setCurrentTab] = useState<string>(() => {\n    return localStorage.getItem(\'currentTab\') || \'general\';\n  });\n\n  // Global Filter States (shared reactively between tables)\n  const [globalSearch, setGlobalSearch] = useState(\'\');\n  const [dateFrom, setDateFrom] = useState(\'\');\n  const [dateTo, setDateTo] = useState(\'\');\n  const [includeCasillero, setIncludeCasillero] = useState(true);\n\n  // Floating History Tooltip State\n  const [historyTooltip, setHistoryTooltip] = useState<{\n    serial: string;\n    clientX: number;\n    clientY: number;\n  } | null>(null);\n\n  // Save states to local storages on mutate\n  useEffect(() => {\n    localStorage.setItem(\'serialesDB\', JSON.stringify(serials));\n  }, [serials]);\n\n  useEffect(() => {\n    localStorage.setItem(\'enviosExternosDB\', JSON.stringify(enviosExternos));\n  }, [enviosExternos]);\n\n  useEffect(() => {\n    localStorage.setItem(\'modelosDB\', JSON.stringify(modelosDB));\n  }, [modelosDB]);\n\n  useEffect(() => {\n    localStorage.setItem(\'currentTab\', currentTab);\n  }, [currentTab]);\n\n  // -------------------------------------------------------------\n  // MASTER HEADER CONTROL ACTIONS\n  // -------------------------------------------------------------\n  const handleImportCSVData = () => {\n    const input = document.createElement(\'input\');\n    input.type = \'file\';\n    input.accept = \'.csv\';\n    input.onchange = (e) => {\n      const file = (e.target as HTMLInputElement).files?.[0];\n      if (!file) return;\n\n      const reader = new FileReader();\n      reader.onload = (fileEvent) => {\n        try {\n          const csvText = fileEvent.target?.result as string;\n          const lines = csvText.split(/\\r?\\n/).map(l => l.trim()).filter(Boolean);\n          if (lines.length < 2) {\n            alert(\"Archivo inv\303\241lido o vac\303\255o.\");\n            return;\n          }\n\n          const parsedHeaders = lines[0].split(\',\').map(h => h.toUpperCase().trim());\n          if (!parsedHeaders.some(h => h.includes(\'SERIAL\'))) {\n            alert(\"Formato no reconocido o falto de columna SERIAL.\");\n            return;\n          }\n\n          if (confirm(\"\302\277Est\303\241 seguro de importar los registros? Esto reescribir\303\241 la base logistica local.\")) {\n            // Find positions\n            const idxID = parsedHeaders.findIndex(h => h.includes(\'ID\'));\n            const idxSerial = parsedHeaders.findIndex(h => h.includes(\'SERIAL\'));\n            const idxStatus = parsedHeaders.findIndex(h => h.includes(\'STATUS\') || h.includes(\'ESTADO\'));\n            const idxRemitente = parsedHeaders.findIndex(h => h.includes(\'REMITENTE\'));\n            const idxRif = parsedHeaders.findIndex(h => h.includes(\'RIF\'));\n            const idxRazon = parsedHeaders.findIndex(h => h.includes(\'RAZON\'));\n            const idxSource = parsedHeaders.findIndex(h => h.includes(\'GUIAENTRADA\') || h.includes(\'ORIGEN\'));\n            const idxFecha = parsedHeaders.findIndex(h => h.includes(\'FECHA\'));\n            const idxForro = parsedHeaders.findIndex(h => h.includes(\'FORRO\'));\n            const idxBateria = parsedHeaders.findIndex(h => h.includes(\'BATERIA\'));\n            const idxCargador = parsedHeaders.findIndex(h => h.includes(\'CARGADOR\'));\n            const idxCaja = parsedHeaders.findIndex(h => h.includes(\'CAJA\'));\n            const idxSim = parsedHeaders.findIndex(h => h.includes(\'SIM\'));\n            const idxSimNum = parsedHeaders.findIndex(h => h.includes(\'SIMNUMBER\') || h.includes(\'NUMEROSIM\'));\n            const idxOper = parsedHeaders.findIndex(h => h.includes(\'OPERADORA\'));\n            const idxModManual = parsedHeaders.findIndex(h => h.includes(\'MODELOMANUAL\') || h.includes(\'MODELOMANUAL\'));\n            const idxNegocio = parsedHeaders.findIndex(h => h.includes(\'MODELONEGOCIO\'));\n            const idxEntregadoTec = parsedHeaders.findIndex(h => h.includes(\'ENTREGADOTECNICO\'));\n            const idxSust = parsedHeaders.findIndex(h => h.includes(\'ESSUSTITUCION\'));\n            const idxSerialSust = parsedHeaders.findIndex(h => h.includes(\'SUSTITUTO\'));\n            const idxFechaSalida = parsedHeaders.findIndex(h => h.includes(\'FECHASALIDA\'));\n            const idxFechaLiberacion = parsedHeaders.findIndex(h => h.includes(\'FECHASALIDACLIENTE\'));\n            const idxGuiaLib = parsedHeaders.findIndex(h => h.includes(\'GUIASALIDACLIENTE\'));\n            const idxDestinoSalida = parsedHeaders.findIndex(h => h.includes(\'DESTINOSALIDA\'));\n            const idxObs = parsedHeaders.findIndex(h => h.includes(\'OBSERVACIONES\'));\n            const idxTicket = parsedHeaders.findIndex(h => h.includes(\'TICKET\'));\n            const idxDestino = parsedHeaders.findIndex(h => h.includes(\'DESTINO\'));\n\n            const importedItems: POSItem[] = [];\n\n            for (let i = 1; i < lines.length; i++) {\n              const cols = lines[i].split(\',\').map(c => c.replace(/^\"|\"$/g, \'\').trim());\n              if (cols.length < 2) continue;\n\n              const cleanSerial = cols[idxSerial]?.toUpperCase() || \'\';\n              if (!cleanSerial) continue;\n\n              const statusVal = cols[idxStatus] as POSStatus || \'SIN ESTATUS\';\n              const rawDate = cols[idxFecha] || new Date().toISOString().slice(0, 10);\n              const formatDisplayDate = rawDate.split(\'-\').reverse().join(\'/\');\n\n              importedItems.push({\n                id: idxID !== -1 ? parseInt(cols[idxID]) : Date.now() + Math.random(),\n                serial: cleanSerial,\n                date: rawDate,\n                displayDate: formatDisplayDate,\n                status: statusVal,\n                remitente: idxRemitente !== -1 ? cols[idxRemitente].toUpperCase() : \'\',\n                source: idxSource !== -1 ? cols[idxSource].toUpperCase() : \'\',\n                isCasillero: idxSource !== -1 && !!cols[idxSource],\n                selected: false,\n                rif: idxRif !== -1 ? cols[idxRif].toUpperCase() : \'\',\n                razonSocial: idxRazon !== -1 ? cols[idxRazon].toUpperCase() : \'\',\n                observaciones: idxObs !== -1 ? cols[idxObs] : \'\',\n                forro: idxForro !== -1 ? (cols[idxForro]?.toLowerCase() === \'true\') : false,\n                bateria: idxBateria !== -1 ? (cols[idxBateria]?.toLowerCase() === \'true\') : false,\n                cargador: idxCargador !== -1 ? (cols[idxCargador]?.toLowerCase() === \'true\') : false,\n                caja: idxCaja !== -1 ? (cols[idxCaja]?.toLowerCase() === \'true\') : false,\n                sim: idxSim !== -1 ? (cols[idxSim]?.toLowerCase() === \'true\') : false,\n                simNumber: idxSimNum !== -1 ? cols[idxSimNum] : \'\',\n                operadora: idxOper !== -1 ? (cols[idxOper]?.toUpperCase() as any) : \'\',\n                modeloManual: idxModManual !== -1 ? cols[idxModManual] : \'\',\n                modeloNegocio: idxNegocio !== -1 ? (cols[idxNegocio]?.toUpperCase() as any) : \'\',\n                entregadoTecnico: idxEntregadoTec !== -1 ? (cols[idxEntregadoTec]?.toLowerCase() === \'true\') : false,\n                esSustitucion: idxSust !== -1 ? (cols[idxSust]?.toLowerCase() === \'true\') : false,\n                serialSustituto: idxSerialSust !== -1 ? cols[idxSerialSust] : \'\',\n                fechaSalida: idxFechaSalida !== -1 ? cols[idxFechaSalida] : \'\',\n                fechaSalidaCliente: idxFechaLiberacion !== -1 ? cols[idxFechaLiberacion] : \'\',\n                guiaSalidaCliente: idxGuiaLib !== -1 ? cols[idxGuiaLib] : \'\',\n                destinoSalida: idxDestinoSalida !== -1 ? cols[idxDestinoSalida] : \'\',\n                fechaConfirmada: false,\n                ticket: idxTicket !== -1 ? cols[idxTicket].toUpperCase() : \'\',\n                destino: idxDestino !== -1 ? cols[idxDestino].toUpperCase() : \'\'\n              });\n            }\n\n            if (importedItems.length > 0) {\n              setSerials(importedItems);\n              alert(`\302\241Se importaron ${importedItems.length} terminales exitosamente!`);\n            } else {\n              alert(\"No se cargaron registros v\303\241lidos del archivo.\");\n            }\n          }\n        } catch (e: any) {\n          alert(`Error procesando e importando el archivo: ${e.message}`);\n        }\n      };\n      reader.readAsText(file, \'UTF-8\');\n    };\n    input.click();\n  };\n\n  const handleExportCSV = () => {\n    let csv = \"SERIAL,ESTADO,REMITENTE,RIF,RAZON_SOCIAL,TICKET,GUIA_ENTRADA,DESTINO,FECHA_INGRESO\\n\";\n    serials.forEach(s => {\n      csv += `\"${s.serial}\",\"${s.status}\",\"${s.remitente}\",\"${s.rif || \'\'}\",\"${s.razonSocial || \'\'}\",\"${s.ticket || \'\'}\",\"${s.source || \'\'}\",\"${s.destino || \'\'}\",\"${s.date}\"\\n`;\n    });\n\n    const blob = new Blob([\"\\uFEFF\" + csv], { type: \"text/csv;charset=utf-8;\" });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\"a\");\n    link.href = url;\n    link.download = `disglobal_tracking_report_${new Date().toISOString().slice(0, 10)}.csv`;\n    link.click();\n    URL.revokeObjectURL(url);\n  };\n\n  const handleExportJSON = () => {\n    const dataObj = {\n      backup: \'DISGLOBAL TRACKING\',\n      date: new Date().toISOString(),\n      serials,\n      enviosExternos,\n      modelosDB\n    };\n    const jsonStr = JSON.stringify(dataObj, null, 2);\n    const blob = new Blob([jsonStr], { type: \'application/json\' });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\'a\');\n    link.href = url;\n    link.download = `pedro_disglobal_backup_${new Date().toISOString().slice(0, 10)}.json`;\n    link.click();\n    URL.revokeObjectURL(url);\n  };\n\n  const handleClearDatabase = () => {\n    const pass = prompt(\"INGRESE LA CONTRASE\303\221A DE SEGURIDAD PARA BORRAR:\");\n    if (pass === \"Blackopioum12\") {\n      if (confirm(\"\360\237\232\250 \302\277EST\303\201 COMPLETA Y ABSOLUTAMENTE SEGURO? Esto vaciar\303\241 toda la base logistica local de seriales y salidas.\")) {\n        setSerials([]);\n        setEnviosExternos([]);\n        alert(\"La base de datos local ha sido completamente vaciada.\");\n      }\n    } else if (pass !== null) {\n      alert(\"\342\232\240\357\270\217 CONTRASE\303\221A INCORRECTA de borrado de base de datos.\");\n    }\n  };\n\n  const handleDeleteSelected = () => {\n    const selectedCount = serials.filter(s => s.selected).length;\n    if (selectedCount === 0) {\n      alert(\"No hay elementos seleccionados.\");\n      return;\n    }\n    if (confirm(`\302\277Desea eliminar los ${selectedCount} registros seleccionados de la base general?`)) {\n      setSerials(prev => prev.filter(s => !s.selected));\n    }\n  };\n\n  const handleExportFullCSVBackup = () => {\n    let csv = \"ID,SERIAL,STATUS,REMITENTE,GUI_ENTRADA,RIF,RAZON_SOCIAL,TICKET,DESTINO,OBSERVACIONES,FORRO,BATERIA,CARGADOR,CAJA,SIM,SIM_NUMBER,OPERADORA,MODELO_NEGOCIO,ENTREGADO_TECNICO,FECHA_LLEGADA\\n\";\n    serials.forEach(s => {\n      csv += `\"${s.id}\",\"${s.serial}\",\"${s.status}\",\"${s.remitente}\",\"${s.source || \'\'}\",\"${s.rif || \'\'}\",\"${s.razonSocial || \'\'}\",\"${s.ticket || \'\'}\",\"${s.destino || \'\'}\",\"${s.observaciones || \'\'}\",\"${s.forro}\",\"${s.bateria}\",\"${s.cargador}\",\"${s.caja}\",\"${s.sim}\",\"${s.simNumber || \'\'}\",\"${s.operadora || \'\'}\",\"${s.modeloNegocio || \'\'}\",\"${s.entregadoTecnico}\",\"${s.date}\"\\n`;\n    });\n\n    const blob = new Blob([\"\\uFEFF\" + csv], { type: \"text/csv;charset=utf-8;\" });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\"a\");\n    link.href = url;\n    link.download = `backup_completo_disglobal_${new Date().toISOString().slice(0, 10)}.csv`;\n    link.click();\n    URL.revokeObjectURL(url);\n  };\n\n  // -------------------------------------------------------------\n  // HISTORY TOOLTIP LOGIC (POP OVERLAY ON HOVER)\n  // -------------------------------------------------------------\n  const showHistory = (serial: string, anchor: HTMLElement) => {\n    const rect = anchor.getBoundingClientRect();\n    setHistoryTooltip({\n      serial,\n      clientX: rect.left,\n      clientY: rect.bottom + window.scrollY\n    });\n  };\n\n  const hideHistory = () => {\n    setHistoryTooltip(null);\n  };\n\n  // Filter history logs for current serial\n  const getSerialHistoryLogs = (serial: string) => {\n    return serials\n      .filter(s => s.serial === serial)\n      .sort((a,b) => new Date(b.date).getTime() - new Date(a.date).getTime());\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 font-sans antialiased text-slate-100 flex flex-col selection:bg-blue-600/60 selection:text-white\">\n      \n      {/* GLOBAL HEADER BAR */}\n      <header className=\"bg-slate-900/60 border-b border-slate-900/85 backdrop-blur-md sticky top-0 z-40 p-4 md:px-8\">\n        <div className=\"max-w-7xl mx-auto flex flex-col lg:flex-row justify-between items-center gap-5\">\n          \n          <div className=\"flex items-center gap-4 cursor-pointer\">\n            <div className=\"w-12 h-12 rounded-xl bg-blue-600/10 border border-blue-500/20 flex items-center justify-center shadow-lg shadow-blue-500/5 hover:border-blue-500/40 hover:bg-blue-600/20 transition-all select-none\">\n              <Network className=\"text-blue-500 select-all w-6 h-6 animate-pulse\" />\n            </div>\n            <div>\n              <h1 className=\"text-xl md:text-2xl font-black tracking-wider text-slate-50 flex items-center gap-2\">\n                DISGLOBAL TRACKING\n                <span className=\"text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 border border-blue-500/20 tracking-widest font-black\">SPV V4.0</span>\n              </h1>\n              <p className=\"text-xs text-slate-500 font-mono tracking-wide mt-0.5\">REGISTROS \342\200\242 FECHAS \342\200\242 RIF \342\200\242 SERIALES</p>\n            </div>\n          </div>\n\n          <div className=\"flex flex-wrap gap-2 justify-center items-center\">\n            <button \n              onClick={handleImportCSVData}\n              className=\"px-3.5 py-2 text-xs font-bold uppercase tracking-wider bg-emerald-700/15 hover:bg-emerald-700/25 text-emerald-400 border border-emerald-500/20 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer\"\n            >\n              <FileSpreadsheet size={13} />\n              <span>Importar Datos</span>\n            </button>\n\n            <button \n              onClick={handleExportCSV}\n              className=\"px-3.5 py-2 text-xs font-bold uppercase tracking-wider bg-blue-600/15 hover:bg-blue-600/25 text-blue-400 border border-blue-500/20 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer\"\n            >\n              <Download size={13} />\n              <span>Exportar CSV</span>\n            </button>\n\n            <button \n              onClick={handleExportJSON}\n              className=\"px-3.5 py-2 text-xs font-bold uppercase tracking-wider bg-purple-600/15 hover:bg-purple-600/25 text-purple-400 border border-purple-500/20 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer\"\n            >\n              <Terminal size={13} />\n              <span>Exportar JSON</span>\n            </button>\n\n            <button \n              onClick={handleDeleteSelected}\n              className=\"px-3.5 py-2 text-xs font-bold uppercase tracking-wider bg-red-950/20 hover:bg-red-950/40 text-red-400 border border-red-950 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer\"\n            >\n              <Trash2 size={13} />\n              <span>Eliminar</span>\n            </button>\n\n            <button \n              onClick={handleExportFullCSVBackup}\n              className=\"px-3.5 py-2 text-xs font-bold uppercase tracking-wider bg-slate-900 hover:bg-slate-850 hover:text-white border border-slate-800 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer\"\n            >\n              <Database size={13} />\n              <span>BD Completa</span>\n            </button>\n\n            <button \n              onClick={handleClearDatabase}\n              className=\"px-3.5 py-2 text-xs font-black uppercase tracking-wider bg-red-600 hover:bg-red-500 text-white rounded-lg flex items-center gap-1.5 transition-all cursor-pointer shadow-lg shadow-red-500/5 hover:shadow-red-500/20\"\n            >\n              <ShieldAlert size={13} />\n              <span>Borrar Todo</span>\n            </button>\n          </div>\n\n        </div>\n      </header>\n\n      {/* DETALLE FILTROS REACTIVOS UNIFICADOS DE TABLA */}\n      <section className=\"bg-slate-950 border-b border-slate-900/80 p-4 md:px-8 flex-shrink-0\">\n        <div className=\"max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-3\">\n          \n          {/* SEARCH BAR UNIT */}\n          <div className=\"relative\">\n            <input\n              type=\"text\"\n              value={globalSearch}\n              onChange={e => setGlobalSearch(e.target.value)}\n              placeholder=\"Buscar por serial, RIF, mititulo, gu\303\255a, ticket...\"\n              className=\"w-full text-xs p-3 pl-8 bg-slate-900/40 border border-slate-850 rounded-xl text-slate-200 uppercase placeholder-slate-500 font-mono focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all font-semibold\"\n            />\n            <Search size={14} className=\"absolute left-2.5 top-4 text-slate-500\" />\n            {globalSearch && (\n              <button \n                onClick={() => setGlobalSearch(\'\')}\n                className=\"absolute right-3 top-3 text-[10px] font-bold text-slate-500 hover:text-slate-300\"\n              >\n                Limpiar\n              </button>\n            )}\n          </div>\n\n          {/* DATE RANGE SPLIT */}\n          <div className=\"grid grid-cols-2 gap-2\">\n            <div className=\"relative\">\n              <input\n                type=\"date\"\n                value={dateFrom}\n                onChange={e => setDateFrom(e.target.value)}\n                className=\"w-full text-xs p-2.5 bg-slate-900/40 border border-slate-850 rounded-xl text-slate-300 font-mono uppercase\"\n              />\n              <span className=\"absolute -top-2 left-3 px-1 text-[8px] bg-slate-950 text-slate-500 font-black tracking-widest uppercase\">Desde</span>\n            </div>\n            \n            <div className=\"relative\">\n              <input\n                type=\"date\"\n                value={dateTo}\n                onChange={e => setDateTo(e.target.value)}\n                className=\"w-full text-xs p-2.5 bg-slate-900/40 border border-slate-850 rounded-xl text-slate-300 font-mono uppercase\"\n              />\n              <span className=\"absolute -top-2 left-3 px-1 text-[8px] bg-slate-950 text-slate-500 font-black tracking-widest uppercase\">Hasta</span>\n            </div>\n          </div>\n\n          {/* INCLUSIVE CHECK */}\n          <div className=\"flex items-center justify-end md:justify-center lg:justify-end gap-3 px-2\">\n            <label className=\"flex items-center gap-2 text-xs font-bold text-slate-400 select-none cursor-pointer tracking-wider\">\n              <input\n                type=\"checkbox\"\n                checked={includeCasillero}\n                onChange={e => setIncludeCasillero(e.target.checked)}\n                className=\"rounded text-blue-500 bg-slate-900 border-slate-800\"\n              />\n              <span>INCLUIR EQUIPOS DE CASILLERO</span>\n            </label>\n          </div>\n\n        </div>\n      </section>\n\n      {/* SECCI\303\223N 3: PESTA\303\221AS DE NAVEGACI\303\223N PRINCIPAL */}\n      <nav className=\"bg-slate-955 max-w-7xl mx-auto w-full px-4 md:px-8 mt-5\">\n        <div className=\"flex gap-1 overflow-x-auto pb-1.5 border-b border-slate-900\">\n          {[\n            { id: \'general\', label: \'Gesti\303\263n General\', icon: Layers },\n            { id: \'casillero\', label: \'Casillero\', icon: FolderCheck },\n            { id: \'hacerEnvio\', label: \'Hacer Env\303\255o\', icon: Send },\n            { id: \'cruce\', label: \'Cruce de Seriales\', icon: Network },\n            { id: \'envios\', label: \'Equipos Enviados\', icon: FileSpreadsheet },\n            { id: \'modelos\', label: \'Prefijos Modelos\', icon: Settings },\n            { id: \'estadisticas\', label: \'Estad\303\255sticas\', icon: BarChart3 },\n            { id: \'usuarios\', label: \'Usuarios / Clientes\', icon: Users }\n          ].map(t => {\n            const Icon = t.icon;\n            const isActive = currentTab === t.id;\n            return (\n              <button\n                key={t.id}\n                onClick={() => setCurrentTab(t.id)}\n                className={`flex items-center gap-1.5 px-4 py-2 text-xs font-bold uppercase tracking-widest transition-all rounded-t-lg cursor-pointer whitespace-nowrap ${\n                  isActive \n                    ? \'border-b-2 border-b-blue-500 text-blue-400 bg-slate-900/30\' \n                    : \'text-slate-500 hover:text-slate-300\'\n                }`}\n              >\n                <Icon size={13} />\n                <span>{t.label}</span>\n              </button>\n            );\n          })}\n        </div>\n      </nav>\n\n      {/* CORE BODY CONTAINER */}\n      <main className=\"max-w-7xl mx-auto w-full p-4 md:p-8 flex-grow\">\n        \n        {currentTab === \'general\' && (\n          <GestionGeneral\n            serials={serials}\n            setSerials={setSerials}\n            modelosDB={modelosDB}\n            globalSearch={globalSearch}\n            setGlobalSearch={setGlobalSearch}\n            dateFrom={dateFrom}\n            setDateFrom={setDateFrom}\n            dateTo={dateTo}\n            setDateTo={setDateTo}\n            includeCasillero={includeCasillero}\n            setIncludeCasillero={setIncludeCasillero}\n            onShowHistory={showHistory}\n            onHideHistory={hideHistory}\n          />\n        )}\n\n        {currentTab === \'casillero\' && (\n          <Casillero\n            serials={serials}\n            setSerials={setSerials}\n            modelosDB={modelosDB}\n            globalSearch={globalSearch}\n            dateFrom={dateFrom}\n            dateTo={dateTo}\n            statusFilter=\"TODOS\"\n          />\n        )}\n\n        {currentTab === \'hacerEnvio\' && (\n          <HacerEnvio\n            enviosExternos={enviosExternos}\n            setEnviosExternos={setEnviosExternos}\n          />\n        )}\n\n        {currentTab === \'cruce\' && (\n          <CruceSeriales\n            serials={serials}\n            setSerials={setSerials}\n            modelosDB={modelosDB}\n          />\n        )}\n\n        {currentTab === \'envios\' && (\n          <EquiposEnviados\n            serials={serials}\n            enviosExternos={enviosExternos}\n            modelosDB={modelosDB}\n            globalSearch={globalSearch}\n            dateFrom={dateFrom}\n            dateTo={dateTo}\n          />\n        )}\n\n        {currentTab === \'modelos\' && (\n          <Modelos\n            modelosDB={modelosDB}\n            setModelosDB={setModelosDB}\n          />\n        )}\n\n        {currentTab === \'estadisticas\' && (\n          <Estadisticas\n            serials={serials}\n            modelosDB={modelosDB}\n          />\n        )}\n\n        {currentTab === \'usuarios\' && (\n          <Usuarios\n            serials={serials}\n            modelosDB={modelosDB}\n          />\n        )}\n\n      </main>\n\n      {/* FOOTER BAR */}\n      <footer className=\"border-t border-slate-900 bg-slate-950/80 p-5 text-center mt-10 text-[11px] text-slate-600 font-mono tracking-wider flex-shrink-0\">\n        <div className=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-3\">\n          <span>\302\251 {new Date().getFullYear()} DISGLOBAL INC. Todos los Derechos Reservados.</span>\n          <span>Desarrollado y perfeccionado para control de terminales log\303\255sticos POS.</span>\n        </div>\n      </footer>\n\n      {/* FLOATING RETRACED HISTORY OVERLAY POPUP */}\n      {historyTooltip && (\n        <div\n          className=\"absolute z-50 bg-slate-950/95 border border-blue-500/40 rounded-xl p-3 shadow-2xl min-w-[270px] max-w-[340px] pointer-events-none mt-2 font-mono text-[11px] animate-fade-in text-slate-100 backdrop-blur-md\"\n          style={{\n            left: historyTooltip.clientX,\n            top: historyTooltip.clientY\n          }}\n        >\n          <div className=\"font-bold text-[12px] text-blue-400 border-b border-slate-800 pb-1.5 mb-1.5 uppercase font-sans\">\n            Recibo de Historial\n          </div>\n          <div className=\"text-slate-400 font-sans tracking-wide\">\n            Serial: <span className=\"font-mono text-white text-xs font-black\">{historyTooltip.serial}</span>\n          </div>\n\n          <div className=\"mt-2 text-[10px] space-y-1.5\">\n            {getSerialHistoryLogs(historyTooltip.serial).length === 0 ? (\n              <div className=\"text-slate-600 italic\">No hay logs previos en la base general.</div>\n            ) : (\n              getSerialHistoryLogs(historyTooltip.serial).map((log, i) => (\n                <div key={i} className=\"flex justify-between items-center border-b border-slate-900/60 pb-1\">\n                  <div>\n                    <div className=\"font-bold text-slate-300\">{log.displayDate}</div>\n                    <div className=\"text-[9px] text-slate-500 uppercase\">{log.remitente}</div>\n                  </div>\n                  <span className=\"px-1.5 py-0.5 rounded text-[9px] font-black uppercase text-amber-300 bg-amber-500/10 tracking-widest border border-amber-500/20\">\n                    {log.status}\n                  </span>\n                </div>\n              ))\n            )}\n          </div>\n        </div>\n      )}\n\n    </div>\n  );\n}\n"
    }
