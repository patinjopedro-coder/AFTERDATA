        replacement_content: "  const limpiarTodo = () => {\n    if (window.confirm(\'\302\277Desea limpiar permanentemente la informaci\303\263n de ambos campos?\')) {\n      setEmailText(\'\');\n      setFisicoText(\'\');\n      setEmailViewMode(\'edit\');\n      setFisicoViewMode(\'edit\');\n    }\n  };\n\n  const updateSerialStatus = (serial: string, newStatus: POSStatus) => {\n    const cleanSerial = serial.trim().toUpperCase();\n    if (!cleanSerial) return;\n    setDatosMaestro(prev => {\n      const copy = [...prev];\n      const idx = copy.findIndex(item => item.serial === cleanSerial);\n      if (idx !== -1) {\n        copy[idx] = { ...copy[idx], status: newStatus };\n      } else {\n        copy.push({\n          serial: cleanSerial,\n          status: newStatus,\n          operadora: \'\',\n          simNumber: \'\',\n          ticket: \'\'\n        });\n      }\n      return copy;\n    });\n  };"
