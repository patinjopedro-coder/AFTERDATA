  file_change {
    absolute_path_uri: "file:///src/components/LogoIcon.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\n\ninterface LogoIconProps {\n  className?: string;\n}\n\nexport const LogoIcon: React.FC<LogoIconProps> = ({ className }) => {\n  return (\n    <svg \n      viewBox=\"0 0 500 500\" \n      className={className} \n      fill=\"none\" \n      xmlns=\"http://www.w3.org/2000/svg\"\n    >\n      <defs>\n        {/* Glow filters for real-time sequential glow */}\n        <filter id=\"arrowGlow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n          <feGaussianBlur stdDeviation=\"8\" result=\"blur\" />\n          <feMerge>\n            <feMergeNode in=\"blur\" />\n            <feMergeNode in=\"SourceGraphic\" />\n          </feMerge>\n        </filter>\n\n        <filter id=\"screenGlow\" x=\"-30%\" y=\"-30%\" width=\"160%\" height=\"160%\">\n          <feGaussianBlur stdDeviation=\"6\" result=\"blur\" />\n          <feMerge>\n            <feMergeNode in=\"blur\" />\n            <feMergeNode in=\"SourceGraphic\" />\n          </feMerge>\n        </filter>\n\n        {/* Navy Blue Gradient to match the D from the reference image */}\n        <linearGradient id=\"brandNavy\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n          <stop offset=\"0%\" stopColor=\"#1b324f\" />\n          <stop offset=\"100%\" stopColor=\"#14243b\" />\n        </linearGradient>\n\n        {/* Shiny Golden Yellow-Orange Gradient for the Arrow */}\n        <linearGradient id=\"brandGold\" x1=\"0%\" y1=\"100%\" x2=\"100%\" y2=\"0%\">\n          <stop offset=\"0%\" stopColor=\"#e28714\" />\n          <stop offset=\"50%\" stopColor=\"#f3a82c\" />\n          <stop offset=\"100%\" stopColor=\"#fcd34d\" />\n        </linearGradient>\n\n        {/* Grey Gradient for the lower portion of the D */}\n        <linearGradient id=\"brandGrey\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n          <stop offset=\"0%\" stopColor=\"#535c66\" />\n          <stop offset=\"100%\" stopColor=\"#3c434a\" />\n        </linearGradient>\n\n        {/* POS Terminal Shading Gradient */}\n        <linearGradient id=\"posBody\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n          <stop offset=\"0%\" stopColor=\"#5d788e\" />\n          <stop offset=\"100%\" stopColor=\"#3d5263\" />\n        </linearGradient>\n\n        <linearGradient id=\"cardGradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n          <stop offset=\"0%\" stopColor=\"#2c3e50\" />\n          <stop offset=\"100%\" stopColor=\"#1a252f\" />\n        </linearGradient>\n\n        {/* Stylesheet for keyframed sequential lighting */}\n        <style dangerouslySetInnerHTML={{ __html: `\n          @keyframes sequentialArrowPulse {\n            0% {\n              filter: none;\n              stroke: url(#brandGold);\n              fill: url(#brandGold);\n            }\n            10% {\n              filter: url(#arrowGlow);\n              stroke: #ffdf7a;\n              fill: #ffdf7a;\n            }\n            35% {\n              filter: url(#arrowGlow);\n              stroke: #ffd447;\n              fill: #ffd447;\n            }\n            45%, 100% {\n              filter: none;\n              stroke: url(#brandGold);\n              fill: url(#brandGold);\n            }\n          }\n\n          @keyframes sequentialScreenPulse {\n            0%, 50% {\n              fill: #22313f;\n              stroke: #334e68;\n              filter: none;\n            }\n            60% {\n              fill: #10b981;\n              stroke: #34d399;\n              filter: url(#screenGlow);\n            }\n            85% {\n              fill: #059669;\n              stroke: #10b981;\n              filter: url(#screenGlow);\n            }\n            95%, 100% {\n              fill: #22313f;\n              stroke: #334e68;\n              filter: none;\n            }\n          }\n\n          .animated-arrow-path {\n            animation: sequentialArrowPulse 5s infinite ease-in-out;\n          }\n          .animated-arrow-head {\n            animation: sequentialArrowPulse 5s infinite ease-in-out;\n          }\n          .animated-pos-screen {\n            animation: sequentialScreenPulse 5s infinite ease-in-out;\n          }\n        `}} />\n      </defs>\n\n      {/* 1. Large Letter \"D\" Shape (Robust, premium navy blue top loop and vertical back) */}\n      {/* Outer back and top loops */}\n      <path \n        d=\"M 150 80 \n           H 290 \n           C 385 80, 420 120, 420 215\n           C 420 230, 418 245, 415 260\n           L 370 255\n           C 373 245, 375 235, 375 215\n           C 375 155, 350 135, 290 135\n           H 210 \n           V 345\n           H 150 \n           V 80 \n           Z\" \n        fill=\"url(#brandNavy)\" \n      />\n\n      {/* White/Semi-transparent gap line behind the letter \"D\" (retaining logo spacing aesthetics) */}\n      {/* 2. Lower Grey segment of the \"D\" mimicking the lower loop cut off by the arrow */}\n      <path \n        d=\"M 402 295\n           C 375 365, 325 410, 240 410\n           L 185 410\n           C 250 410, 320 380, 360 315\n           Z\" \n        fill=\"url(#brandGrey)\"\n      />\n\n      {/* 3. Central Tilted POS Device (Tilted perfectly like the reference image at -33 degrees) */}\n      <g transform=\"rotate(-33 260 255)\">\n        {/* Shadow */}\n        <rect x=\"202\" y=\"152\" width=\"106\" height=\"166\" rx=\"18\" fill=\"#020617\" opacity=\"0.35\" />\n        \n        {/* Terminal Case (sleek cool bluish grey) */}\n        <rect x=\"200\" y=\"150\" width=\"102\" height=\"162\" rx=\"16\" fill=\"url(#posBody)\" stroke=\"#2b3a4a\" strokeWidth=\"4\" />\n        \n        {/* Styled upper case bevel area */}\n        <path d=\"M 202 153 H 300 V 215 H 202 Z\" fill=\"#4d6275\" opacity=\"0.4\" />\n        \n        {/* Display Screen Frame */}\n        <rect x=\"210\" y=\"162\" width=\"82\" height=\"54\" rx=\"8\" fill=\"#141e26\" stroke=\"#253542\" strokeWidth=\"2\" />\n        \n        {/* Sequential Glowing Screen */}\n        <rect \n          x=\"215\" \n          y=\"167\" \n          width=\"72\" \n          height=\"44\" \n          rx=\"4\" \n          fill=\"#22313f\" \n          stroke=\"#334e68\" \n          strokeWidth=\"1.5\" \n          className=\"animated-pos-screen\"\n        />\n        \n        {/* Minimal layout details on screen */}\n        <line x1=\"223\" y1=\"176\" x2=\"258\" y2=\"176\" stroke=\"#ffffff\" strokeWidth=\"1.5\" strokeLinecap=\"round\" opacity=\"0.3\" />\n        <line x1=\"223\" y1=\"184\" x2=\"268\" y2=\"184\" stroke=\"#ffffff\" strokeWidth=\"1.5\" strokeLinecap=\"round\" opacity=\"0.3\" />\n        <line x1=\"223\" y1=\"192\" x2=\"248\" y2=\"192\" stroke=\"#ffffff\" strokeWidth=\"1.5\" strokeLinecap=\"round\" opacity=\"0.3\" />\n\n        {/* Paper Receipt Slot at the Top */}\n        <rect x=\"220\" y=\"136\" width=\"62\" height=\"6\" rx=\"1\" fill=\"#1a2630\" />\n        \n        {/* Receipt Paper Feed trailing out */}\n        <path d=\"M 224 136 L 227 114 H 275 L 278 136 Z\" fill=\"#f8fafc\" stroke=\"#e2e8f0\" strokeWidth=\"1\" />\n        {/* Little Barcode Graphic on paper */}\n        <line x1=\"234\" y1=\"118\" x2=\"234\" y2=\"130\" stroke=\"#101820\" strokeWidth=\"2.5\" />\n        <line x1=\"239\" y1=\"118\" x2=\"239\" y2=\"130\" stroke=\"#101820\" strokeWidth=\"1\" />\n        <line x1=\"243\" y1=\"118\" x2=\"243\" y2=\"130\" stroke=\"#101820\" strokeWidth=\"1.5\" />\n        <line x1=\"247\" y1=\"118\" x2=\"247\" y2=\"130\" stroke=\"#101820\" strokeWidth=\"3\" />\n        <line x1=\"253\" y1=\"118\" x2=\"253\" y2=\"130\" stroke=\"#101820\" strokeWidth=\"1\" />\n        <line x1=\"257\" y1=\"118\" x2=\"257\" y2=\"130\" stroke=\"#101820\" strokeWidth=\"2\" />\n        <line x1=\"262\" y1=\"118\" x2=\"262\" y2=\"130\" stroke=\"#101820\" strokeWidth=\"1\" />\n        <line x1=\"267\" y1=\"118\" x2=\"267\" y2=\"130\" stroke=\"#101820\" strokeWidth=\"1.5\" />\n        \n        {/* Keypad Base Spacer */}\n        <rect x=\"210\" y=\"226\" width=\"82\" height=\"74\" rx=\"6\" fill=\"#2b3b4a\" opacity=\"0.3\" />\n\n        {/* Tactile Keypad circular buttons - grid */}\n        {/* Row 1 */}\n        <circle cx=\"225\" cy=\"238\" r=\"6\" fill=\"#ccd5dc\" />\n        <circle cx=\"251\" cy=\"238\" r=\"6\" fill=\"#ccd5dc\" />\n        <circle cx=\"277\" cy=\"238\" r=\"6\" fill=\"#ccd5dc\" />\n        \n        {/* Row 2 */}\n        <circle cx=\"225\" cy=\"254\" r=\"6\" fill=\"#ccd5dc\" />\n        <circle cx=\"251\" cy=\"254\" r=\"6\" fill=\"#ccd5dc\" />\n        <circle cx=\"277\" cy=\"254\" r=\"6\" fill=\"#ccd5dc\" />\n\n        {/* Row 3 */}\n        <circle cx=\"225\" cy=\"270\" r=\"6\" fill=\"#ccd5dc\" />\n        <circle cx=\"251\" cy=\"270\" r=\"6\" fill=\"#ccd5dc\" />\n        <circle cx=\"277\" cy=\"270\" r=\"6\" fill=\"#ccd5dc\" />\n\n        {/* Bottom row functional keys */}\n        <rect x=\"218\" y=\"282\" width=\"14\" height=\"10\" rx=\"2\" fill=\"#ef4444\" /> {/* Red Cancel */}\n        <rect x=\"244\" y=\"282\" width=\"14\" height=\"10\" rx=\"2\" fill=\"#eab308\" /> {/* Yellow Back */}\n        <rect x=\"270\" y=\"282\" width=\"14\" height=\"10\" rx=\"2\" fill=\"#10b981\" /> {/* Green OK */}\n\n        {/* Credit Card Inserted at Bottom Left Slot */}\n        <g transform=\"translate(195, 290) rotate(16)\">\n          <rect x=\"0\" y=\"0\" width=\"55\" height=\"34\" rx=\"4\" fill=\"url(#cardGradient)\" stroke=\"#34495e\" strokeWidth=\"1\" />\n          <rect x=\"6\" y=\"8\" width=\"11\" height=\"8\" rx=\"1.5\" fill=\"#f59e0b\" opacity=\"0.8\" />\n          <line x1=\"22\" y1=\"12\" x2=\"48\" y2=\"12\" stroke=\"#4a5568\" strokeWidth=\"2\" />\n          <line x1=\"22\" y1=\"18\" x2=\"40\" y2=\"18\" stroke=\"#4a5568\" strokeWidth=\"2\" />\n        </g>\n      </g>\n\n      {/* 4. Golden Swooping Arrow (High Fidelity Overlay with Sequential Bright Gold-Yellow Glow) */}\n      <g>\n        {/* Curved arrow body tail starting inside bottom-left curve of D */}\n        <path \n          d=\"M 152 388 \n   