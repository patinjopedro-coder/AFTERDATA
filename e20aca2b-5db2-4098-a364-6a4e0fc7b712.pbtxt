        }
        lines {
          text: "                  const disponibles = modelSerials.filter(s => [\'CANCELADO\', \'N#A\', \'RECUPERADO\'].includes(s.status || \'\') || s.status === \'SIN ESTATUS\').length;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
