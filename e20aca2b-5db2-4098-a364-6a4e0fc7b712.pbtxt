      target_content: "          {fisicoViewMode === \'edit\' || fisicoText === \'\' ? (\n            <div className=\"flex-1 flex flex-col gap-2\">\n              <textarea\n                value={fisicoText}\n                onChange={e => setFisicoText(e.target.value)}\n                placeholder=\"Lea con la pistola de c\303\263digos de barra directamente o pegue la lectura f\303\255sica masiva...\"\n                className=\"w-full flex-1 min-h-[220px] text-xs font-semibold p-3.5 bg-slate-950 border border-slate-800 rounded-lg text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 placeholder-slate-600 transition-all font-sans\"\n              />\n              <button\n                onClick={() => {\n                  if (fisicoText.trim()) setFisicoViewMode(\'visual\');\n                }}\n                disabled={!fisicoText.trim()}\n                className=\"w-full py-1.5 bg-orange-600/30 hover:bg-orange-600/50 disabled:opacity-50 disabled:cursor-not-allowed text-orange-300 font-bold text-xs uppercase rounded-lg border border-orange-500/10 cursor-pointer\"\n              >\n                Procesar y Hacer Match\n              </button>\n            </div>\n          ) : (\n            <div className=\"flex-1 flex flex-col gap-2.5\">\n              \n              {/* Barcode scanner live dedicated box inside the visual field */}\n              <div className=\"relative\">\n                <input\n                  ref={scanInputRef}\n                  type=\"text\"\n                  value={scanInput}\n                  onChange={e => setScanInput(e.target.value)}\n                  onKeyDown={handleScanKeyDown}\n                  placeholder=\"Pistolee serial f\303\255sico aqu\303\255...\"\n                  className=\"w-full text-xs font-bold p-2.5 pl-8 bg-slate-950 border border-slate-850 rounded-lg text-white focus:outline-none focus:border-orange-500 placeholder-slate-600\"\n                />\n                <Search size={13} className=\"absolute left-2.5 top-3.5 text-slate-500\" />\n                <span className=\"absolute right-2 px-1 rounded text-[8px] bg-slate-900 border border-slate-800 text-slate-500 select-none top-3 uppercase font-mono\">Pistola Conectada</span>\n              </div>\n\n              <div className=\"flex-1 overflow-y-auto max-h-[300px] pr-1.5 space-y-1.5\">\n                {fisicoUniques.map((serial, idx) => {\n                  const isMatch = emailSet.has(serial);\n                  const dbMatch = lookupValidador(serial);\n\n                  return (\n                    <div \n                      key={idx}\n                      className={`flex items-center justify-between p-2 rounded-lg border text-xs font-semibold transition-all ${\n                        isMatch \n                          ? \'bg-orange-500/10 border-orange-500/30 text-orange-400\' \n                          : \'bg-slate-950/40 text-slate-500/70 border-slate-900 opacity-60\'\n                      }`}\n                    >\n                      <div className=\"flex items-center gap-2.5 font-sans\">\n                        <span className=\"text-[9px] text-slate-600 font-bold font-mono\">{(idx + 1).toString().padStart(2, \'0\')}</span>\n                        <span className=\"tracking-wide select-all\">{serial}</span>\n                      </div>\n\n                      <div className=\"flex items-center gap-1.5 font-mono text-[9px]\">\n                        {dbMatch && (\n                          <span className={`px-1.5 py-0.5 rounded text-[8.5px] font-bold uppercase ${getStatusBadgeStyle(dbMatch.status)}`}>\n                            {dbMatch.status}\n                          </span>\n                        )}\n                        <span className={`px-1.5 py-0.5 rounded-md text-[8.5px] font-black uppercase tracking-wider ${\n                          isMatch ? \'bg-orange-500 text-white\' : \'bg-slate-900 text-slate-600\'\n                   