  file_change {
    absolute_path_uri: "file:///src/components/EquiposEnviados.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { POSItem, EnvioExterno, ModelConfig } from \'../types\';\nimport { getTerminalModel } from \'../data\';\nimport { Truck, Search, ChevronLeft, ChevronRight, HelpCircle } from \'lucide-react\';\n\ninterface EquiposEnviadosProps {\n  serials: POSItem[];\n  enviosExternos: EnvioExterno[];\n  modelosDB: Record<string, ModelConfig>;\n  globalSearch: string;\n  dateFrom: string;\n  dateTo: string;\n}\n\ninterface UnifiedSentItem {\n  tipo: \'casillero\' | \'externo\';\n  fecha: string;\n  guia: string;\n  serial: string;\n  rif: string;\n  razonSocial: string;\n  destino: string;\n  ticket: string;\n  sim: string;\n  origen: \'CASILLERO\' | \'EXTERNO\';\n}\n\nexport const EquiposEnviados: React.FC<EquiposEnviadosProps> = ({\n  serials,\n  enviosExternos,\n  modelosDB,\n  globalSearch,\n  dateFrom,\n  dateTo\n}) => {\n  const [currentPage, setCurrentPage] = useState(1);\n  const itemsPerPage = 25;\n\n  // Extract from internal serials that have been released\n  const internosEnviados: UnifiedSentItem[] = serials\n    .filter(s => {\n      const tieneSalidaCliente = !!(s.fechaSalidaCliente && s.fechaSalidaCliente.trim());\n      const esSustitucionBaja = !!(s.esSustitucion && s.fechaSalida && s.fechaSalida.trim());\n      return tieneSalidaCliente || esSustitucionBaja;\n    })\n    .map(s => {\n      const fecha = s.fechaSalidaCliente || s.fechaSalida || \'\';\n      const guia = s.guiaSalidaCliente || \'\';\n      const serial = s.esSustitucion && s.serialSustituto ? s.serialSustituto : s.serial;\n      return {\n        tipo: \'casillero\',\n        fecha,\n        guia,\n        serial,\n        rif: s.rif || \'\',\n        razonSocial: s.razonSocial || \'\',\n        destino: s.destinoSalida || s.destino || \'\',\n        ticket: s.ticket || \'\',\n        sim: s.sim ? `CON SIM (${s.simNumber})` : \'SIN SIM\',\n        origen: \'CASILLERO\'\n      };\n    });\n\n  // Extract from external shipments\n  const externosEnviados: UnifiedSentItem[] = enviosExternos.map(e => ({\n    tipo: \'externo\',\n    fecha: e.fecha,\n    guia: e.guia,\n    serial: e.serial,\n    rif: e.rif || \'\',\n    razonSocial: e.razonSocial || \'\',\n    destino: e.destino || \'\',\n    ticket: e.ticket || \'\',\n    sim: \'N/A (EXT)\',\n    origen: \'EXTERNO\'\n  }));\n\n  const combined = [...internosEnviados, ...externosEnviados];\n\n  // Filtering\n  const filtered = combined.filter(item => {\n    const sLow = globalSearch.toLowerCase();\n    const modelInfo = getTerminalModel(item.serial, modelosDB);\n\n    const matchSearch = !globalSearch ||\n      item.serial.toLowerCase().includes(sLow) ||\n      item.rif.toLowerCase().includes(sLow) ||\n      item.razonSocial.toLowerCase().includes(sLow) ||\n      item.guia.toLowerCase().includes(sLow) ||\n      item.ticket.toLowerCase().includes(sLow) ||\n      item.destino.toLowerCase().includes(sLow) ||\n      item.origen.toLowerCase().includes(sLow) ||\n      modelInfo.modelo.toLowerCase().includes(sLow);\n\n    const matchDateFrom = !dateFrom || item.fecha >= dateFrom;\n    const matchDateTo = !dateTo || item.fecha <= dateTo;\n\n    return matchSearch && matchDateFrom && matchDateTo;\n  });\n\n  // Sort by shipping date descending\n  const sorted = [...filtered].sort((a, b) => new Date(b.fecha).getTime() - new Date(a.fecha).getTime());\n\n  // Pagination\n  const totalPages = Math.ceil(sorted.length / itemsPerPage) || 1;\n  const startIndex = (currentPage - 1) * itemsPerPage;\n  const paginated = sorted.slice(startIndex, startIndex + itemsPerPage);\n\n  return (\n    <div className=\"flex flex-col gap-4 animate-fade-in text-slate-100 pb-16\">\n      \n      <div className=\"bg-slate-900/40 p-4 rounded-xl border border-slate-800 flex justify-between items-center flex-wrap gap-4\">\n        <div>\n          <h2 className=\"text-base font-bold text-blue-400 flex items-center gap-2\">\n            <Truck className=\"w-5 h-5 text-emerald-500\" />\n            HISTORIAL DE EQUIPOS ENVIADOS / DESPACHADOS\n          </h2>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Registro unificado de equipos que ya salieron de la empresa hacia los clientes por despachos directos o mediante gu\303\255as log\303\255sticas externas.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-4\">\n          <span className=\"text-xs text-slate-400 font-semibold uppercase font-mono bg-slate-950 px-3 py-1.5 rounded-lg border border-slate-800\">\n            Total Despachados: {sorted.length}\n          </span>\n          {totalPages > 1 && (\n            <div className=\"flex items-center gap-1.5 bg-slate-950 p-1 rounded-lg border border-slate-800\">\n              <button\n                disabled={currentPage === 1}\n                onClick={() => setCurrentPage(p => Math.max(1, p - 1))}\n                className=\"p-1.5 bg-slate-900 border border-slate-800 hover:border-slate-700 disabled:opacity-30 rounded cursor-pointer\"\n              >\n                <ChevronLeft size={14} />\n              </button>\n              <span className=\"text-xs font-semibold px-2\">\n                P\303\241g. {currentPage} / {totalPages}\n              </span>\n              <button\n                disabled={currentPage === totalPages}\n                onClick={() => setCurrentPage(p => Math.min(totalPages, p + 1))}\n                className=\"p-1.5 bg-slate-900 border border-slate-800 hover:border-slate-700 disabled:opacity-30 rounded cursor-pointer\"\n              >\n                <ChevronRight size={14} />\n              </button>\n            </div>\n          )}\n        </div>\n      </div>\n\n      <div className=\"bg-slate-900/30 rounded-xl border border-slate-800 overflow-hidden shadow-2xl\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left border-collapse\">\n            <thead>\n              <tr className=\"bg-slate-950/80 border-b border-slate-800 text-[10px] text-slate-400 font-bold uppercase tracking-wider\">\n                <th className=\"py-3 px-4\">Raz\303\263n Social / Cliente</th>\n                <th className=\"py-3 px-4\">Fecha Salida</th>\n                <th className=\"py-3 px-4\">Serial Enviado</th>\n                <th className=\"py-3 px-4\">Modelo</th>\n                <th className=\"py-3 px-4\">C\303\251dula / RIF</th>\n                <th className=\"py-3 px-4\">Gu\303\255a Salida</th>\n                <th className=\"py-3 px-4\">Destino</th>\n                <th className=\"py-3 px-4 text-center\">Ticket</th>\n                <th className=\"py-3 px-4\">SIM Info</th>\n                <th className=\"py-3 px-4 text-center\">Origen</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800/60 font-mono text-[11px]\">\n              {paginated.length === 0 ? (\n                <tr>\n                  <td colSpan={10} className=\"text-center py-12 text-slate-500 text-xs font-mono\">\n                    No hay registros de salidas o env\303\255os del periodo que coincidan con los filtros.\n                  </td>\n                </tr>\n              ) : (\n                paginated.map((e, idx) => {\n                  const modelInfo = getTerminalModel(e.serial, modelosDB);\n                  return (\n                    <tr \n                      key={idx} \n                      className={`hover:bg-slate-900/30 transition-colors ${\n                        e.tipo === \'externo\' ? \'bg-emerald-950/5 hover:bg-emerald-950/10\' : \'\'\n                      }`}\n                    >\n                      <td className=\"py-3 px-4 uppercase font-sans font-semibold text-slate-200\">\n                        {e.razonSocial || \'MANUAL / SIN ENTRADA\'}\n                      </td>\n                      <td className=\"py-3 px-4 whitespace-nowrap text-slate-400\">\n                        {e.fecha.split(\'-\').reverse().join(\'/\')}\n                      </td>\n                      <td className=\"py-3 px-4 font-bold text-blue-300 tracking-wider\">\n                        <span \n                          onClick={() => {\n                            navigator.clipboard.writeText(e.serial);\n                            alert(`Serial ${e.serial} copiado.`);\n                          }}\n                          className=\"hover:underline cursor-pointer select-all\"\n                        >\n                          {e.serial}\n                        </span>\n                      </td>\n                      <td className=\"py-3 px-4 uppercase text-slate-400 font-sans\">\n                        {modelInfo.modelo}\n                      </td>\n                      <td className=\"py-3 px-4 text-slate-400 uppercase\">{e.rif || \'-\'}</td>\n                      <td className=\"py-3 px-4\">\n                        {e.guia ? (\n                          <span \n                            onClick={() => {\n                              navigator.clipboard.writeText(e.guia);\n                              alert(`Guia ${e.guia} copiada.`);\n                            }}\n                            className=\"bg-slate-950 px-2 py-0.5 rounded text-xs tracking-wider border border-slate-850 hover:text-blue-400 cursor-pointer font-bold inline-block\"\n                          >\n                            {e.guia}\n                          </span>\n                        ) : (\n                          <span className=\"text-slate-600\">-</span>\n                        )}\n                      </td>\n                      <td className=\"py-3 px-4 uppercase text-slate-300 font-sans\">{e.destino || \'-\'}</td>\n                      <td className=\"py-3 px-4 text-center text-amber-500 font-bold\">{e.ticket || \'-\'}</td>\n                      <td className=\"py-3 px-4 text-[10px] text-slate-400 tracking-tight font-sans\">\n                        {e.sim}\n                      </td>\n                      <td className=\"py-3 px-4 text-center\">\n                        <span className={`px-2 py-0.5 rounded text-[9px] font-black tracking-wider ${\n                          e.origen === \'CASILLERO\' ? \'bg-amber-500/20 text-amber-300\' : \'bg-emerald-500/20 text-emerald-300\'\n                        }`}>\n                          {e.origen}\n                        </span>\n                      </td>\n                    </tr>\n                  );\n                })\n              )}\n            </tbody>\n          </table>\n        </div>\n\n        <div className=\"p-4 border-t border-slate-800 bg-slate-950/40 flex justify-between items-center text-xs text-slate-500\">\n          <span>Viendo {paginated.length} registros despachados en p\303\241gina actual.</span>\n          {totalPages > 1 && (\n            <div className=\"flex gap-1\">\n              <button disabled={currentPage === 1} onClick={() => setCurrentPage(1)} className=\"px-1.5 py-0.5 bg-slate-950 border border-slate-850 disabled:opacity-30 rounded text-[9px] uppercase font-bold text-slate-400\">Primera</button>\n              <button disabled={currentPage === 1} onClick={() => setCurrentPage(p => Math.max(1, p - 1))} className=\"px-1.5 py-0.5 bg-slate-950 border border-slate-850 disabled:opacity-30 rounded text-[9px] uppercase font-bold text-slate-400\">Atr\303\241s</button>\n              <span className=\"px-2\">{currentPage} / {totalPages}</span>\n              <button disabled={currentPage === totalPages} onClick={() => setCurrentPage(p => Math.min(totalPages, p + 1))} className=\"px-1.5 py-0.5 bg-slate-950 border border-slate-850 disabled:opacity-30 rounded text-[9px] uppercase font-bold text-slate-400\">Siguiente</button>\n              <button disabled={currentPage === totalPages} onClick={() => setCurrentPage(totalPages)} className=\"px-1.5 py-0.5 bg-slate-950 border border-slate-850 disabled:opacity-30 rounded text-[9px] uppercase font-bold text-slate-400\">Fin</button>\n            </div>\n          )}\n        </div>\n      </div>\n\n    </div>\n  );\n};\n"
    }
