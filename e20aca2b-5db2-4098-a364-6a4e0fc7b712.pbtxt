    replacement_infos {
      original_chunk {
        target_content: "      {/* SECCI\303\223N 3: PESTA\303\221AS DE NAVEGACI\303\223N PRINCIPAL */}\n      <nav className=\"bg-slate-955 max-w-7xl mx-auto w-full px-4 md:px-8 mt-5\">\n        <div className=\"flex gap-1 overflow-x-auto pb-1.5 border-b border-slate-900\">\n          {[\n            { id: \'general\', label: \'Gesti\303\263n General\', icon: Layers },\n            { id: \'casillero\', label: \'Casillero\', icon: FolderCheck },\n            { id: \'hacerEnvio\', label: \'Hacer Env\303\255o\', icon: Send },\n            { id: \'cruce\', label: \'Cruce de Seriales\', icon: Network },\n            { id: \'envios\', label: \'Equipos Enviados\', icon: FileSpreadsheet },\n            { id: \'modelos\', label: \'Prefijos Modelos\', icon: Settings },\n            { id: \'estadisticas\', label: \'Estad\303\255sticas\', icon: BarChart3 },\n            { id: \'usuarios\', label: \'Usuarios / Clientes\', icon: Users }\n          ].map(t => {\n            const Icon = t.icon;\n            const isActive = currentTab === t.id;\n            return (\n              <button\n                key={t.id}\n                onClick={() => setCurrentTab(t.id)}\n                className={`flex items-center gap-1.5 px-4 py-2 text-xs font-bold uppercase tracking-widest transition-all rounded-t-lg cursor-pointer whitespace-nowrap ${\n                  isActive \n                    ? \'border-b-2 border-b-blue-500 text-blue-400 bg-slate-900/30\' \n                    : \'text-slate-500 hover:text-slate-300\'\n                }`}\n              >\n                <Icon size={13} />\n                <span>{t.label}</span>\n              </button>\n            );\n          })}\n        </div>\n      </nav>"
        replacement_content: "      {/* SECCI\303\223N 3: PESTA\303\221AS DE NAVEGACI\303\223N PRINCIPAL */}\n      <nav className=\"bg-slate-955 max-w-7xl mx-auto w-full px-4 md:px-8 mt-6\">\n        <div className=\"flex flex-wrap items-center gap-2 pb-3 border-b border-slate-900/50\">\n          {[\n            { id: \'general\', label: \'Gesti\303\263n General\', icon: Layers },\n            { id: \'casillero\', label: \'Casillero\', icon: FolderCheck },\n            { id: \'hacerEnvio\', label: \'Hacer Env\303\255o\', icon: Send },\n            { id: \'cruce\', label: \'Cruce de Seriales\', icon: Network },\n            { id: \'envios\', label: \'Equipos Enviados\', icon: FileSpreadsheet },\n            { id: \'modelos\', label: \'Prefijos Modelos\', icon: Settings },\n            { id: \'estadisticas\', label: \'Estad\303\255sticas\', icon: BarChart3 },\n            { id: \'usuarios\', label: \'Usuarios / Clientes\', icon: Users }\n          ].map(t => {\n            const Icon = t.icon;\n            const isActive = currentTab === t.id;\n            return (\n              <button\n                key={t.id}\n                onClick={() => setCurrentTab(t.id)}\n                className={`flex items-center gap-1.5 px-3.5 py-2 text-[10.5px] font-black uppercase tracking-wider transition-all rounded-xl cursor-pointer ${\n                  isActive \n                    ? \'bg-blue-600 text-white border border-blue-500/20 shadow-md shadow-blue-500/10\' \n                    : \'bg-slate-900/60 hover:bg-slate-850 hover:text-slate-200 text-slate-400 border border-slate-800/80\'\n                }`}\n              >\n                <Icon size={13} className={isActive ? \'text-white\' : \'text-slate-450\'} />\n                <span>{t.label}</span>\n              </button>\n            );\n          })}\n        </div>\n      </nav>"
